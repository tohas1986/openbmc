+                    std::vector<uint8_t> raw_packet(rsp.cbegin() + 1, rsp.cend());
+                    ss << "netfn 0x" << std::hex << std::setfill('0') << std::setw(2) << +netfn;
+                    ss << " cmd 0x" << std::hex << std::setfill('0') << std::setw(2) << +cmd;
+                    ss << " raw 0x";
+                    for(uint8_t b : raw_packet)
+                        ss << std::hex << std::setfill('0') << std::setw(2) << +b;
+                    ss << " cc 0x" << std::hex << std::setfill('0') << std::setw(2) << +cc;
+
+                    std::string rawstr = ss.str();
+                    std::cerr << time_in_HH_MM_SS_MMM() << " >>>> " << rawstr << "\n";
+
                     log<level::INFO>(
                         "Send rsp msg", entry("NETFN=0x%02x", netfn),
                         entry("LUN=0x%02x", lun), entry("CMD=0x%02x", cmd),
