From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 4 Jul 2023 15:53:01 +0000
Subject: [PATCH] Introduce communication dump with -v option

---
 src/args.cpp |  8 ++++++-
 src/cmd.cpp  | 60 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/main.cpp |  1 +
 3 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/src/args.cpp b/src/args.cpp
index b81de5a..d45ec97 100644
--- a/src/args.cpp
+++ b/src/args.cpp
@@ -4,15 +4,18 @@
 #include <getopt.h>
 
 #include <stdexcept>
+#include <iostream>
 
+extern bool DEBUG;
 namespace kcsbridge
 {
 
 Args::Args(int argc, char* argv[])
 {
-    static const char opts[] = ":c:";
+    static const char opts[] = ":c:v";
     static const struct option longopts[] = {
         {"channel", required_argument, nullptr, 'c'},
+        {"verbose", no_argument, 0,  'v' },
         {nullptr, 0, nullptr, 0},
     };
     int c;
@@ -28,6 +31,9 @@ Args::Args(int argc, char* argv[])
                 throw std::runtime_error(
                     fmt::format("Missing argument for `{}`", argv[optind - 1]));
                 break;
+            case 'v':
+                DEBUG = true;
+                break;
             default:
                 throw std::runtime_error(fmt::format(
                     "Invalid command line argument `{}`", argv[optind - 1]));
diff --git a/src/cmd.cpp b/src/cmd.cpp
index a51bc22..b3cf6ff 100644
--- a/src/cmd.cpp
+++ b/src/cmd.cpp
@@ -17,6 +17,13 @@
 #include <utility>
 #include <variant>
 #include <vector>
+#include <iostream>
+#include <sstream>
+#include <chrono>
+#include <ctime>
+#include <iomanip>
+
+extern bool DEBUG;
 
 namespace kcsbridge
 {
@@ -25,6 +32,31 @@ using sdbusplus::bus_t;
 using sdbusplus::message_t;
 using sdbusplus::slot_t;
 
+std::string time_in_HH_MM_SS_MMM()
+{
+    using namespace std::chrono;
+
+    // get current time
+    auto now = system_clock::now();
+
+    // get number of milliseconds for the current second
+    // (remainder after division into seconds)
+    auto ms = duration_cast<milliseconds>(now.time_since_epoch()) % 1000;
+
+    // convert to std::time_t in order to convert to std::tm (broken time)
+    auto timer = system_clock::to_time_t(now);
+
+    // convert to broken time
+    std::tm bt = *std::localtime(&timer);
+
+    std::ostringstream oss;
+
+    oss << std::put_time(&bt, "%H:%M:%S"); // HH:MM:SS
+    oss << '.' << std::setfill('0') << std::setw(3) << ms.count();
+
+    return oss.str();
+}
+
 void write(stdplus::Fd& kcs, message_t&& m)
 {
     std::array<uint8_t, 1024> buffer;
@@ -53,6 +85,20 @@ void write(stdplus::Fd& kcs, message_t&& m)
         buffer[1] = cmd;
         buffer[2] = cc;
         memcpy(&buffer[3], data.data(), data.size());
+        if (DEBUG)
+        {
+            std::stringstream ss;
+            ss << "netfn 0x" << std::hex << std::setfill('0') << std::setw(2) << +netfn;
+            ss << " cmd 0x" << std::hex << std::setfill('0') << std::setw(2) << +cmd;
+            if (! data.empty())
+            {
+                ss << " raw 0x";
+                for(uint8_t i = 0; i< data.size(); i++)
+                    ss << std::hex << std::setfill('0') << std::setw(2) << +buffer[3+i];
+            }
+            ss << " cc 0x" << std::hex << std::setfill('0') << std::setw(2) << +cc;
+            std::cerr << time_in_HH_MM_SS_MMM() << " >>>> " << ss.str() << "\n";
+        }
         out = std::span<uint8_t>(buffer.begin(), data.size() + 3);
     }
     catch (const std::exception& e)
@@ -88,6 +134,20 @@ void read(stdplus::Fd& kcs, bus_t& bus, slot_t& outstanding)
     std::map<std::string, std::variant<int>> options;
     // Based on the IPMI KCS spec Figure 9-1
     uint8_t netfn = in[0] >> 2, lun = in[0] & 3, cmd = in[1];
+    if (DEBUG)
+    {
+        std::stringstream ss;
+        ss << "netfn 0x" << std::hex << std::setfill('0') << std::setw(2) << +netfn;
+        ss << " cmd 0x" << std::hex << std::setfill('0') << std::setw(2) << +cmd;
+        if (! in.subspan(2).empty())
+        {
+            ss << " raw 0x";
+            for(uint8_t b : in.subspan(2))
+                ss << std::hex << std::setfill('0') << std::setw(2) << +b;
+        }
+        std::cerr << time_in_HH_MM_SS_MMM() << " <<<< " << ss.str() << "\n";
+    }
+
     m.append(netfn, lun, cmd, in.subspan(2), options);
     outstanding = m.call_async(
         stdplus::exception::ignore([&outstanding, &kcs](message_t&& m) {
diff --git a/src/main.cpp b/src/main.cpp
index 6abd949..8f95af2 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -18,6 +18,7 @@
