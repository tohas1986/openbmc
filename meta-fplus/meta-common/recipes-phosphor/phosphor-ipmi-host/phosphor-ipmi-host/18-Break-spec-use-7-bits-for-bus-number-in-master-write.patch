From 5f221cb1d2cd7b6a92bb1f5b6ef76bfa41933a7f Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Wed, 17 Mar 2021 07:10:39 +0000
Subject: [PATCH] Break spec: use 7 bits for bus number in master write-read

---
 apphandler.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/apphandler.cpp b/apphandler.cpp
index 9f0d553..d80b9b6 100644
--- a/apphandler.cpp
+++ b/apphandler.cpp
@@ -1719,8 +1719,13 @@ ipmi::RspType<std::vector<uint8_t>>
     }
 #endif // ENABLE_I2C_WHITELIST_CHECK
     std::vector<uint8_t> readBuf(readCount);
+    uint8_t busNumber = static_cast<uint8_t>(busId);
+    if (isPrivateBus)
+    {
+        busNumber += (static_cast<uint8_t>(channelNum) << 3);
+    }
     std::string i2cBus =
-        "/dev/i2c-" + std::to_string(static_cast<uint8_t>(busId));
+        "/dev/i2c-" + std::to_string(busNumber); std::cerr << "Master write-read to bus: " << i2cBus << " Slave:" << +static_cast<uint8_t>(slaveAddr) << "\n";
 
     ipmi::Cc ret = ipmi::i2cWriteRead(i2cBus, static_cast<uint8_t>(slaveAddr),
                                       writeData, readBuf);
