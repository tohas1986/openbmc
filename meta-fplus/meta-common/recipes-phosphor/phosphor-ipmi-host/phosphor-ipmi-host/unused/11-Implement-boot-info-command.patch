From 79fd4fca248667e3de1301dd0f278be9596201fa Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 11 Aug 2020 15:14:26 +0000
Subject: [PATCH 1/1] Implement boot info command

---
 chassishandler.cpp | 22 ++++++++++++++++++++++
 chassishandler.hpp |  1 +
 2 files changed, 23 insertions(+)

diff --git a/chassishandler.cpp b/chassishandler.cpp
index a948bd9..cfba6ce 100644
--- a/chassishandler.cpp
+++ b/chassishandler.cpp
@@ -1495,6 +1495,8 @@ static ipmi_ret_t setBootMode(const Mode::Modes& mode)
 static constexpr uint8_t setComplete = 0x0;
 static constexpr uint8_t setInProgress = 0x1;
 static uint8_t transferStatus = setComplete;
+static uint8_t bootInfoData1 = 0x00;
+static uint8_t bootInfoData2 = 0x00;
 
 ipmi_ret_t ipmi_chassis_get_sys_boot_options(ipmi_netfn_t netfn, ipmi_cmd_t cmd,
                                              ipmi_request_t request,
@@ -1521,6 +1523,18 @@ ipmi_ret_t ipmi_chassis_get_sys_boot_options(ipmi_netfn_t netfn, ipmi_cmd_t cmd,
         return IPMI_CC_OK;
     }
 
+    if (reqptr->parameter ==
+        static_cast<uint8_t>(BootOptionParameter::BOOT_INFO))
+    {
+        *data_len =
+            static_cast<uint8_t>(BootOptionResponseSize::BOOT_INFO);
+        resp->version = SET_PARM_VERSION;
+        resp->parm = static_cast<uint8_t>(BootOptionParameter::BOOT_INFO);
+        resp->data[0] = bootInfoData1;
+        resp->data[1] = bootInfoData2;
+        return IPMI_CC_OK;
+    }
+
     std::memset(resp, 0, sizeof(*resp));
     resp->version = SET_PARM_VERSION;
     resp->parm = 5;
@@ -1675,6 +1689,14 @@ ipmi_ret_t ipmi_chassis_set_sys_boot_options(ipmi_netfn_t netfn, ipmi_cmd_t cmd,
         return IPMI_CC_OK;
     }
 
+    if (reqptr->parameter ==
+        static_cast<uint8_t>(BootOptionParameter::BOOT_INFO))
+    {
+        bootInfoData1 = reqptr->data[0];
+        bootInfoData2 = reqptr->data[1];
+        return IPMI_CC_OK;
+    }
+
     /*  000101
      * Parameter #5 means boot flags. Please refer to 28.13 of ipmi doc.
      * This is the only parameter used by petitboot.
diff --git a/chassishandler.hpp b/chassishandler.hpp
index 353a929..56a903f 100644
--- a/chassishandler.hpp
+++ b/chassishandler.hpp
@@ -56,6 +56,7 @@ enum class BootOptionParameter : size_t
 enum class BootOptionResponseSize : size_t
 {
     SET_IN_PROGRESS = 3,
+    BOOT_INFO = 4,
     BOOT_FLAGS = 5,
     OPAL_NETWORK_SETTINGS = 50
 };
-- 
2.7.4

