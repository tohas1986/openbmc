@@ -231,51 +251,69 @@ message::Response::ptr executeIpmiCommandCommon(
     std::unordered_map<unsigned int, HandlerTuple>& handlers,
     unsigned int keyCommon, message::Request::ptr request)
 {
+    std::cerr << "executeIpmiCommandCommon keyCommon=0x" << std::hex << std::setfill('0') << std::setw(2) << +keyCommon << std::endl;
+
     // filter the command first; a non-null message::Response::ptr
     // means that the message has been rejected for some reason
     message::Response::ptr filterResponse = filterIpmiCommand(request);
 
     Cmd cmd = request->ctx->cmd;
     unsigned int key = makeCmdKey(keyCommon, cmd);
+    std::cerr << "executeIpmiCommandCommon key=0x" << std::hex << std::setfill('0') << std::setw(2) << +key <<
+                 " keyCommon=0x" << std::hex << std::setfill('0') << std::setw(2) << +keyCommon <<
+                 " cmd=0x" << std::hex << std::setfill('0') << std::setw(2) << +cmd << std::endl;
+
     auto cmdIter = handlers.find(key);
     if (cmdIter != handlers.end())
     {
+        std::cerr << "executeIpmiCommandCommon cmdIter != handlers.end()" << std::endl;
         // only return the filter response if the command is found
         if (filterResponse)
         {
+            std::cerr << "executeIpmiCommandCommon filterResponse" << std::endl;
             return filterResponse;
         }
         HandlerTuple& chosen = cmdIter->second;
         if (request->ctx->priv < std::get<Privilege>(chosen))
         {
+            std::cerr << "executeIpmiCommandCommon wrong priv" << std::endl;
             return errorResponse(request, ccInsufficientPrivilege);
         }
+        std::cerr << "executeIpmiCommandCommon Calling" << std::endl;
         return std::get<HandlerBase::ptr>(chosen)->call(request);
     }
     else
     {
+        std::cerr << "executeIpmiCommandCommon else" << std::endl;
         unsigned int wildcard = makeCmdKey(keyCommon, cmdWildcard);
+        std::cerr << "executeIpmiCommandCommon wildcard=0x" << std::hex << std::setfill('0') << std::setw(2) << +wildcard << std::endl;
         cmdIter = handlers.find(wildcard);
         if (cmdIter != handlers.end())
         {
+            std::cerr << "executeIpmiCommandCommon cmdIter != handlers.end()" << std::endl;
             // only return the filter response if the command is found
             if (filterResponse)
             {
+                std::cerr << "executeIpmiCommandCommon filterResponse" << std::endl;
                 return filterResponse;
             }
             HandlerTuple& chosen = cmdIter->second;
             if (request->ctx->priv < std::get<Privilege>(chosen))
             {
+                std::cerr << "executeIpmiCommandCommon wrong priv" << std::endl;
                 return errorResponse(request, ccInsufficientPrivilege);
             }
+            std::cerr << "executeIpmiCommandCommon Calling" << std::endl;
             return std::get<HandlerBase::ptr>(chosen)->call(request);
         }
     }
+    std::cerr << "executeIpmiCommandCommon default exit" << std::endl;
     return errorResponse(request, ccInvalidCommand);
 }
 
