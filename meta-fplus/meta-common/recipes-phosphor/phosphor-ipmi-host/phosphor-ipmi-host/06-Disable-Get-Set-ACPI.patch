From 76e753d0233ec72d645d543aa5f030dc63ffdef1 Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Fri, 30 Sep 2022 07:42:25 +0000
Subject: [PATCH] Disable Get/Set ACPI state

---
 apphandler.cpp | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/apphandler.cpp b/apphandler.cpp
index d0d77f8..f3b6755 100644
--- a/apphandler.cpp
+++ b/apphandler.cpp
@@ -311,7 +311,8 @@ bool isValidACPIState(acpi_state::PowerStateType type, uint8_t state)
 ipmi::RspType<> ipmiSetAcpiPowerState(uint8_t sysAcpiState,
                                       uint8_t devAcpiState)
 {
-    auto s = static_cast<uint8_t>(acpi_state::PowerState::unknown);
+	std::cerr << __FUNCTION__ << " sysAcpiState:" << + sysAcpiState << " devAcpiState:" << +devAcpiState << "\n";
+    /*auto s = static_cast<uint8_t>(acpi_state::PowerState::unknown);
 
     sdbusplus::bus_t bus{ipmid_get_sd_bus_connection()};
 
@@ -414,7 +415,9 @@ ipmi::RspType<> ipmiSetAcpiPowerState(uint8_t sysAcpiState,
     else
     {
         log<level::DEBUG>("Do not change device power state");
-    }
+    }*/
+    //Stub, cause we do not have ACPI intf
+
     return ipmi::responseSuccess();
 }
 
@@ -430,10 +433,10 @@ ipmi::RspType<uint8_t, // acpiSystemPowerState
               >
     ipmiGetAcpiPowerState()
 {
-    uint8_t sysAcpiState;
-    uint8_t devAcpiState;
+    uint8_t sysAcpiState = 0x00;
+    uint8_t devAcpiState = 0x00;
 
-    sdbusplus::bus_t bus{ipmid_get_sd_bus_connection()};
+    /*sdbusplus::bus_t bus{ipmid_get_sd_bus_connection()};
 
     try
     {
@@ -456,7 +459,9 @@ ipmi::RspType<uint8_t, // acpiSystemPowerState
     catch (const InternalFailure& e)
     {
         return ipmi::responseUnspecifiedError();
-    }
+    }*/
+
+    //Stub, cause we do not have ACPI intf
 
     return ipmi::responseSuccess(sysAcpiState, devAcpiState);
 }
