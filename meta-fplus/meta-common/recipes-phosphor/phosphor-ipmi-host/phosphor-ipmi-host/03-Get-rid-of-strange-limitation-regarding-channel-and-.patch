From 95eb4e985c256a4a7a0a60013f9be3b0aaa4679d Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Thu, 16 Dec 2021 08:43:30 +0000
Subject: [PATCH] Get rid of strange limitation regarding channel and user
 commands on session-less channels

---
 user_channel/channel_mgmt.cpp    |  8 ++++----
 user_channel/channelcommands.cpp | 10 +++++-----
 user_channel/usercommands.cpp    | 10 +++++-----
 3 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/user_channel/channel_mgmt.cpp b/user_channel/channel_mgmt.cpp
index 7d3cf95..1ff9aae 100644
--- a/user_channel/channel_mgmt.cpp
+++ b/user_channel/channel_mgmt.cpp
@@ -460,7 +460,7 @@ Cc ChannelConfig::getChannelAccessData(const uint8_t chNum,
     if (getChannelSessionSupport(chNum) == EChannelSessSupported::none)
     {
         log<level::DEBUG>("Session-less channel doesn't have access data.");
-        return ccActionNotSupportedForChannel;
+        //return ccActionNotSupportedForChannel;
     }
 
     if (checkAndReloadVolatileData() != 0)
@@ -489,7 +489,7 @@ Cc ChannelConfig::setChannelAccessData(const uint8_t chNum,
     if (getChannelSessionSupport(chNum) == EChannelSessSupported::none)
     {
         log<level::DEBUG>("Session-less channel doesn't have access data.");
-        return ccActionNotSupportedForChannel;
+        //return ccActionNotSupportedForChannel;
     }
 
     if ((setFlag & setAccessMode) &&
@@ -559,7 +559,7 @@ Cc ChannelConfig::getChannelAccessPersistData(const uint8_t chNum,
     if (getChannelSessionSupport(chNum) == EChannelSessSupported::none)
     {
         log<level::DEBUG>("Session-less channel doesn't have access data.");
-        return ccActionNotSupportedForChannel;
+        //return ccActionNotSupportedForChannel;
     }
 
     if (checkAndReloadNVData() != 0)
@@ -588,7 +588,7 @@ Cc ChannelConfig::setChannelAccessPersistData(const uint8_t chNum,
     if (getChannelSessionSupport(chNum) == EChannelSessSupported::none)
     {
         log<level::DEBUG>("Session-less channel doesn't have access data.");
-        return ccActionNotSupportedForChannel;
+        //return ccActionNotSupportedForChannel;
     }
 
     if ((setFlag & setAccessMode) &&
diff --git a/user_channel/channelcommands.cpp b/user_channel/channelcommands.cpp
index 769f9ff..6fcf64c 100644
--- a/user_channel/channelcommands.cpp
+++ b/user_channel/channelcommands.cpp
@@ -60,7 +60,7 @@ RspType<> ipmiSetChannelAccess(Context::ptr ctx, uint4_t channel,
         (!isValidChannel(chNum)))
     {
         log<level::DEBUG>("Set channel access - No support on channel");
-        return response(ccActionNotSupportedForChannel);
+        //return response(ccActionNotSupportedForChannel);
     }
 
     ChannelAccess chActData;
@@ -191,7 +191,7 @@ ipmi ::RspType<uint3_t, // access mode,
         (!isValidChannel(chNum)))
     {
         log<level::DEBUG>("Get channel access - No support on channel");
-        return response(ccActionNotSupportedForChannel);
+        //return response(ccActionNotSupportedForChannel);
     }
 
     ChannelAccess chAccess;
@@ -260,7 +260,7 @@ RspType<uint4_t,  // chNum
     if (!isValidChannel(chNum))
     {
         log<level::DEBUG>("Get channel Info - No support on channel");
-        return responseInvalidFieldRequest();
+        //return responseInvalidFieldRequest();
     }
 
     ChannelInfo chInfo;
@@ -336,7 +336,7 @@ RspType<uint16_t, // stdPayloadType
     if (getChannelSessionSupport(chNum) == EChannelSessSupported::none)
     {
         log<level::DEBUG>("Get channel payload - No support on channel");
-        return response(ccActionNotSupportedForChannel);
+        //return response(ccActionNotSupportedForChannel);
     }
     constexpr uint16_t stdPayloadType = standardPayloadBit(PayloadType::IPMI) |
                                         standardPayloadBit(PayloadType::SOL);
@@ -382,7 +382,7 @@ RspType<uint8_t> // formatVersion
     {
         log<level::DEBUG>(
             "Get channel payload version - No support on channel");
-        return response(payloadTypeNotSupported);
+        //return response(payloadTypeNotSupported);
     }
 
     if (!isValidPayloadType(static_cast<PayloadType>(payloadTypeNum)))
