diff --git a/service_files/xyz.openbmc_project.bmcresetcausesensor.service b/service_files/xyz.openbmc_project.bmcresetcausesensor.service
new file mode 100644
index 0000000..4b6ef09
--- /dev/null
+++ b/service_files/xyz.openbmc_project.bmcresetcausesensor.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=BMC reset cause Sensor
+StopWhenUnneeded=false
+Requires=xyz.openbmc_project.EntityManager.service
+After=xyz.openbmc_project.EntityManager.service
+
+[Service]
+Restart=always
+RestartSec=5
+ExecStart=/usr/bin/bmcresetcausesensor
+
+[Install]
+WantedBy=multi-user.target
