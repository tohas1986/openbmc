+std::string serverName()
+{
+    std::string board = "board";
+    std::string line;
+    std::ifstream file;
+    file.open("/usr/share/openrack/machine", std::ios::in);
+
+    if (!file.is_open())
+    {
+        throw std::runtime_error("Unable to open /usr/share/openrack/machine file");
+    }
+
+    while (getline(file, line))
+    {
+        if (line.find("model=") != std::string::npos)
+        {
+            line.erase(0, 6);
+            std::stringstream iss(line);
+            iss >> board;
+            break;
+        }
+    }
+
+    return board;
+}
+
+void TachSensor::getTachCorrespondingToPwmValue(std::string& pwmCurrentValue, std::string& tachTableValue)
+{
+    tachTableValue = params[pwmCurrentValue];
+}
+
+void TachSensor::readPwmTachConfig()
+{
+    std::ifstream file;
+    std::string line;
+    std::string pwm;
+    std::string tach;
+    std::string path = "/usr/share/swampd/" + serverName() + "_fan_data.txt";
+
+    file.open(path, std::ios::in);
+    if (!file.is_open())
+    {
+        throw std::runtime_error("Unable to open: " + path + "\n");
+    }
+
+    while ( file.good() ){
+        getline(file, line, ';');
+        std::istringstream ss(line);
+        ss >> tach >> pwm; // set the variables
+        params[pwm] = tach; // input them into the map
+    }
+    file.close();
+}
+
+std::string getFanControllerPwd(std::string board)
+{
+    std::string fanControllerPwd;
+    std::string line;
+    std::ifstream file;
+    file.open("/usr/share/swampd/fan_controller_pwd.txt", std::ios::in);
+
+    if (!file.is_open())
+    {
+        throw std::runtime_error("Unable to open /usr/share/swampd/fan_controller_pwd.txt file");
+    }
+
+    while (std::getline(file, line))
+    {
+        if (line.find(board + ":") != std::string::npos)
+        {
+            //Cut line from ":" to end of line
+            line = line.substr(line.find(":") + 1);
+            std::stringstream iss(line);
+            iss >> fanControllerPwd;
+            break;
+        }
+    }
+    
+    file.close();
+
+    return fanControllerPwd;
+}
+
+void TachSensor::getCurrentPWMorTach(std::string& value, std::string detector)
+{
+    std::string path;
+    std::string line;
+    std::fstream file;
+    std::string board = serverName();
+
+    std::string pwd = getFanControllerPwd(board);
+
+    if(board == "mzb2" || board == "my62")
+    {
+        if(detector == "pwm")
+        {
+            path = pwd + node_pwm[name];
+        }
+        else
+        {
+            path = pwd + node_tach[name];
+        }
+    }
+    else if(board == "ai1")
+    {
+        if(detector == "pwm")
+        {
+            path = pwd + asus_node_pwm[name];
+        }
+        else
+        {
+            path = pwd + asus_node_tach[name];
+        }
+    }
+    else
+    {
+        if(detector == "pwm")
+        {
+            path = pwd + storage_pwm[name];
+        }
+        else
+        {
+            path = pwd + storage_tach[name];
+        }
+    }
+
+    file.open(path, std::ios::in);
+    if (!file.is_open())
+    {
+        throw std::runtime_error("Unable to open: " + path + "\n");
+        file.close();
+    }
+
+    while (getline(file, line))
+    {
+        std::stringstream iss(line);
+        iss >> value;
+        break;
+    }
+
+    file.close();
+}
