diff --git a/src/PSUEvent.cpp b/src/PSUEvent.cpp
index de4798c..208b9b7 100644
--- a/src/PSUEvent.cpp
+++ b/src/PSUEvent.cpp
@@ -192,14 +192,15 @@ void PSUSubEvent::setupRead(void)
         std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
         waitTimer.async_wait([weakRef](const boost::system::error_code& ec) {
             std::shared_ptr<PSUSubEvent> self = weakRef.lock();
-            if (ec == boost::asio::error::operation_aborted)
-            {
-                return; // we're being canceled
-            }
             if (self)
             {
                 self->setupRead();
             }
+            else
+            {
+                std::cerr << "Event setupRead: error occured, exiting\n";
+                exit(-1);
+            }
         });
         return;
     }
