From a27f49e7ea85c63e2e052ccd8f6e246c3e26e949 Mon Sep 17 00:00:00 2001
From: Nikita Vedeneev <vedenena@yandex-team.ru>
Date: Mon, 5 Apr 2021 12:32:45 +0000
Subject: [PATCH 1/1] Fix Data CPU and DIMM reading error on host early start

---
 src/IpmbSensor.cpp | 49 ++++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 42 insertions(+), 7 deletions(-)

diff --git a/src/IpmbSensor.cpp b/src/IpmbSensor.cpp
index 84a5341..045b73c 100644
--- a/src/IpmbSensor.cpp
+++ b/src/IpmbSensor.cpp
@@ -53,7 +53,6 @@ static constexpr uint8_t hostSMbusIndexDefault = 0x03;
 static constexpr const char* sensorPathPrefix = "/xyz/openbmc_project/sensors/";
 
 std::vector<uint8_t> meDataDIMMandCPU;
-static uint64_t readingMeDIMMDataTime = 0;
 double TjmaxValue = 100;
 int requestCnt = 0;
 
@@ -362,28 +361,46 @@ bool IpmbSensor::processReading(const std::vector<uint8_t>& data, double& resp)
         }
         case (ReadingFormat::medimmsensor):
         {
+            if(!ipmi::sensor::isValid(data))
+            {
+                return false;
+            }
+
             if (data.size() < 3)
             {
+                if (!errCount)
+                {
+                    std::cerr << "Invalid data length returned for " << name << "\n";
+                }
+
                 return false;
             }
 
+            if(requestCnt > 24)
+            {
+                requestCnt = 0;
+            }
+
             if(meDataDIMMandCPU.size() >= (deviceDIMMID + deviceChannelID*4 + 3))
             {
                 resp = meDataDIMMandCPU[deviceDIMMID + deviceChannelID*4 + 3];
-                readingMeDIMMDataTime = std::chrono::duration_cast<std::chrono::seconds>(
-                std::chrono::system_clock::now().time_since_epoch()).count();
 
                 return true;
             }
-            else
-            {
-                return false;
-            }
         }
         case (ReadingFormat::tjmax):
         {
+            if(!ipmi::sensor::isValid(data))
+            {
+                return false;
+            }
+
             if (data.size() < 3)
             {
+                if (!errCount)
+                {
+                    std::cerr << "Invalid data length returned for " << name << "\n";
+                }
                 return false;
             }
             TjmaxValue = data[0];
@@ -392,8 +409,17 @@ bool IpmbSensor::processReading(const std::vector<uint8_t>& data, double& resp)
         }
         case (ReadingFormat::dts):
         {
+            if(!ipmi::sensor::isValid(data))
+            {
+                return false;
+            }
+
             if (data.size() < 3)
             {
+                if (!errCount)
+                {
+                    std::cerr << "Invalid data length returned for " << name << "\n";
+                }
                 return false;
             }
             resp = data[3];
@@ -401,8 +427,17 @@ bool IpmbSensor::processReading(const std::vector<uint8_t>& data, double& resp)
         }
         case (ReadingFormat::cpu):
         {
+            if(!ipmi::sensor::isValid(data))
+            {
+                return false;
+            }
+
             if (data.size() < 3)
             {
+                if (!errCount)
+                {
+                    std::cerr << "Invalid data length returned for " << name << "\n";
+                }
                 return false;
             }
             if (TjmaxValue > 0)
