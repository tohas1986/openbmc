From e609a9291dbbd533e15f09871da45cf274cc88fb Mon Sep 17 00:00:00 2001
From: Nikita Vedeneev <vedenena@yandex-team.ru>
Date: Mon, 5 Apr 2021 09:52:50 +0000
Subject: [PATCH] Delete ec check to improve self check

---
 src/PSUEvent.cpp  | 23 +++++++++++++++--------
 src/PSUSensor.cpp | 25 ++++++++++++-------------
 2 files changed, 27 insertions(+), 21 deletions(-)

diff --git a/src/PSUEvent.cpp b/src/PSUEvent.cpp
index 6803b5f..dc7695f 100644
--- a/src/PSUEvent.cpp
+++ b/src/PSUEvent.cpp
@@ -193,14 +193,15 @@ void PSUSubEvent::setupRead(void)
         std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
         waitTimer.async_wait([weakRef](const boost::system::error_code& ec) {
             std::shared_ptr<PSUSubEvent> self = weakRef.lock();
-            if (ec == boost::asio::error::operation_aborted)
-            {
-                return; // we're being canceled
-            }
             if (self)
             {
                 self->setupRead();
             }
+            else
+            {
+                std::cerr << "Event setupRead: error occured, exiting\n";
+                exit(-1);
+            }
         });
         return;
     }
@@ -219,6 +220,11 @@ void PSUSubEvent::setupRead(void)
                 self->readBuf = buffer;
                 self->handleResponse(ec);
             }
+            else
+            {
+                std::cerr << "Event setupRead: error occured, exiting\n";
+                exit(-1);
+            }
         });
 }
 
@@ -294,14 +300,15 @@ void PSUSubEvent::handleResponse(const boost::system::error_code& err)
     std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
     waitTimer.async_wait([weakRef](const boost::system::error_code& ec) {
         std::shared_ptr<PSUSubEvent> self = weakRef.lock();
-        if (ec == boost::asio::error::operation_aborted)
-        {
-            return;
-        }
         if (self)
         {
             self->setupRead();
         }
+        else
+        {
+            std::cerr << "Event handleResponse: error occured, exiting\n";
+            exit(-1);
+        }
     });
 }
 
