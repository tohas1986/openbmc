-                    std::shared_ptr<PSUSensor> self = weakRef.lock();
-                if (self)
-                {
-                    self->readBuf = buffer;
-                    self->handleResponse(ec);
-                }
-            });
+        if (DEBUG) std::cerr << "SetupRead: " << sensorName << " Scheduling sensor read \n";
+
+        std::shared_ptr<PSUSensor> self = weakRef.lock();
+        boost::system::error_code ec;
+        inputDev.non_blocking(true);
+        boost::asio::read_until(self->inputDev, *buffer, '\n', ec);
+        self->readBuf = buffer;
+        self->handleResponse(ec);
     }
 }
 
@@ -291,7 +289,8 @@ void PSUSensor::handleResponse(const boost::system::error_code& err)
             else
             {
                 std::cerr << "Sensor setupRead: Error occured, exiting\n";
-                exit(-1);
+                //exit(-1);
+                return;
             }
         });
         return;
@@ -348,7 +347,7 @@ void PSUSensor::handleResponse(const boost::system::error_code& err)
         std::shared_ptr<PSUSensor> self = weakRef.lock();
         if (ec == boost::asio::error::operation_aborted)
         {
-            //std::cerr << "Failed to reschedule\n";
+            if(DEBUG) std::cerr << "Failed to reschedule\n";
             return;
         }
         if (self)
