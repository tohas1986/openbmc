                     {
                         // TODO FIXME Silent exit
-                        //return; // we're being canceled
-                        exit(-1);
-                    }*/
+                        return; // we're being canceled
+                        //exit(-1);
+                    }
                     if (self)
                     {
                         self->setupRead();
@@ -175,7 +177,8 @@ void PSUSensor::setupRead(void)
                     else
                     {
                         std::cerr << "Sensor setupRead: Error occured, exiting\n";
-                        exit(-1);
+                        //exit(-1);
+                        return;
                     }
                 });
                 return;
@@ -187,7 +190,7 @@ void PSUSensor::setupRead(void)
             if (ec == boost::asio::error::operation_aborted)
