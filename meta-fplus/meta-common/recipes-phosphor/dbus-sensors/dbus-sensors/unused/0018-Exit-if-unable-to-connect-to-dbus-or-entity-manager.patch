From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 8 Sep 2020 07:14:09 +0000
Subject: [PATCH] Exit if unable to connect to dbus or entity manager

---
 src/ADCSensorMain.cpp     | 2 +-
 src/ExitAirTempSensor.cpp | 4 ++--
 src/IpmbSensor.cpp        | 4 ++--
 src/MCUTempSensor.cpp     | 4 ++--
 src/PSUSensorMain.cpp     | 4 ++--
 5 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/src/ADCSensorMain.cpp b/src/ADCSensorMain.cpp
index 9024eb9..d6a5133 100644
--- a/src/ADCSensorMain.cpp
+++ b/src/ADCSensorMain.cpp
@@ -83,7 +83,7 @@ void createSensors(
                            paths))
             {
                 std::cerr << "No temperature sensors in system\n";
-                return;
+                exit(-1);
             }
 
             // iterate through all found adc sensors, and try to match them with
diff --git a/src/ExitAirTempSensor.cpp b/src/ExitAirTempSensor.cpp
index 41d9a19..e7503b6 100644
--- a/src/ExitAirTempSensor.cpp
+++ b/src/ExitAirTempSensor.cpp
@@ -825,14 +825,14 @@ void createSensor(sdbusplus::asio::object_server& objectServer,
     if (!dbusConnection)
     {
         std::cerr << "Connection not created\n";
-        return;
+        exit(-1);
     }
     dbusConnection->async_method_call(
         [&](boost::system::error_code ec, const ManagedObjectType& resp) {
             if (ec)
             {
                 std::cerr << "Error contacting entity manager\n";
-                return;
+                exit(-1);
             }
 
             cfmSensors.clear();
diff --git a/src/IpmbSensor.cpp b/src/IpmbSensor.cpp
