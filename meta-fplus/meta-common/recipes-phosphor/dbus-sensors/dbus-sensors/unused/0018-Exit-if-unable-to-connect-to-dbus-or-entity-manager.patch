     if (!dbusConnection)
     {
         std::cerr << "Connection not created\n";
-        return;
+        exit(-1);
     }
 
     dbusConnection->async_method_call(
@@ -214,7 +214,7 @@ void createSensors(
             if (ec)
             {
                 std::cerr << "Error contacting entity manager\n";
-                return;
+                exit(-1);
             }
             for (const auto& pathPair : resp)
             {
diff --git a/src/PSUSensorMain.cpp b/src/PSUSensorMain.cpp
index 70c150d..b47e7a7 100644
--- a/src/PSUSensorMain.cpp
+++ b/src/PSUSensorMain.cpp
@@ -248,7 +248,7 @@ void createSensors(boost::asio::io_service& io,
                                     useCache))
         {
             std::cerr << "error get sensor config from entity manager\n";
-            return;
+            exit(-1);
         }
         useCache = true;
     }
@@ -257,7 +257,7 @@ void createSensors(boost::asio::io_service& io,
     if (!findFiles(fs::path("/sys/class/hwmon"), "name", pmbusPaths))
     {
         std::cerr << "No PSU sensors in system\n";
