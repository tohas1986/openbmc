diff --git a/src/PSUEvent.cpp b/src/PSUEvent.cpp
index 4266918..3eeb925 100644
--- a/src/PSUEvent.cpp
+++ b/src/PSUEvent.cpp
@@ -184,6 +184,24 @@ PSUSubEvent::PSUSubEvent(
 
 void PSUSubEvent::setupRead(void)
 {
+    if (!isPowerOn()) // No need to read events from switched off PSU
+    {
+        waitTimer.expires_from_now(boost::posix_time::milliseconds(eventPollPowerOffMs));
+        std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
+        waitTimer.async_wait([weakRef](const boost::system::error_code& ec) {
+            std::shared_ptr<PSUSubEvent> self = weakRef.lock();
+            if (ec == boost::asio::error::operation_aborted)
+            {
+                return; // we're being canceled
+            }
+            if (self)
+            {
+                self->setupRead();
+            }
+        });
+        return;
+    }
+
     std::shared_ptr<boost::asio::streambuf> buffer =
         std::make_shared<boost::asio::streambuf>();
     std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
@@ -214,6 +232,28 @@ void PSUSubEvent::handleResponse(const boost::system::error_code& err)
     {
         return;
     }
+
+    if (!isPowerOn())
+    {
+        errCount = 0;
+        updateValue(std::numeric_limits<double>::quiet_NaN());
+
+        waitTimer.expires_from_now(boost::posix_time::milliseconds(eventPollPowerOffMs));
+        std::weak_ptr<PSUSubEvent> weakRef = weak_from_this();
+        waitTimer.async_wait([weakRef](const boost::system::error_code& ec) {
+            std::shared_ptr<PSUSubEvent> self = weakRef.lock();
+            if (ec == boost::asio::error::operation_aborted)
+            {
+                return;
+            }
+            if (self)
+            {
+                self->setupRead();
+                return;
+            }
+        });
+    }
+
     std::istream responseStream(readBuf.get());
     if (!err)
     {
