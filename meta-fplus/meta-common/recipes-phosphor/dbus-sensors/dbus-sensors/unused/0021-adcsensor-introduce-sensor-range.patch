From 4961543d1aba4e90b68bdcf886484dbb616bc4c4 Mon Sep 17 00:00:00 2001
From: Nikita Vedeneev <vedenena@yandex-team.ru>
Date: Fri, 2 Apr 2021 12:16:29 +0000
Subject: [PATCH] adcsensor-introduce-sensor-range

---
 include/ADCSensor.hpp |  2 +-
 src/ADCSensor.cpp     |  2 +-
 src/ADCSensorMain.cpp | 22 ++++++++++++++++++++--
 3 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/include/ADCSensor.hpp b/include/ADCSensor.hpp
index f601567..5a995aa 100644
--- a/include/ADCSensor.hpp
+++ b/include/ADCSensor.hpp
@@ -66,7 +66,7 @@ class ADCSensor : public Sensor, public std::enable_shared_from_this<ADCSensor>
               std::shared_ptr<sdbusplus::asio::connection>& conn,
               boost::asio::io_service& io, const std::string& sensorName,
               std::vector<thresholds::Threshold>&& thresholds,
-              const double scaleFactor, PowerState powerState,
+              const double scaleFactor, double max, double min, PowerState powerState,
               const std::string& sensorConfiguration,
               std::optional<BridgeGpio>&& bridgeGpio);
     ~ADCSensor() override;
diff --git a/src/ADCSensor.cpp b/src/ADCSensor.cpp
index 0915c03..49b7df5 100644
--- a/src/ADCSensor.cpp
+++ b/src/ADCSensor.cpp
@@ -49,7 +49,7 @@ ADCSensor::ADCSensor(const std::string& path,
                      std::shared_ptr<sdbusplus::asio::connection>& conn,
                      boost::asio::io_service& io, const std::string& sensorName,
                      std::vector<thresholds::Threshold>&& thresholdsIn,
-                     const double scaleFactor, PowerState powerState,
+                     const double scaleFactor, double max, double min, PowerState powerState,
                      const std::string& sensorConfiguration,
                      std::optional<BridgeGpio>&& bridgeGpio) :
     Sensor(boost::replace_all_copy(sensorName, " ", "_"),
diff --git a/src/ADCSensorMain.cpp b/src/ADCSensorMain.cpp
index 65cf1d7..db492d2 100644
--- a/src/ADCSensorMain.cpp
+++ b/src/ADCSensorMain.cpp
@@ -224,6 +224,23 @@ void createSensors(
                     }
                 }
 
+                auto findMinReading =
+                    baseConfiguration->second.find("Min");
+                float minReading = 0.0;
+                if (findMinReading != baseConfiguration->second.end())
+                {
+                    minReading = std::visit(VariantToFloatVisitor(),
+                                             findMinReading->second);
+                }
+                auto findMaxReading =
+                    baseConfiguration->second.find("Max");
+                float maxReading = 60.0;
+                if (findMaxReading != baseConfiguration->second.end())
+                {
+                    maxReading = std::visit(VariantToFloatVisitor(),
+                                             findMaxReading->second);
+                }
+
                 auto findPowerOn = baseConfiguration->second.find("PowerState");
                 PowerState powerState = PowerState::always;
                 if (findPowerOn != baseConfiguration->second.end())
@@ -295,12 +312,13 @@ void createSensors(
                         std::cerr << "biosPost";
 
                     std::cerr << " Scale factor:" << scaleFactor;
+                    std::cerr << " MinReading:" << minReading << " MaxReading:" << maxReading;
                     std::cerr << "\n";
                 }
                 sensor = std::make_shared<ADCSensor>(
                     path.string(), objectServer, dbusConnection, io, sensorName,
-                    std::move(sensorThresholds), scaleFactor, powerState,
-                    *interfacePath, std::move(bridgeGpio));
+                    std::move(sensorThresholds), scaleFactor, maxReading, minReading,
+                    powerState, *interfacePath, std::move(bridgeGpio));
                 sensor->setupRead();
             }
         }));
