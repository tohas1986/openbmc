Subject: [PATCH] Add-gpio-bridge-to-psusensor [RNDEMBED-351]

---
 include/PSUSensor.hpp | 108 +++++++++++++++++++++++++++++++++++++++++++++++++-
 src/PSUSensor.cpp     |  68 +++++++++++++++++++++++++------
 src/PSUSensorMain.cpp |  40 ++++++++++++++++++-
 src/meson.build       |   1 +
 4 files changed, 202 insertions(+), 15 deletions(-)

diff --git a/include/PSUSensor.hpp b/include/PSUSensor.hpp
index 0559073..476a1d8 100644
--- a/include/PSUSensor.hpp
+++ b/include/PSUSensor.hpp
@@ -10,6 +10,107 @@
 #include <string>
 #include <utility>
 
+#include <gpiod.hpp>
+#include <map>
+
+class BridgeGpio
+{
+
+  public:
+    static std::map<std::string, gpiod::line> lines;
+    static std::map<std::string, int> usage;
+    static std::map<std::string, int> requests;
+    static std::map<std::string, int> releases;
+    static bool debug;
+
+    BridgeGpio(const std::string& n, const int p)
+    {
+
+        name = n;
+        polarity = p;
+        line = gpiod::find_line(n);
+        if (!line)
+        {
+            std::cerr << "Error finding gpio: " << n << "\n";
+            return;
+        }
+
+        if (usage.count(name) != 1)
+        {
+            line.request({"psusensor",
+                          gpiod::line_request::DIRECTION_OUTPUT,
+                          polarity == gpiod::line::ACTIVE_HIGH
+                              ? 0
+                              : gpiod::line_request::FLAG_ACTIVE_LOW});
+            lines.insert(std::make_pair(name, line));
+            usage.insert(std::make_pair(name, 0));
+            requests.insert(std::make_pair(name, 0));
+            releases.insert(std::make_pair(name, 0));
+        }
+        line = lines[name];
+        usage[name] ++;
+        if (debug)
+            std::cerr << "Instantiated line:" << name << " usage: " << usage[name] << "\n";
+    }
+
+    void request()
+    {
+        if (line)
+        {
+            if (debug)
+                std::cerr << "Request line:" << name << " reqs: " << requests[name]
+                      << " releases:" << releases[name] << "\n";
+            try
+            {
+                if (requests[name] == 0 )
+                {
+                   if (debug)
+                       std::cerr << "Setting line: " << name << "\n";
+                   line.set_value(1);
+                }
+                requests[name] ++;
+            }
+            catch (std::system_error& e)
+            {
+                std::cerr << "Error requesting bridge: " << name
+                          << " error:" << e.what() << "\n";
+            }
+        }
+    }
+
+    void release()
+    {
+        if (line)
+        {
+            try
+            {
+                releases[name] ++;
+                if (debug)
+                    std::cerr << "Release line:" << name << " reqs: "
+                              << requests[name] << " releases:" << releases[name] << "\n";
+                if (requests[name] == releases[name])
+                {
+                    if (debug)
+                        std::cerr << "Unsetting line: " << name << "\n";
+                    requests[name] = 0;
+                    releases[name] = 0;
+                    line.set_value(0);
+                }
+            }
+            catch (std::system_error& e)
+            {
+                std::cerr << "Error releasing bridge: " << name
+                          << " error:" << e.what() << "\n";
+            }
+        }
+    }
+
+  private:
+    gpiod::line line;
+    std::string name;
+    int  polarity;
+};
+
 class PSUSensor : public Sensor, public std::enable_shared_from_this<PSUSensor>
 {
   public:
@@ -20,7 +121,8 @@ class PSUSensor : public Sensor, public std::enable_shared_from_this<PSUSensor>
               std::vector<thresholds::Threshold>&& thresholds,
               const std::string& sensorConfiguration,
               std::string& sensorTypeName, unsigned int factor, double max,
-              double min, const std::string& label, size_t tSize);
+              double min, const std::string& label, size_t tSize,
+              std::optional<BridgeGpio>&& bridgeGpio);
     ~PSUSensor() override;
     void setupRead(void);
 
@@ -40,7 +142,11 @@ class PSUSensor : public Sensor, public std::enable_shared_from_this<PSUSensor>
     void updateMinMaxValues(void);
 
     int fd;
+
+    std::optional<BridgeGpio> bridgeGpio;
+
     static constexpr unsigned int sensorPollMs = 1000;
+    static constexpr unsigned int gpioBridgeEnableMs = 100;
     static constexpr size_t warnAfterErrorCount = 10;
 };
 
diff --git a/src/PSUSensor.cpp b/src/PSUSensor.cpp
index 613cee0..d3ab180 100644
--- a/src/PSUSensor.cpp
+++ b/src/PSUSensor.cpp
@@ -43,13 +43,13 @@ PSUSensor::PSUSensor(const std::string& path, const std::string& objectType,
                      const std::string& sensorConfiguration,
                      std::string& sensorTypeName, unsigned int factor,
                      double max, double min, const std::string& label,
-                     size_t tSize) :
+                     size_t tSize, std::optional<BridgeGpio>&& bridgeGpio) :
     Sensor(boost::replace_all_copy(sensorName, " ", "_"),
            std::move(thresholdsIn), sensorConfiguration, objectType, max, min,
            conn),
     std::enable_shared_from_this<PSUSensor>(), objServer(objectServer),
     inputDev(io), waitTimer(io), path(path), pathRatedMax(""), pathRatedMin(""),
-    sensorFactor(factor), minMaxReadCounter(0)
+    sensorFactor(factor), minMaxReadCounter(0), bridgeGpio(std::move(bridgeGpio))
 {
     if constexpr (debug)
     {
@@ -133,17 +133,54 @@ void PSUSensor::setupRead(void)
     std::shared_ptr<boost::asio::streambuf> buffer =
         std::make_shared<boost::asio::streambuf>();
     std::weak_ptr<PSUSensor> weakRef = weak_from_this();
-    boost::asio::async_read_until(
-        inputDev, *buffer, '\n',
-        [weakRef, buffer](const boost::system::error_code& ec,
-                          std::size_t /*bytes_transfered*/) {
-            std::shared_ptr<PSUSensor> self = weakRef.lock();
-            if (self)
-            {
-                self->readBuf = buffer;
-                self->handleResponse(ec);
-            }
-        });
+
+    if (bridgeGpio.has_value())
+    {
+        (*bridgeGpio).request();
+        // In case a channel has a bridge circuit,we have to turn the bridge on
+        // prior to reading a value at least for one scan cycle to get a valid
+        // value. Guarantee that the HW signal can be stable, the HW signal
+        // could be instability.
+        waitTimer.expires_from_now(
+            boost::posix_time::milliseconds(gpioBridgeEnableMs));
+        waitTimer.async_wait(
+            [weakRef, buffer](const boost::system::error_code& ec) {
+                std::shared_ptr<PSUSensor> self = weakRef.lock();
+                if (ec == boost::asio::error::operation_aborted)
+                {
+                    return; // we're being canceled
+                }
+
+                if (self)
+                {
+                    boost::asio::async_read_until(
+                        self->inputDev, *buffer, '\n',
+                        [weakRef, buffer](const boost::system::error_code& ec,
+                                          std::size_t /*bytes_transfered*/) {
+                            std::shared_ptr<PSUSensor> self = weakRef.lock();
+                            if (self)
+                            {
+                                self->readBuf = buffer;
+                                self->handleResponse(ec);
+                            }
+                        });
+                }
+            });
+    }
+    else
+    {
+        boost::asio::async_read_until(
+            inputDev, *buffer, '\n',
+            [weakRef, buffer](const boost::system::error_code& ec,
+                              std::size_t /*bytes_transfered*/) {
+                    std::shared_ptr<PSUSensor> self = weakRef.lock();
+                if (self)
+                {
+                    self->readBuf = buffer;
+                    self->handleResponse(ec);
+                }
+            });
+    }
 }
 
 void PSUSensor::updateMinMaxValues(void)
@@ -197,6 +234,11 @@ void PSUSensor::handleResponse(const boost::system::error_code& err)
         incrementError();
     }
 
+    if (bridgeGpio.has_value())
+    {
+        (*bridgeGpio).release();
+    }
+
     lseek(fd, 0, SEEK_SET);
     waitTimer.expires_from_now(boost::posix_time::milliseconds(sensorPollMs));
 
diff --git a/src/PSUSensorMain.cpp b/src/PSUSensorMain.cpp
index 83c0c58..9e25608 100644
--- a/src/PSUSensorMain.cpp
+++ b/src/PSUSensorMain.cpp
@@ -814,11 +814,43 @@ static void createSensorsCallback(
             }
             // destruct existing one first if already created
             sensors[sensorName] = nullptr;
+            std::optional<BridgeGpio> bridgeGpio;
+            for (const SensorBaseConfiguration& suppConfig : *sensorData)
+            {
+                if (suppConfig.first.find("BridgeGpio") !=
+                    std::string::npos)
+                {
+                    auto findName = suppConfig.second.find("Name");
+                    if (findName != suppConfig.second.end())
+                    {
+                        std::string gpioName = std::visit(
+                            VariantToStringVisitor(), findName->second);
+
+                        int polarity = gpiod::line::ACTIVE_HIGH;
+                        auto findPolarity =
+                            suppConfig.second.find("Polarity");
+                        if (findPolarity != suppConfig.second.end())
+                        {
+                            if (std::string("Low") ==
+                                std::visit(VariantToStringVisitor(),
+                                           findPolarity->second))
+                            {
+                                polarity = gpiod::line::ACTIVE_LOW;
+                            }
+                        }
+                        bridgeGpio = BridgeGpio(gpioName, polarity);
+                    }
+
+                    break;
+                }
+            }
+
             sensors[sensorName] = std::make_shared<PSUSensor>(
                 sensorPathStr, sensorType, objectServer, dbusConnection, io,
                 sensorName, std::move(sensorThresholds), *interfacePath,
                 findSensorType->second, factor, psuProperty->maxReading,
-                psuProperty->minReading, labelHead, thresholdConfSize);
+                psuProperty->minReading, labelHead, thresholdConfSize,
+                std::move(bridgeGpio));
             sensors[sensorName]->setupRead();
             ++numCreated;
             if constexpr (debug)
@@ -949,6 +981,12 @@ void propertyInitialize(void)
                          {"fan2", {"fan2_alarm", "fan2_fault"}}}}};
 }
 
+std::map<std::string, gpiod::line> BridgeGpio::lines;
+std::map<std::string, int> BridgeGpio::usage;
+std::map<std::string, int> BridgeGpio::requests;
+std::map<std::string, int> BridgeGpio::releases;
+bool BridgeGpio::debug = false;
+
 int main()
 {
     boost::asio::io_service io;
