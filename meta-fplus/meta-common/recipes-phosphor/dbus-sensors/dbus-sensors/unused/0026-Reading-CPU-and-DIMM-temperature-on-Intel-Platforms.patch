+            if(meDataDIMMandCPU.size() >= (deviceDIMMID + deviceChannelID*4 + 3))
+            {
+                resp = meDataDIMMandCPU[deviceDIMMID + deviceChannelID*4 + 3];
+                readingMeDIMMDataTime = std::chrono::duration_cast<std::chrono::seconds>(
+                std::chrono::system_clock::now().time_since_epoch()).count();
+
+                return true;
+            }
+            else
+            {
+                return false;
+            }
+        }
+        case (ReadingFormat::tjmax):
+        {
+            if (data.size() < 3)
+            {
+                return false;
+            }
+            TjmaxValue = data[0];
+            resp = data[0];
+            return true;
+        }
+        case (ReadingFormat::dts):
+        {
+            if (data.size() < 3)
+            {
+                return false;
+            }
+            resp = data[3];
+            return true;
+        }
+        case (ReadingFormat::cpu):
+        {
+            if (data.size() < 3)
+            {
+                return false;
+            }
+            if (TjmaxValue > 0)
+            {
+                resp = TjmaxValue - data[3];
+                return true;
+            } else
+            {
+                resp = 100 - data[3];
+                return true;
+            }
+            return false;
+        }
         default:
             throw std::runtime_error("Invalid reading type");
     }
