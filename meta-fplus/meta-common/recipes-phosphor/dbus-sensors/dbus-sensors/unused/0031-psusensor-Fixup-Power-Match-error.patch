diff --git a/include/ADCSensor.hpp b/include/ADCSensor.hpp
index 243e732..1161533 100644
--- a/include/ADCSensor.hpp
+++ b/include/ADCSensor.hpp
@@ -68,7 +68,7 @@ class ADCSensor : public Sensor, public std::enable_shared_from_this<ADCSensor>
               boost::asio::io_service& io, const std::string& sensorName,
               std::vector<thresholds::Threshold>&& thresholds,
               const double scaleFactor, double max, double min,
-              PowerState readState,
+              PowerState powerState,
               const std::string& sensorConfiguration,
               std::optional<BridgeGpio>&& bridgeGpio);
     ~ADCSensor();
diff --git a/include/Utils.hpp b/include/Utils.hpp
index c1b80fa..6c04123 100644
--- a/include/Utils.hpp
+++ b/include/Utils.hpp
@@ -169,6 +169,21 @@ inline void setLed(std::shared_ptr<sdbusplus::asio::connection> conn,
         std::variant<bool>(on));
 }
 
+inline std::string getPowerState(PowerState val)
+{
+    std::string rc;
+    if (val == PowerState::on)
+        rc = "On";
+    else if (val == PowerState::biosPost)
+        rc = "BiosPost";
+    else if (val == PowerState::always)
+        rc = "Always";
+    else
+        rc = "Unknown";
+    return rc;
+}
+
+
 void createInventoryAssoc(
     std::shared_ptr<sdbusplus::asio::connection> conn,
     std::shared_ptr<sdbusplus::asio::dbus_interface> association,
