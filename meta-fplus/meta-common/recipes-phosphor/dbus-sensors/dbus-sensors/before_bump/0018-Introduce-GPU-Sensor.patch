+GPUSensor::GPUSensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+                             boost::asio::io_service& io,
+                             const std::string& sensorName,
+                             const std::string& sensorConfiguration,
+                             sdbusplus::asio::object_server& objectServer,
+                             std::vector<thresholds::Threshold>&& thresholdData,
+                             uint8_t busId, uint8_t deviceNum,
+                             const PowerState powerState, std::string& sensorTypeName,
+                             uint8_t slaveAddr,
+                             std::string& sensorClass,
+                             std::string& sensorSubType) :
+    Sensor(boost::replace_all_copy(sensorName, " ", "_"),
+           std::move(thresholdData), sensorConfiguration,
+           "xyz.openbmc_project.Configuration.GPUSensor", mcuTempMaxReading,
+           mcuTempMinReading, conn, powerState),
+    busId(busId), deviceNum(deviceNum), objectServer(objectServer), waitTimer(io), slaveAddr(slaveAddr)
+{
+
+    if (DEBUG) 
+    {
+        std::cerr << "Construct sensor Type:" << sensorTypeName << ";" << "SubType: " << sensorSubType << "\n";
+    }
+
+    std::string objPath = "/xyz/openbmc_project/sensors/";
+
+    if (sensorClass == "Temperature")
+    {
+        type = SensorTypes::temp;
+        if (sensorSubType == "HBMTEMP")
+        {
+            subType = SensorSubTypes::HBMTEMP;
+        }
+        else if ( sensorSubType == "GPUTEMP")
+        {
+            subType = SensorSubTypes::GPUTEMP;
+        }
+        objPath += "temperature/";
+        objPath += name;
+
+    }
+    else if (sensorClass == "Power")
+    {
+        type = SensorTypes::power;
+        
+        if(sensorSubType == "FPGAPOWER")
+        {
+            subType = SensorSubTypes::FPGAPOWER;
+        }
+        else if(sensorSubType == "GPUPOWER")
+        {
+            subType = SensorSubTypes::GPUPOWER;
+        }
+        else if(sensorSubType == "NWSWPOWER")
+        {
+            subType = SensorSubTypes::NWSWPOWER;
+        }
+
+        objPath += "power/";
+        objPath += name;
+    }
+
+    if (DEBUG)
+    {
+        std::cerr <<  "type=" << sensorTypeName << " objPath:" << objPath << "\n";
+    }
+
+    sensorInterface = objectServer.add_interface(
+        objPath, "xyz.openbmc_project.Sensor.Value");
+
+    if (thresholds::hasWarningInterface(thresholds))
+    {
+        thresholdInterfaceWarning = objectServer.add_interface(
+            objPath, "xyz.openbmc_project.Sensor.Threshold.Warning");
+    }
+    if (thresholds::hasCriticalInterface(thresholds))
+    {
+        thresholdInterfaceCritical = objectServer.add_interface(
+            objPath, "xyz.openbmc_project.Sensor.Threshold.Critical");
+    }
+    association = objectServer.add_interface(
+        objPath, association::interface);
+}
+
+GPUSensor::~GPUSensor()
+{
+    waitTimer.cancel();
+    objectServer.remove_interface(thresholdInterfaceWarning);
+    objectServer.remove_interface(thresholdInterfaceCritical);
+    objectServer.remove_interface(sensorInterface);
+    objectServer.remove_interface(association);
+}
+
+void GPUSensor::init(void)
+{
+    setInitialProperties(dbusConnection);
+    readSensor();
+}
+
+void GPUSensor::checkThresholds(void)
+{
+    thresholds::checkThresholds(this);
+}
+
+int GPUSensor::getRegister(uint8_t idx, uint32_t* value)
+{
+    std::string i2cBus = "/dev/i2c-" + std::to_string(busId);
+    int fd = open(i2cBus.c_str(), O_RDWR);
+
+    if (fd < 0)
+    {
+        std::cerr << " unable to open i2c device" << i2cBus << "  err=" << fd
+                  << "\n";
+        close(fd);
+        return -1;
+    }
+
+    if (ioctl(fd, I2C_SLAVE_FORCE, slaveAddr) < 0)
+    {
+        if (DEBUG)
+            std::cerr << " unable to set device address\n";
+        close(fd);
+        return -1;
+    }
+
+    unsigned long funcs = 0;
+    if (ioctl(fd, I2C_FUNCS, &funcs) < 0)
+    {
+        std::cerr << " not support I2C_FUNCS\n";
+        close(fd);
+        return -1;
+    }
+
+    if (!(funcs & I2C_FUNC_SMBUS_READ_WORD_DATA))
+    {
+        std::cerr << " not support I2C_FUNC_SMBUS_READ_WORD_DATA\n";
+        close(fd);
+        return -1;
+    }
+
+    /*Step 1: Send write cmd to 0x5D register*/
+    uint8_t response[16];
+    int ret = -1;
+
+    uint8_t gputempcmd[] = { 0x04, 0x02, 0x00, 0x00, 0x80 };
+    uint8_t hbmtempcmd[] = { 0x04, 0x02, 0x05, 0x00, 0x80 };
+    uint8_t gpupowercmd[] = { 0x04, 0x04, 0x00, 0x00, 0x80 };
+    uint8_t fpgapowercmd[] = { 0x04, 0x04, deviceNum, 0x00, 0x80 };
+
+    if((subType == SensorSubTypes::FPGAPOWER) || (subType == SensorSubTypes::NWSWPOWER))
+    {
+        ret = i2c_smbus_write_i2c_block_data(fd, 0x5C, 0x5, fpgapowercmd);
+        if (ret < 0)
+        {
+            std::cerr << "Failed to write block data" << " Bus:" << i2cBus << "\n";
+            close(fd);
+            return -1;
+        }
+    }
+
+    if(subType == SensorSubTypes::GPUTEMP)
+    {
+        ret = i2c_smbus_write_i2c_block_data(fd, 0x5C, 0x5, gputempcmd);
+        if (ret < 0)
+        {
+            std::cerr << "Failed to write block data" << " Bus:" << i2cBus << "\n";
+            close(fd);
+            return -1;
+        }
+    }
+
+    if(subType == SensorSubTypes::HBMTEMP)
+    {
+        ret = i2c_smbus_write_i2c_block_data(fd, 0x5C, 0x5, hbmtempcmd);
+        if (ret < 0)
+        {
+            std::cerr << "Failed to write block data" << " Bus:" << i2cBus << "\n";
+            close(fd);
+            return -1;
+        }
+    }
+
+    if(subType == SensorSubTypes::GPUPOWER)
+    {
+        ret = i2c_smbus_write_i2c_block_data(fd, 0x5C, 0x5, gpupowercmd);
+
+        if (ret < 0)
+        {
+            std::cerr << "Failed to write block data" << " Bus:" << i2cBus << "\n";
+            close(fd);
+            return -1;
+        }
+    }
+
+    /*Step 2: Read Query register from 0x5C*/
+    for (int i = 0; i < 5; i++)
+    {
+        ret = i2c_smbus_read_i2c_block_data(fd, 0x5C, 5, response);
+
+        if (ret < 0)
+        {
+            std::cerr << "Failed to read block data" << " Bus:" << i2cBus << "\n";
+            close(fd);
+            return -1;
+        }
+
+        if(response[4] == 0x5f)
+        {
+            break;
+        }
+        else if(response[4] == 0x1f)
+        {
+            break;
+        }
+        else
+        {
+            if(DEBUG)
+            {
+                std::cerr << "Data in Query could not be read, waiting for valid results" << "\n";
+                std::cerr << "Response: "<< std::hex << std::setfill('0') << std::setw(2) << +response[4] << "\n";
+            }
+
+            continue;
+        }
+    }
+    
+    /*ret = i2c_smbus_read_i2c_block_data(fd, 0x5C, 5, response);
+
+    if (ret < 0)
+    {
+        std::cerr << "Failed to read block data" << " Bus:" << i2cBus << "\n";
+        close(fd);
+        return -1;
+    }*/
+
+    if(DEBUG)
+    {
+        for(int i=0;i<5; i++)
+        {
+            std::cerr << std::hex << std::setfill('0') << std::setw(2) << +response[i] << " ";
+        }
+        std::cerr << "\n";
+    }
+
+    /*Step 3: Read Value from 0x5D*/
+    ret = i2c_smbus_read_i2c_block_data(fd, 0x5D, 5, response);
+    if (ret < 0)
+    {
+        std::cerr << "Failed to read block data" << " Bus:" << i2cBus << "\n";
+        close(fd);
+        return -1;
+    }
+    
+    if(DEBUG)
+    {
+        for(int i=0;i<5; i++)
+        {
+            std::cerr << std::hex << std::setfill('0') << std::setw(2) << +response[i] << " ";
+        }
+        std::cerr << "\n";
+    }
+
+    close(fd);
+
+    if(type == SensorTypes::power)
+    {
+        uint32_t res = (response[3] << 16) + (response[2] << 8) + response[1];
+        res /= 1000;
+        *value = res;
+        
+        if(DEBUG)
+        {
+            std::cerr << std::hex << "0x" << +response[1] << +response[2] << +response[3] << "  ;  SUM: " << +res << "\n";
+            std::cerr << "Value: " << +(*value) << "\n";
+        }
+        
+        if(subType == SensorSubTypes::FPGAPOWER)
+        {
+            updateProperty(sensorInterface, maxValue, 0x1770, "MaxValue");
+        }
+
+        if(subType == SensorSubTypes::GPUPOWER)
+        {
+            updateProperty(sensorInterface, maxValue, 0x258, "MaxValue");
+        }
+        if(subType == SensorSubTypes::NWSWPOWER)
+        {
+            updateProperty(sensorInterface, maxValue, 0x300, "MaxValue");
+        }
+    }
+    else
+    {
+        *value = response[idx];
+        if(DEBUG)std::cerr << "Value by index: " <<  +(*value) << "\n";
+    }
+
+    if(DEBUG)
+    {
+        std::cerr << "Response: " << std::hex << std::setfill('0') << std::setw(2) << +response[idx] << "\n";
+    }
+
+    return 0;
+}
+
+void GPUSensor::readSensor(void)
+{
+    static constexpr size_t pollTime = 5; // in seconds
+
+    int cntError = 0;
+
+    waitTimer.expires_from_now(boost::asio::chrono::seconds(pollTime));
+    waitTimer.async_wait([this](const boost::system::error_code& ec) {
+        // read timer error
+        if (ec)
+        {
+            incrementError();
+            readSensor();
+            return;
+        }
+        uint32_t value;
+        int ret;
+
+        /* Don't read anything if power is off */
+        if (isPowerOn())
+        {
+            ret = getRegister(2, &value);
+        }
+        else
+        {
+            ret = -1;
+        }
+
+        if (ret >= 0)
+        {
+            updateValue(static_cast<double>(value));
+            if(DEBUG)std::cerr << "Value after all: " << +value << "\n";
+        }
+        else
+        {
+            updateValue(std::numeric_limits<double>::quiet_NaN());
+            incrementError();
+            readSensor();
+            return;
+        }
+        readSensor();
+    });
+}
+
+void createSensors(
+    boost::asio::io_service& io, sdbusplus::asio::object_server& objectServer,
+    boost::container::flat_map<std::string, std::unique_ptr<GPUSensor>>&
+        sensors,
+    std::shared_ptr<sdbusplus::asio::connection>& dbusConnection)
+{
+    if (!dbusConnection)
+    {
+        std::cerr << "Connection not created\n";
+        exit(0);
+    }
+
+    dbusConnection->async_method_call(
+        [&io, &objectServer, &dbusConnection, &sensors](
+            boost::system::error_code ec, const ManagedObjectType& resp) {
+
+            if (ec)
+            {
+                std::cerr << "Error contacting entity manager\n";
+                exit(0);
+            }
+
+            for (const auto& pathPair : resp)
+            {
+                for (const auto& entry : pathPair.second)
+                {
+                    if (entry.first != configInterface)
+                    {
+                        continue;
+                    }
+                    std::string name =
+                        loadVariant<std::string>(entry.second, "Name");
+                    std::cerr << "Name: " << name << "\n";
+
+                    std::vector<thresholds::Threshold> sensorThresholds;
+                    
+                    if (!parseThresholdsFromConfig(pathPair.second,
+                                                   sensorThresholds))
+                    {
+                        std::cerr << "error populating thresholds for " << name << "\n";
+                    }
+
+                    uint8_t busId = loadVariant<uint8_t>(entry.second, "Bus");
+                    uint8_t deviceNum;
+
+                    try
+                    {
+                        deviceNum = loadVariant<uint8_t>(entry.second, "DeviceNum");
+                    }
+                    catch(...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get device Number\n";
+                    }
+
+                    if(DEBUG)
+                    {
+                        std::cerr << "BUS ID: " << +busId << "\n";
+                        std::cerr << "Device Number: " << +deviceNum << "\n";
+                    }
+                    std::string sensorTypeName;
+                    
+                    try
+                    {
+                        sensorTypeName = loadVariant<std::string>(entry.second, "Type");
+                        if(DEBUG) std::cerr << "Type: " << sensorTypeName << "\n";
+                    }
+                    catch(...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get sensorTypeName, setting to default\n";
+                    }
+                    
+                    std::string sensorSubType;
+                    try
+                    {
+                        sensorSubType = loadVariant<std::string>(entry.second, "SubType");
+                        if(DEBUG) std::cerr << "SubType: " << sensorSubType << "\n";
+                    }
+                    catch(...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get sensorSubType, setting to default\n";
+                    }
+                    
+                    std::string sensorClass;
+                    try
+                    {
+                        sensorClass = loadVariant<std::string>(entry.second, "Class");
+                        if(DEBUG) std::cerr << "Class: " << sensorClass << "\n";
+                    }
+                    catch(...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get sensorTypeName, setting to default\n";
+                    }
+
+                    uint8_t slaveAddr;
+                    try
+                    {
+                        slaveAddr = loadVariant<uint8_t>(entry.second, "SlaveAddr");
+                        if(DEBUG) std::cerr << "Slave Addr: " << +slaveAddr << "\n";
+                    }
+                    catch(...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get SlaveAddr, setting to default\n";
+                    }
+
+
+                    if (DEBUG)
+                    {
+                        std::ios oldState(nullptr);
+                        oldState.copyfmt(std::cerr);
+                        std::cerr
+                            << "Configuration parsed for \n\t" << entry.first
+                            << "\n"
+                            << "with\n"
+                            << "\tName: " << name << "\n"
+                            << "\tBus: " << static_cast<int>(busId) << "\n"
+                            << "\tSlaveAddr: 0x" << std::hex << std::setfill('0') << std::setw(2) << +slaveAddr << "\n"
+                            << "\tType: " << sensorTypeName
+                            << "\n";
+                        std::cerr.copyfmt(oldState);
+                    }
+
+                    PowerState powerState = PowerState::on;
+                    auto& sensor = sensors[name];
+
+                    sensor = std::make_unique<GPUSensor>(
+                        dbusConnection, io, name, pathPair.first, objectServer,
+                        std::move(sensorThresholds), busId, deviceNum,
+                        powerState, sensorTypeName, slaveAddr, sensorClass, sensorSubType);
+
+                    sensor->init();
+                }
+            }
+        },
+        entityManagerName, "/", "org.freedesktop.DBus.ObjectManager",
+        "GetManagedObjects");
+}
+
+int main(int argc, char* argv[])
+{
+    CLI::App app("GPU SMBPBI poller");
+    app.add_option("-v,--verbose", DEBUG, "print debug output");
+    CLI11_PARSE(app, argc, argv);
+
+    boost::asio::io_service io;
+    auto systemBus = std::make_shared<sdbusplus::asio::connection>(io);
+    systemBus->request_name("xyz.openbmc_project.GPUSensor");
+    sdbusplus::asio::object_server objectServer(systemBus);
+
+    io.post([&]() { createSensors(io, objectServer, sensors, systemBus); });
+
+    boost::asio::steady_timer configTimer(io);
+
+    std::function<void(sdbusplus::message::message&)> eventHandler =
+        [&](sdbusplus::message::message&) {
+            configTimer.expires_from_now(boost::asio::chrono::seconds(1));
+            // create a timer because normally multiple properties change
+            configTimer.async_wait([&](const boost::system::error_code& ec) {
+                // config timer error
+                if (ec)
+                {
+                    return;
+                }
+                createSensors(io, objectServer, sensors, systemBus);
+                if (sensors.empty())
+                {
+                    std::cout << "Configuration not detected\n";
+                }
+            });
+        };
+    sdbusplus::bus::match::match configMatch(
+        static_cast<sdbusplus::bus::bus&>(*systemBus),
+        "type='signal',member='PropertiesChanged',"
+        "path_namespace='" +
+            std::string(inventoryPath) +
+            "',"
+            "arg0namespace='" +
+            configInterface + "'",
+        eventHandler);
+
+    io.run();
+}
