Subject: [PATCH 11/16] NVMeSensor: Change timer; Add debug; Add exit on error

---
 include/NVMeSensor.hpp |  6 +++---
 src/NVMeSensor.cpp     | 20 ++++++++------------
 src/NVMeSensorMain.cpp | 20 +++++++++++++++-----
 3 files changed, 26 insertions(+), 20 deletions(-)

diff --git a/include/NVMeSensor.hpp b/include/NVMeSensor.hpp
index 02510d4..c3761a1 100644
--- a/include/NVMeSensor.hpp
+++ b/include/NVMeSensor.hpp
@@ -3,7 +3,7 @@
 #include <libmctp-smbus.h>
 #include <libmctp.h>
 
-#include <boost/asio/deadline_timer.hpp>
+#include <boost/asio/steady_timer.hpp>
 #include <boost/asio/io_service.hpp>
 #include <boost/asio/ip/tcp.hpp>
 #include <sensor.hpp>
@@ -38,9 +38,9 @@ struct NVMeContext : std::enable_shared_from_this<NVMeContext>
     void pollNVMeDevices();
     void close();
 
-    boost::asio::deadline_timer scanTimer;
+    boost::asio::steady_timer scanTimer;
     int rootBus; // Root bus for this drive
-    boost::asio::deadline_timer mctpResponseTimer;
+    boost::asio::steady_timer mctpResponseTimer;
     boost::asio::ip::tcp::socket nvmeSlaveSocket;
     std::list<std::shared_ptr<NVMeSensor>> sensors; // used as a poll queue
 };
diff --git a/src/NVMeSensor.cpp b/src/NVMeSensor.cpp
index 1c78354..535eed4 100644
--- a/src/NVMeSensor.cpp
+++ b/src/NVMeSensor.cpp
@@ -27,8 +27,7 @@
 static constexpr double maxReading = 127;
 static constexpr double minReading = 0;
 
-static constexpr bool debug = false;
-
+extern bool DEBUG;
 void rxMessage(uint8_t eid, void* data, void* msg, size_t len);
 
 namespace nvmeMCTP
@@ -117,7 +116,7 @@ void readResponse(const std::shared_ptr<NVMeContext>& nvmeDevice)
         [nvmeDevice](const boost::system::error_code errorCode) {
             if (errorCode)
             {
-                return;
+                exit(0);
             }
 
             mctp_smbus_set_in_fd(nvmeMCTP::smbus,
@@ -211,6 +210,7 @@ void readAndProcessNVMeSensor(const std::shared_ptr<NVMeContext>& nvmeDevice)
 
     if (nvmeDevice->sensors.empty())
     {
+        if (DEBUG) std::cerr << __FUNCTION__ << " sensors empty, exiting\n";
         return;
     }
 
@@ -218,14 +218,14 @@ void readAndProcessNVMeSensor(const std::shared_ptr<NVMeContext>& nvmeDevice)
 
     // setup the timeout timer
     nvmeDevice->mctpResponseTimer.expires_from_now(
-        boost::posix_time::seconds(mctpResponseTimeout));
+        boost::asio::chrono::seconds(mctpResponseTimeout));
 
     nvmeDevice->mctpResponseTimer.async_wait(
         [sensor, nvmeDevice](const boost::system::error_code errorCode) {
             if (errorCode)
             {
                 // timer cancelled successfully
-                return;
+                exit(0);
             }
 
             sensor->incrementError();
@@ -395,17 +395,13 @@ NVMeContext::NVMeContext(boost::asio::io_service& io, int rootBus) :
 
 void NVMeContext::pollNVMeDevices()
 {
-    scanTimer.expires_from_now(boost::posix_time::seconds(1));
+    scanTimer.expires_from_now(boost::asio::chrono::seconds(5));
     scanTimer.async_wait(
         [self{shared_from_this()}](const boost::system::error_code errorCode) {
-            if (errorCode == boost::asio::error::operation_aborted)
-            {
-                return; // we're being canceled
-            }
-            else if (errorCode)
+            if (errorCode)
             {
                 std::cerr << "Error:" << errorCode.message() << "\n";
-                return;
+                exit(0);
             }
             else
             {
