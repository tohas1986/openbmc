+#pragma once
+#include "sensor.hpp"
+
+#include <boost/asio/steady_timer.hpp>
+#include <boost/container/flat_map.hpp>
+
+#include <chrono>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+enum class SensorTypes
+{
+    temp,
+    pdlu
+};
+
+struct NVMELegacySensor : public Sensor
+{
+    NVMELegacySensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+                  boost::asio::io_service& io, const std::string& name,
+                  const std::string& sensorConfiguration,
+                  sdbusplus::asio::object_server& objectServer,
+                  std::vector<thresholds::Threshold>&& thresholds,
+                  uint8_t busId,
+                  const PowerState powerState, std::string &sensorTypeName,
+                  uint8_t slaveAddr);
+    ~NVMELegacySensor();
+
+    void checkThresholds(void) override;
+    void readSensor(void);
+    void init(void);
+
+    uint8_t busId;
+    uint8_t slaveAddr;
+    SensorTypes type;
+
+  private:
+    int getRegister(uint8_t idx, int8_t* temp);
+    sdbusplus::asio::object_server& objectServer;
+    boost::asio::steady_timer waitTimer;
+};
diff --git a/service_files/xyz.openbmc_project.nvmelegacysensor.service b/service_files/xyz.openbmc_project.nvmelegacysensor.service
