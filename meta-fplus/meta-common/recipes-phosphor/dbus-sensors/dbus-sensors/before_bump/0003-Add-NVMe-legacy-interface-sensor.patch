--- /dev/null
+++ b/service_files/xyz.openbmc_project.nvmelegacysensor.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=Legacy interface NVMe Temp Sensor
+StopWhenUnneeded=false
+Requires=xyz.openbmc_project.EntityManager.service
+After=xyz.openbmc_project.EntityManager.service
+
+[Service]
+Restart=always
+RestartSec=5
+ExecStart=/usr/bin/nvmelegacysensor
+
+[Install]
+WantedBy=multi-user.target
