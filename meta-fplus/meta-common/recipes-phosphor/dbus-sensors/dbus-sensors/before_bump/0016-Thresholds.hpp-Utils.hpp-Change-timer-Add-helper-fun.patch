@@ -251,7 +265,7 @@ struct GetSensorConfiguration :
                                         const GetSubTreeType& ret) {
                 if (ec)
                 {
-                    std::cerr << "Error calling mapper\n";
+                    std::cerr << "Error calling mapper, "<< retries << " tries left\n";
                     if (!retries)
