diff --git a/src/FanMain.cpp b/src/FanMain.cpp
index 0b598d9..1f23399 100644
--- a/src/FanMain.cpp
+++ b/src/FanMain.cpp
@@ -39,7 +39,10 @@
 #include <variant>
 #include <vector>
 
-static constexpr bool debug = false;
