 namespace fs = std::filesystem;
 
@@ -69,18 +72,22 @@ std::optional<RedundancySensor> systemRedundancy;
 
 FanTypes getFanType(const fs::path& parentPath)
 {
+    if (DEBUG) std::cerr << __FUNCTION__ << " path:" << parentPath << "\n";
     fs::path linkPath = parentPath / "device";
     std::string canonical = fs::read_symlink(linkPath);
     if (boost::ends_with(canonical, "1e786000.pwm-tacho-controller") ||
         boost::ends_with(canonical, "1e610000.pwm-tacho-controller"))
     {
+        if (DEBUG) std::cerr << __FUNCTION__ << " Aspeed found\n";
         return FanTypes::aspeed;
     }
     if (boost::ends_with(canonical, "f0103000.pwm-fan-controller"))
     {
+        if (DEBUG) std::cerr << __FUNCTION__ << " Nuvoton found\n";
         return FanTypes::nuvoton;
     }
     // todo: will we need to support other types?
+    if (DEBUG) std::cerr << __FUNCTION__ << " I2C found\n";
     return FanTypes::i2c;
 }
 
@@ -164,11 +171,13 @@ void createSensors(
             // configuration
             for (const auto& path : paths)
             {
+                if (DEBUG) std::cerr << __FUNCTION__ << " Checking path:" << path << "\n";
                 std::smatch match;
                 std::string pathStr = path.string();
 
                 std::regex_search(pathStr, match, inputRegex);
                 std::string indexStr = *(match.begin() + 1);
+                if (DEBUG) std::cerr << __FUNCTION__ << " indexStr:" << indexStr << "\n";
 
                 fs::path directory = path.parent_path();
                 FanTypes fanType = getFanType(directory);
@@ -196,6 +205,7 @@ void createSensors(
                 const SensorData* sensorData = nullptr;
