 ]
 
 foreach tuple : unit_files
diff --git a/service_files/xyz.openbmc_project.i2csensor.service b/service_files/xyz.openbmc_project.i2csensor.service
new file mode 100644
index 0000000..e1d7892
--- /dev/null
+++ b/service_files/xyz.openbmc_project.i2csensor.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=I2C status Sensor
+StopWhenUnneeded=false
+Requires=xyz.openbmc_project.EntityManager.service
+After=xyz.openbmc_project.EntityManager.service
+
+[Service]
+Restart=always
+RestartSec=5
+ExecStart=/usr/bin/i2csensor
+
+[Install]
+WantedBy=multi-user.target
diff --git a/src/I2CSensorMain.cpp b/src/I2CSensorMain.cpp
new file mode 100644
index 0000000..919f470
--- /dev/null
+++ b/src/I2CSensorMain.cpp
@@ -0,0 +1,143 @@
+/*
