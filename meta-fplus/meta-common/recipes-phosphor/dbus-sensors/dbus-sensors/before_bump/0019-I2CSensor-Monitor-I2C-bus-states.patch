 .../xyz.openbmc_project.i2csensor.service          |  13 ++
 src/I2CSensorMain.cpp                              | 143 +++++++++++++++++++++
 src/meson.build                                    |  18 +++
 5 files changed, 176 insertions(+)
 create mode 100644 service_files/xyz.openbmc_project.i2csensor.service
 create mode 100644 src/I2CSensorMain.cpp

diff --git a/meson_options.txt b/meson_options.txt
index a00d778..1a9dda9 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -14,3 +14,4 @@ option('nvmelegacy', type: 'feature', value: 'enabled', description: 'Enable NVM
 option('health', type: 'feature', value: 'enabled', description: 'BMC Health sensor',)
 option('sysfs', type: 'feature', value: 'enabled', description: 'Enable sysfs generic sensor.',)
 option('gpu', type: 'feature', value: 'enabled', description: 'Enable GPU SMBPBI sensor.',)
+option('i2c', type: 'feature', value: 'enabled', description: 'Enable I2C bus state sensor.',)
diff --git a/service_files/meson.build b/service_files/meson.build
index bc43856..db8bf2f 100644
--- a/service_files/meson.build
+++ b/service_files/meson.build
@@ -14,6 +14,7 @@ unit_files = [
     ['health', 'xyz.openbmc_project.healthsensor.service'],
     ['sysfs', 'xyz.openbmc_project.sysfssensor.service'],
     ['gpu', 'xyz.openbmc_project.gpusensor.service'],
