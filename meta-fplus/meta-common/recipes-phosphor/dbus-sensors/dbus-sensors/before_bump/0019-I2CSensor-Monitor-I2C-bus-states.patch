+
+#include <Utils.hpp>
+#include <boost/algorithm/string/predicate.hpp>
+#include <boost/container/flat_map.hpp>
+#include <boost/asio/steady_timer.hpp>
+#include <boost/asio.hpp>
+#include <chrono>
+#include <ctime>
+#include <iostream>
+#include <ios>
+#include <sdbusplus/asio/connection.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <sdbusplus/asio/sd_event.hpp>
+#include <sdbusplus/bus.hpp>
+#include <sdbusplus/exception.hpp>
+#include <sdbusplus/server.hpp>
+#include <sdbusplus/timer.hpp>
+#include <sensor.hpp>
+#include <systemd/sd-journal.h>
+#include <sys/mman.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <CLI/CLI.hpp>
+bool DEBUG = false;
+
+static constexpr int timerPeriod = 5;
+
+static boost::container::flat_map<int, std::shared_ptr<sdbusplus::asio::dbus_interface>> ifaces;
+
+static int devmem_fd;
+static void *i2c_base_mmap;
+
+uint8_t get_bus_status(int bus)
+{
+    uint8_t rc = 0;
+    for(int i=0; i<10; i++)
+    {
+        // Status and command register
+        uint32_t offset = 0x40 * (bus + 1) + 0x14;
+        if (bus > 6)
+            offset += 0x100;
+
+        uint32_t status_reg = *(uint32_t *)(i2c_base_mmap + offset);
+        rc = (status_reg >> 16 ) & 0x01;
+        if (DEBUG)
+        {
+            std::ios oldState(nullptr);
+            oldState.copyfmt(std::cerr);
+            std::cerr << "Bus: " << +bus << " Status:" << +rc
+                      << std::hex << std::setfill('0')
+                      << " Offset:0x" << std::setw(3) << offset
+                      << " Reg:0x" << std::setw(8) << +status_reg << "\n";
+            std::cerr.copyfmt(oldState);
+        }
+
+        if (rc == 0)
+            return 0;
+    }
+
+    return rc;
+}
+
+boost::asio::io_service io;
+static boost::asio::steady_timer waitTimer(io);
+
+void updateSensors(const boost::system::error_code& /*e*/)
+{
+    for(int bus=0; bus < 14; bus++)
+        ifaces[bus]->set_property("Value", double(get_bus_status(bus)));
+
+    waitTimer.expires_from_now(std::chrono::seconds(timerPeriod));
+    waitTimer.async_wait(updateSensors);
+}
+
+int main(int argc, char* argv[])
+{
+    CLI::App app("Generic sysfs sensors poller");
+    app.add_option("-v,--verbose", DEBUG, "print debug output");
+    CLI11_PARSE(app, argc, argv);
+
+    auto systemBus = std::make_shared<sdbusplus::asio::connection>(io);
+    auto objServer = sdbusplus::asio::object_server(systemBus);
+
+    // setup object server, define interface
+    systemBus->request_name("xyz.openbmc_project.I2CSensor");
+
+    // Get access to physical memory
+    devmem_fd = open("/dev/mem", O_RDWR|O_SYNC);
+    if (devmem_fd < 0)
+    {
+        std::cerr << "/dev/mem open failed\n";
+        exit(0);
+    }
+
+    i2c_base_mmap = mmap(NULL, 0x1000, PROT_READ, MAP_SHARED, devmem_fd, 0x1e78a000);
+    if (i2c_base_mmap == MAP_FAILED)
+    {
+        std::cerr << "mmap failed\n";
+        close(devmem_fd);
+        exit(0);
+    }
+
+    // Walk through all 14 buses
+    for(int bus=0; bus < 14; bus++)
+    {
+        std::string sensorPath = "/xyz/openbmc_project/sensors/i2c/I2C_" + std::to_string(bus);
+
+        // add interface into sensor tree
+        std::shared_ptr<sdbusplus::asio::dbus_interface> iface =
+            objServer.add_interface(sensorPath, sensorValueInterface);
+
+        uint8_t i2cBusStatus = get_bus_status(bus);
+
+        iface->register_property("Value", double(i2cBusStatus));
+        iface->initialize();
+        ifaces[bus] = iface;
+    }
+
+    waitTimer.expires_from_now(std::chrono::seconds(timerPeriod));
+    waitTimer.async_wait(updateSensors);
+
+    io.run();
+
+    return 0;
+}
diff --git a/src/meson.build b/src/meson.build
index f956c6d..8f6f39e 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -285,3 +285,21 @@ if get_option('sysfs').enabled()
         ],
     )
 endif
+
+if get_option('i2c').enabled()
+    executable(
+        'i2csensor',
+        'I2CSensorMain.cpp',
+        dependencies: [
+            sdbusplus,
+            gpiodcxx,
+        ],
+        implicit_include_directories: false,
+        include_directories: '../include',
+        install: true,
+        link_with: [
+            thresholds_a,
+            utils_a,
+        ],
+    )
+endif
