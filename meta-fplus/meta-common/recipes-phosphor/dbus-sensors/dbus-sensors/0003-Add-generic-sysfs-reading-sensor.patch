+
+int main(int argc, char* argv[])
+{
+    CLI::App app("Generic sysfs sensors poller");
+    app.add_option("-v,--verbose", DEBUG, "print debug output");
+    CLI11_PARSE(app, argc, argv);
+
+    boost::asio::io_service io;
+    auto systemBus = std::make_shared<sdbusplus::asio::connection>(io);
+
+    systemBus->request_name("xyz.openbmc_project.SysfsSensor");
+    sdbusplus::asio::object_server objectServer(systemBus);
+    auto sensorsChanged =
+        std::make_shared<boost::container::flat_set<std::string>>();
+
+    propertyInitialize();
+
+    io.post([&]() { createSensors(io, objectServer, systemBus, nullptr); });
+    boost::asio::steady_timer filterTimer(io);
+    std::function<void(sdbusplus::message_t&)> eventHandler =
+        [&](sdbusplus::message_t& message) {
+            if (message.is_method_error())
+            {
+                if (DEBUG) std::cerr << "callback method error\n";
+                return;
+            }
+            sensorsChanged->insert(message.get_path());
+            filterTimer.expires_from_now(boost::asio::chrono::seconds(3));
+            filterTimer.async_wait([&](const boost::system::error_code& ec) {
+                if (ec)
+                {
+                    if (DEBUG) std::cerr << __FUNCTION__ << ":" << __LINE__ << " ERROR\n";
+                    return;
+                }
+                if (DEBUG) std::cerr << __FUNCTION__ << ":" << __LINE__ << " Creating sensors\n";
+                createSensors(io, objectServer, systemBus, sensorsChanged);
+            });
+        };
+
+    std::vector<std::unique_ptr<sdbusplus::bus::match_t>> matches =
+        setupPropertiesChangedMatches(*systemBus, sensorTypes, eventHandler);
+    io.run();
+}
