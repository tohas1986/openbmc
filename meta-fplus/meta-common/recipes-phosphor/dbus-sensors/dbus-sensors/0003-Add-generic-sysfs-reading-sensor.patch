+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+*/
+
+#include <unistd.h>
+
+#include <SysfsSensor.hpp>
+#include <boost/algorithm/string/predicate.hpp>
+#include <boost/algorithm/string/replace.hpp>
+#include <boost/asio/read_until.hpp>
+#include <boost/asio/read.hpp>
+#include <boost/asio/steady_timer.hpp>
+#include <sdbusplus/asio/connection.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <boost/serialization/optional.hpp>
+
+#include <iostream>
+#include <istream>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+static constexpr const char* sensorPathPrefix = "/xyz/openbmc_project/sensors/";
+
+extern bool DEBUG;
+
+SysfsSensor::SysfsSensor(const std::string& path, const std::string& objectType,
+                     sdbusplus::asio::object_server& objectServer,
+                     std::shared_ptr<sdbusplus::asio::connection>& conn,
+                     boost::asio::io_service& io, const std::string& sensorName,
+                     std::vector<thresholds::Threshold>&& thresholdsIn,
+                     const std::string& sensorConfiguration,
+                     const std::string& sensorUnits, unsigned int factor,
+                     double max, double min, const std::string& label,
+                     size_t tSize, PowerState powerState) :
+    Sensor(boost::replace_all_copy(sensorName, " ", "_"),
+           std::move(thresholdsIn), sensorConfiguration, objectType, false, false, max, min,
+           conn, powerState),
+    std::enable_shared_from_this<SysfsSensor>(), objServer(objectServer),
+    inputDev(io), waitTimer(io), path(path), pathRatedMax(""), pathRatedMin(""),
+    sensorFactor(factor), minMaxReadCounter(0), sensorName(sensorName), powerState(powerState)
+{
+    setupPowerMatch(conn);
+    std::string unitPath = sensor_paths::getPathForUnits(sensorUnits);
+
+    if (DEBUG)
+    {
+        std::cerr << "Constructed sensor: path " << path << " type "
+                  << objectType << " config " << sensorConfiguration
+                  << " typename " << unitPath << " factor " << factor
+                  << " min " << min << " max " << max << " name \""
+                  << sensorName << "\"";
+        std::cerr << " PowerState:" << getPowerState(powerState) << "\n";
+    }
+
+    std::string dbusPath = sensorPathPrefix + unitPath + "/" + name;
+
+    sensorInterface = objectServer.add_interface(
+        dbusPath, "xyz.openbmc_project.Sensor.Value");
+
+    if (thresholds::hasWarningInterface(thresholds))
+    {
+        thresholdInterfaceWarning = objectServer.add_interface(
+            dbusPath, "xyz.openbmc_project.Sensor.Threshold.Warning");
+    }
+    if (thresholds::hasCriticalInterface(thresholds))
+    {
+        thresholdInterfaceCritical = objectServer.add_interface(
+            dbusPath, "xyz.openbmc_project.Sensor.Threshold.Critical");
+    }
+
+    // This should be called before initializing association.
+    // createInventoryAssoc() does add more associations before doing
+    // register and initialize "Associations" property.
+    if (label.empty() || tSize == thresholds.size())
+    {
+        setInitialProperties(sensorUnits);
+    }
+    else
+    {
+        setInitialProperties(sensorUnits, label, tSize);
+    }
+
+    association = objectServer.add_interface(dbusPath, association::interface);
+
+    createInventoryAssoc(conn, association, configurationPath);
+
+    if (auto fileParts = splitFileName(path))
+    {
+        auto& [type, nr, item] = *fileParts;
+        if (item.compare("input") == 0)
+        {
+            pathRatedMax = boost::replace_all_copy(path, item, "rated_max");
+            pathRatedMin = boost::replace_all_copy(path, item, "rated_min");
+        }
+    }
+    if (DEBUG)
+    {
+        std::cerr << "File: " << pathRatedMax
+                  << " will be used to update MaxValue\n";
+        std::cerr << "File: " << pathRatedMin
+                  << " will be used to update MinValue\n";
+    }
+}
+
+SysfsSensor::~SysfsSensor()
+{
+    waitTimer.cancel();
+    objServer.remove_interface(sensorInterface);
+    objServer.remove_interface(thresholdInterfaceWarning);
+    objServer.remove_interface(thresholdInterfaceCritical);
+    objServer.remove_interface(association);
+}
+
+void SysfsSensor::updateMinMaxValues(void)
+{
+    if (auto newVal = readFile(pathRatedMin, sensorFactor))
+    {
+        updateProperty(sensorInterface, minValue, *newVal, "MinValue");
+    }
+
+    if (auto newVal = readFile(pathRatedMax, sensorFactor))
+    {
+        updateProperty(sensorInterface, maxValue, *newVal, "MaxValue");
+    }
+}
+
+void SysfsSensor::setupRead(void)
+{
+    if (DEBUG) std::cerr << __FUNCTION__ << " " << sensorName << "\n";
+
+    const std::string cSensorName(sensorName);
+
+    if (powerState == PowerState::on && !isPowerOn())
+    {
+        if (DEBUG) std::cerr << __FUNCTION__ << " " << sensorName
+                    << " Power is off and PowerState is on, re-scheduling SetupRead\n";
+        updateValue(std::numeric_limits<double>::quiet_NaN());
+
+        waitTimer.expires_from_now(boost::asio::chrono::milliseconds(sensorPollPowerOffMs));
+        std::weak_ptr<SysfsSensor> weakRef = weak_from_this();
+        waitTimer.async_wait([weakRef, cSensorName](const boost::system::error_code& ec) {
+            std::shared_ptr<SysfsSensor> self = weakRef.lock();
+            if (!self || ec)
+            {
+                if (DEBUG) std::cerr << __FUNCTION__ << ":" << __LINE__ << " " << cSensorName << " Error: no self\n";
+                return;
+            }
+
+            self->setupRead();
+        });
+        return;
+    }
+
+    if (DEBUG) std::cerr << __FUNCTION__ << ":" << __LINE__ <<  " " << sensorName << " Scheduling sensor read\n";
+
+    boost::system::error_code err;
+    std::shared_ptr<boost::asio::streambuf> buffer = std::make_shared<boost::asio::streambuf>();
+
+    int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0)
+    {
+        err = boost::system::errc::make_error_code(boost::system::errc::not_supported);
+    }
+    else
+    {
+        inputDev.assign(fd);
+        inputDev.non_blocking(true);
+
+        boost::asio::read_until(inputDev, *buffer, '\n', err);
+        inputDev.close();
+    }
+
+    if(err)
+    {
+        if (DEBUG) std::cerr << __FUNCTION__ << " " << sensorName << " read error\n";
+        incrementError();
+    }
+    else
+    {
+        std::istream responseStream(buffer.get());
+        std::string response;
+        try
+        {
+            std::getline(responseStream, response);
+            if (DEBUG) std::cerr << __FUNCTION__ << " " << sensorName << " Got read:" << response << "\n";
+            rawValue = std::stod(response);
+            responseStream.clear();
+            double nvalue = std::round(rawValue / sensorFactor);
+
+            updateValue(nvalue);
+
+            if (minMaxReadCounter++ % 8 == 0)
+            {
+                updateMinMaxValues();
+            }
+        }
+        catch (const std::invalid_argument&)
+        {
+            std::cerr << "Could not parse " << response << "\n";
+            incrementError();
+        }
+    }
+
+    // Re-schedule setupRead()
+    waitTimer.expires_from_now(boost::asio::chrono::milliseconds(sensorPollMs));
+    std::weak_ptr<SysfsSensor> weakRef = weak_from_this();
+    waitTimer.async_wait([weakRef, cSensorName](const boost::system::error_code& ec) {
+        std::shared_ptr<SysfsSensor> self = weakRef.lock();
+        if (!self || ec)
+        {
+            if (DEBUG) std::cerr << __FUNCTION__ << ":" << __LINE__ << " " << cSensorName << " Error: no self\n";
+            return;
+        }
+
+        self->setupRead();
+    });
+}
+
+void SysfsSensor::checkThresholds(void)
+{
+    thresholds::checkThresholds(this);
+}
