diff --git a/include/SysfsSensor.hpp b/include/SysfsSensor.hpp
new file mode 100644
index 0000000..a606ed2
--- /dev/null
+++ b/include/SysfsSensor.hpp
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <Thresholds.hpp>
+#include <boost/asio/streambuf.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <sensor.hpp>
+#include <boost/asio/steady_timer.hpp>
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include <gpiod.hpp>
+#include <map>
+
+class SysfsSensor : public Sensor, public std::enable_shared_from_this<SysfsSensor>
+{
+  public:
+    SysfsSensor(const std::string& path, const std::string& objectType,
+              sdbusplus::asio::object_server& objectServer,
+              std::shared_ptr<sdbusplus::asio::connection>& conn,
+              boost::asio::io_service& io, const std::string& sensorName,
+              std::vector<thresholds::Threshold>&& thresholds,
+              const std::string& sensorConfiguration,
+              const std::string& sensorUnits, unsigned int factor, double max,
+              double min, const std::string& label, size_t tSize,
+              PowerState powerState);
+    ~SysfsSensor() override;
+    void setupRead(void);
+
+  private:
+    sdbusplus::asio::object_server& objServer;
+    boost::asio::posix::stream_descriptor inputDev;
+    boost::asio::steady_timer waitTimer;
+    std::string path;
+    std::string pathRatedMax;
+    std::string pathRatedMin;
+    size_t errCount;
+    unsigned int sensorFactor;
+    uint8_t minMaxReadCounter;
+    void checkThresholds(void) override;
+    void updateMinMaxValues(void);
+    std::string sensorName;
+    PowerState powerState;
+
+    static constexpr unsigned int sensorPollMs = 1000;
+    static constexpr unsigned int sensorPollPowerOffMs = 5000;
+    static constexpr size_t warnAfterErrorCount = 10;
+};
+
+class SysfsProperty
+{
+  public:
+    SysfsProperty(std::string name, double max, double min, unsigned int factor) :
+        labelTypeName(std::move(name)), maxReading(max), minReading(min),
+        sensorScaleFactor(factor)
+    {}
+    ~SysfsProperty() = default;
+
+    std::string labelTypeName;
+    double maxReading;
+    double minReading;
+    unsigned int sensorScaleFactor;
+};
diff --git a/service_files/xyz.openbmc_project.sysfssensor.service b/service_files/xyz.openbmc_project.sysfssensor.service
