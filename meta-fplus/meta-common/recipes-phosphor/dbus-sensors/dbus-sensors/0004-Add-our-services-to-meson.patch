From d494db42d43242991a52eabe5522d092627cda7b Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 15 Jun 2021 15:42:48 +0000
Subject: [PATCH] Add our services to meson

---
 meson.build               |  2 +-
 meson_options.txt         |  3 +++
 service_files/meson.build |  3 +++
 src/meson.build           | 56 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 1b355d5..ab04367 100644
--- a/meson.build
+++ b/meson.build
@@ -3,7 +3,7 @@ project(
     'cpp',
     default_options: [
         'warning_level=3',
-        'werror=true',
+        'werror=false',
         'cpp_std=c++20'
     ],
     license: 'Apache-2.0',
diff --git a/meson_options.txt b/meson_options.txt
index d6a8b96..29c07b3 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -12,3 +12,6 @@ option('external', type: 'feature', value: 'enabled', description: 'Enable Exter
 option('tests', type: 'feature', value: 'enabled', description: 'Build tests.',)
 option('validate-unsecure-feature', type : 'feature', value : 'disabled', description : 'Enables unsecure features required by validation. Note: mustbe turned off for production images.',)
 option('insecure-sensor-override', type : 'feature', value : 'disabled', description : 'Enables Sensor override feature without any check.',)
+option('nvmelegacy', type: 'feature', value: 'enabled', description: 'Enable NVMe legacy sensor.',)
+option('health', type: 'feature', value: 'enabled', description: 'BMC Health sensor',)
+option('sysfs', type: 'feature', value: 'enabled', description: 'Enable sysfs generic sensor.',)
diff --git a/service_files/meson.build b/service_files/meson.build
index 5f5b78c..85ded50 100644
--- a/service_files/meson.build
+++ b/service_files/meson.build
@@ -10,6 +10,9 @@ unit_files = [
     ['nvme', 'xyz.openbmc_project.nvmesensor.service'],
     ['psu', 'xyz.openbmc_project.psusensor.service'],
     ['external', 'xyz.openbmc_project.externalsensor.service'],
+    ['nvmelegacy', 'xyz.openbmc_project.nvmelegacysensor.service'],
+    ['health', 'xyz.openbmc_project.healthsensor.service'],
+    ['sysfs', 'xyz.openbmc_project.sysfssensor.service'],
 ]
 
 foreach tuple : unit_files
diff --git a/src/meson.build b/src/meson.build
index e420b27..d2f302f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -195,3 +195,59 @@ if get_option('external').enabled()
         install: true,
     )
 endif
+
+if get_option('nvmelegacy').enabled()
+    executable(
+        'nvmelegacysensor',
+        'NVMELegacySensor.cpp',
+        dependencies: [
+            i2c,
+            sdbusplus,
+    ],
+        implicit_include_directories: false,
+        include_directories: '../include',
+        install: true,
+        link_with: [
+            utils_a,
+            thresholds_a,
+        ],
+    )
+endif
+
+if get_option('health').enabled()
+    executable(
+        'healthsensor',
+        'HealthSensor.cpp',
+        dependencies: [
+            i2c,
+            sdbusplus,
+    ],
+        implicit_include_directories: false,
+        include_directories: '../include',
+        install: true,
+        link_with: [
+            utils_a,
+            thresholds_a,
+        ],
+    )
+endif
+
+if get_option('sysfs').enabled()
+    executable(
+        'sysfssensor',
+        'SysfsSensor.cpp',
+        'SysfsSensorMain.cpp',
+        dependencies: [
+            sdbusplus,
+            gpiodcxx,
+        ],
+        implicit_include_directories: false,
+        include_directories: '../include',
+        install: true,
+        link_with: [
+            pwmsensor_a,
+            thresholds_a,
+            utils_a,
+        ],
+    )
+endif
