diff --git a/include/HealthSensor.hpp b/include/HealthSensor.hpp
new file mode 100644
index 0000000..8942904
--- /dev/null
+++ b/include/HealthSensor.hpp
@@ -0,0 +1,46 @@
+#pragma once
+#include "sensor.hpp"
+
+#include <boost/asio/steady_timer.hpp>
+#include <boost/container/flat_map.hpp>
+
+#include <chrono>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+enum class SensorTypes
+{
+    cpu,
+    memory,
+    uptime
+};
+
+struct HealthSensor : public Sensor
+{
+    HealthSensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+                  boost::asio::io_service& io, const std::string& name,
+                  const std::string& sensorConfiguration,
+                  sdbusplus::asio::object_server& objectServer,
+                  std::vector<thresholds::Threshold>&& thresholds,
+                  const PowerState powerState, std::string &sensorTypeName,
+                  uint16_t pollTime, uint16_t failTime, bool isReboot,
+                  std::string &rebootCmd);
+    ~HealthSensor();
+
+    void checkThresholds(void) override;
+    void readSensor(void);
+    void init(void);
+
+    SensorTypes type;
+
+  private:
+    sdbusplus::asio::object_server& objectServer;
+    boost::asio::steady_timer waitTimer;
+    uint16_t failCount;
+    uint16_t pollTime;
+    uint16_t failTime;
+    bool isReboot;
+    std::string rebootCmd;
+};
diff --git a/service_files/xyz.openbmc_project.healthsensor.service b/service_files/xyz.openbmc_project.healthsensor.service
new file mode 100644
index 0000000..66ccbea
--- /dev/null
+++ b/service_files/xyz.openbmc_project.healthsensor.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=BMC health Sensor
+StopWhenUnneeded=false
+Requires=xyz.openbmc_project.EntityManager.service
+After=xyz.openbmc_project.EntityManager.service
+
+[Service]
+Restart=always
+RestartSec=5
+ExecStart=/usr/bin/healthsensor
+
+[Install]
+WantedBy=multi-user.target
diff --git a/src/HealthSensor.cpp b/src/HealthSensor.cpp
new file mode 100644
index 0000000..ed0a038
--- /dev/null
+++ b/src/HealthSensor.cpp
@@ -0,0 +1,447 @@
