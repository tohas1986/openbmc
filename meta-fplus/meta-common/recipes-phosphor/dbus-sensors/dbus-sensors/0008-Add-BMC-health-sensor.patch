+#include "HealthSensor.hpp"
+
+#include "Utils.hpp"
+#include "VariantVisitors.hpp"
+
+#include <math.h>
+
+#include <CLI/CLI.hpp>
+#include <boost/algorithm/string.hpp>
+#include <boost/algorithm/string/predicate.hpp>
+#include <boost/algorithm/string/replace.hpp>
+#include <boost/container/flat_map.hpp>
+#include <sdbusplus/asio/connection.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <sdbusplus/bus/match.hpp>
+
+#include <chrono>
+#include <functional>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <numeric>
+#include <string>
+#include <vector>
+
+extern "C"
+{
+#include <sys/sysinfo.h>
+}
+
+enum CPUStatesTime
+{
+    USER_IDX = 0,
+    NICE_IDX,
+    SYSTEM_IDX,
+    IDLE_IDX,
+    IOWAIT_IDX,
+    IRQ_IDX,
+    SOFTIRQ_IDX,
+    STEAL_IDX,
+    GUEST_USER_IDX,
+    GUEST_NICE_IDX,
+    NUM_CPU_STATES_TIME
+};
+
+bool DEBUG = false;
+
+
+constexpr const char* configInterface =
+    "xyz.openbmc_project.Configuration.HealthSensor";
+
+static constexpr double maxReading = 100;
+static constexpr double minReading = 0;
+
+boost::container::flat_map<std::string, std::unique_ptr<HealthSensor>> sensors;
+
+HealthSensor::HealthSensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+                             boost::asio::io_service& io,
+                             const std::string& sensorName,
+                             const std::string& sensorConfiguration,
+                             sdbusplus::asio::object_server& objectServer,
+                             std::vector<thresholds::Threshold>&& thresholdData,
+                             const PowerState powerState, std::string& sensorTypeName,
+                             uint16_t _pollTime, uint16_t _failTime, bool _isReboot,
+                             std::string& _rebootCmd) :
+    Sensor(boost::replace_all_copy(sensorName, " ", "_"),
+           std::move(thresholdData), sensorConfiguration,
+           "xyz.openbmc_project.Configuration.HealthSensor", false, false, maxReading, minReading,
+           conn, powerState),
+    objectServer(objectServer), waitTimer(io), failCount(0), pollTime(_pollTime),
+    failTime(_failTime), isReboot(_isReboot), rebootCmd(_rebootCmd)
+{
+    type = SensorTypes::cpu;
+    if (sensorTypeName == "Memory")
+        type = SensorTypes::memory;
+    else if (sensorTypeName == "CPU")
+        type = SensorTypes::cpu;
+    else if (sensorTypeName == "Uptime")
+        type = SensorTypes::uptime;
+
+    std::string objPath = "/xyz/openbmc_project/sensors/utilization/";
+    objPath += name;
+
+    if (DEBUG)
+        std::cerr <<  "type=" << sensorTypeName << " objPath:" << objPath << "\n";
+
+    sensorInterface = objectServer.add_interface(
+        objPath, "xyz.openbmc_project.Sensor.Value");
+
+    if (thresholds::hasWarningInterface(thresholds))
+    {
+        thresholdInterfaceWarning = objectServer.add_interface(
+            objPath, "xyz.openbmc_project.Sensor.Threshold.Warning");
+    }
+    if (thresholds::hasCriticalInterface(thresholds))
+    {
+        thresholdInterfaceCritical = objectServer.add_interface(
+            objPath, "xyz.openbmc_project.Sensor.Threshold.Critical");
+    }
+    association = objectServer.add_interface(
+        objPath, association::interface);
+}
+
+HealthSensor::~HealthSensor()
+{
+    waitTimer.cancel();
+    objectServer.remove_interface(thresholdInterfaceWarning);
+    objectServer.remove_interface(thresholdInterfaceCritical);
+    objectServer.remove_interface(sensorInterface);
+    objectServer.remove_interface(association);
+}
+
+void HealthSensor::init(void)
+{
+    setInitialProperties(sensor_paths::unitPercent);
+    readSensor();
+}
+
+void HealthSensor::checkThresholds(void)
+{
+    bool cross = thresholds::checkThresholds(this);
+    bool toReboot = false;
+    if (cross)
+    {
+        failCount = 0;
+    }
+    else
+    {
+        failCount ++;
+    }
+
+    if (isReboot && ( (failCount * pollTime) > failTime))
+    {
+       toReboot = true;
+    }
+
+    if (DEBUG)
+        std::cerr << this->name << " Threshold cross:" << cross
+                  << " failcount:" << failCount
+                  << " toReboot:" << toReboot
+                  << "\n";
+    if (toReboot)
+    {
+        system(rebootCmd.c_str());
+    }
+}
+
+double readUptime()
+{
+    struct sysinfo s_info;
+    sysinfo(&s_info);
+
+    double uptime = s_info.uptime / (60.0 * 60.0 * 24.0) ; /* Convert to days */
+
+    if (DEBUG)
+    {
+        std::cerr << "Uptime: " << uptime << " raw:" << s_info.uptime << "\n";
+    }
+
+    return uptime;
+}
+
+double readMemoryUtilization()
+{
+    struct sysinfo s_info;
+
+    sysinfo(&s_info);
+    double usedRam = s_info.totalram - s_info.freeram;
+    double memUsePerc = usedRam / s_info.totalram * 100;
+
+    if (DEBUG)
+    {
+        std::cerr << "Memory Utilization:" << memUsePerc
+                  << " TotalRam: " << s_info.totalram
+                  << " FreeRam: " << s_info.freeram
+                  << " UseRam: " << usedRam << "\n";
+    }
+
+    return memUsePerc;
+}
+
+double readCPUUtilization()
+{
+    std::ifstream fileStat("/proc/stat");
+    if (!fileStat.is_open())
+    {
+        std::cerr << "/proc/state file not available\n";
+        return -1;
+    }
+
+    std::string firstLine, labelName;
+    std::size_t timeData[NUM_CPU_STATES_TIME];
+
+    std::getline(fileStat, firstLine);
+    std::stringstream ss(firstLine);
+    ss >> labelName;
+
+    if (DEBUG)
+        std::cerr << "CPU stats first Line is " << firstLine << "\n";
+
+    if (labelName.compare("cpu"))
+    {
+        if (DEBUG) std::cerr << "CPU data not available\n";
+        return -1;
+    }
+
+    int i;
+    for (i = 0; i < NUM_CPU_STATES_TIME; i++)
+    {
+        if (!(ss >> timeData[i]))
+            break;
+    }
+
+    if (i != NUM_CPU_STATES_TIME)
+    {
+        if (DEBUG) std::cerr << "CPU data not correcti\n";
+        return -1;
+    }
+
+    static double preActiveTime = 0, preIdleTime = 0;
+    double activeTime, activeTimeDiff, idleTime, idleTimeDiff, totalTime,
+        activePercValue;
+
+    idleTime = timeData[IDLE_IDX] + timeData[IOWAIT_IDX];
+    activeTime = timeData[USER_IDX] + timeData[NICE_IDX] +
+                 timeData[SYSTEM_IDX] + timeData[IRQ_IDX] +
+                 timeData[SOFTIRQ_IDX] + timeData[STEAL_IDX] +
+                 timeData[GUEST_USER_IDX] + timeData[GUEST_NICE_IDX];
+
+    idleTimeDiff = idleTime - preIdleTime;
+    activeTimeDiff = activeTime - preActiveTime;
+
+    /* Store current idle and active time for next calculation */
+    preIdleTime = idleTime;
+    preActiveTime = activeTime;
+
+    totalTime = idleTimeDiff + activeTimeDiff;
+
+    activePercValue = activeTimeDiff / totalTime * 100;
+
+    if (DEBUG)
+        std::cerr << "CPU Utilization:" << activePercValue << "\n";
+
+    return activePercValue;
+}
+
+void HealthSensor::readSensor(void)
+{
+    waitTimer.expires_from_now(boost::asio::chrono::seconds(pollTime));
+    waitTimer.async_wait([this](const boost::system::error_code& ec) {
+        if (ec)
+        {
+            return;
+        }
+        double value;
+        int ret;
+
+        if (type == SensorTypes::cpu)
+        {
+            value = readCPUUtilization();
+        }
+        else if (type == SensorTypes::memory)
+        {
+            value = readMemoryUtilization();
+        }
+        else if (type == SensorTypes::uptime)
+        {
+            value = readUptime();
+        }
+
+        if (ret >= 0)
+        {
+            updateValue(value);
+        }
+        else
+        {
+            updateValue(std::numeric_limits<double>::quiet_NaN());
+        }
+        readSensor();
+    });
+}
+
+void createSensors(
+    boost::asio::io_service& io, sdbusplus::asio::object_server& objectServer,
+    boost::container::flat_map<std::string, std::unique_ptr<HealthSensor>>&
+        sensors,
+    std::shared_ptr<sdbusplus::asio::connection>& dbusConnection)
+{
+    if (!dbusConnection)
+    {
+        std::cerr << "Connection not created\n";
+        exit(0);
+    }
+
+    dbusConnection->async_method_call(
+        [&io, &objectServer, &dbusConnection, &sensors](
+            boost::system::error_code ec, const ManagedObjectType& resp) {
+            if (ec)
+            {
+                std::cerr << "Error contacting entity manager\n";
+                exit(0);
+            }
+            for (const auto& pathPair : resp)
+            {
+                for (const auto& entry : pathPair.second)
+                {
+                    if (entry.first != configInterface)
+                    {
+                        continue;
+                    }
+                    std::string name =
+                        loadVariant<std::string>(entry.second, "Name");
+
+                    std::vector<thresholds::Threshold> sensorThresholds;
+                    if (!parseThresholdsFromConfig(pathPair.second,
+                                                   sensorThresholds))
+                    {
+                        std::cerr << "error populating thresholds for " << name
+                                  << "\n";
+                    }
+
+                    std::string sensorClass =
+                        loadVariant<std::string>(entry.second, "Class");
+
+                    uint16_t failTime = 300;
+                    uint16_t pollTime = 30;
+                    bool isReboot = true;
+                    std::string rebootCmd = "/sbin/reboot";
+
+                    try
+                    {
+                        failTime = loadVariant<uint16_t>(entry.second, "FailTime");
+                    }
+                    catch (...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get FailTime, setting to default\n";
+                    }
+
+                    try
+                    {
+                        pollTime = loadVariant<uint16_t>(entry.second, "PollTime");
+                    }
+                    catch (...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get PollTime, setting to default\n";
+                    }
+
+                    try
+                    {
+                        isReboot = loadVariant<bool>(entry.second, "IsReboot");
+                    }
+                    catch (...)
+                    {
+                        if (DEBUG) std::cerr << "Unable to get IsReboot, setting to default\n";
+                    }
+
+                    if (DEBUG)
+                    {
+                        std::cerr
+                            << "Configuration parsed for \n\t" << entry.first
+                            << "\n"
+                            << "with\n"
+                            << "\tName: " << name << "\n"
+                            << "\tClass: " << sensorClass
+                            << "\tPollTime: " << pollTime
+                            << "\tFailTime: " << failTime
+                            << "\tIsReboot: " << isReboot
+                            << "\tRebootCmd: " << rebootCmd
+                            << "\n";
+                    }
+
+                    auto& sensor = sensors[name];
+                    PowerState powerState = PowerState::always;
+
+                    sensor = std::make_unique<HealthSensor>(
+                        dbusConnection, io, name, pathPair.first, objectServer,
+                        std::move(sensorThresholds),
+                        powerState, sensorClass, pollTime, failTime, isReboot, rebootCmd);
+
+                    sensor->init();
+                }
+            }
+        },
+        entityManagerName, "/xyz/openbmc_project/inventory",
+        "org.freedesktop.DBus.ObjectManager", "GetManagedObjects");
+}
+
+int main(int argc, char* argv[])
+{
+
+    CLI::App app("BMC health sensors poller");
+    app.add_option("-v,--verbose", DEBUG, "print debug output");
+    CLI11_PARSE(app, argc, argv);
+
+    boost::asio::io_service io;
+    auto systemBus = std::make_shared<sdbusplus::asio::connection>(io);
+    systemBus->request_name("xyz.openbmc_project.HealthSensor");
+    sdbusplus::asio::object_server objectServer(systemBus);
+
+    io.post([&]() { createSensors(io, objectServer, sensors, systemBus); });
+
+    boost::asio::steady_timer configTimer(io);
+
+    std::function<void(sdbusplus::message::message&)> eventHandler =
+        [&](sdbusplus::message::message&) {
+            configTimer.expires_from_now(boost::asio::chrono::seconds(1));
+            // create a timer because normally multiple properties change
+            configTimer.async_wait([&](const boost::system::error_code& ec) {
+                if (ec)
+                {
+                    return;
+                }
+                createSensors(io, objectServer, sensors, systemBus);
+                if (sensors.empty())
+                {
+                    std::cerr << "Configuration not detected\n";
+                }
+            });
+        };
+
+    sdbusplus::bus::match::match configMatch(
+        static_cast<sdbusplus::bus::bus&>(*systemBus),
+        "type='signal',member='PropertiesChanged',"
+        "path_namespace='" +
+            std::string(inventoryPath) +
+            "',"
+            "arg0namespace='" +
+            configInterface + "'",
+        eventHandler);
+
+    io.run();
+}
