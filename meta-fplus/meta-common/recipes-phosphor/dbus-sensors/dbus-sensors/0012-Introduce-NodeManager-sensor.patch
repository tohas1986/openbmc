+#pragma once
+#include "sensor.hpp"
+
+#include <boost/asio/steady_timer.hpp>
+#include <boost/container/flat_map.hpp>
+
+#include <chrono>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+enum class IpmbType
+{
+    DIMMSensor,
+    dtsTemp,
+    cpuTemp,
+    cpuTjMax
+};
+
+enum class IpmbSubType
+{
+    temp,
+    curr,
+    power,
+    volt,
+    util
+};
+
+enum class ReadingFormat
+{
+    medimmsensor,
+    cpu,
+    dts,
+    tjmax
+};
+
+struct NMSensor : public Sensor
+{
+    NMSensor(std::shared_ptr<sdbusplus::asio::connection>& conn,
+               boost::asio::io_service& io, const std::string& name,
+               const std::string& sensorConfiguration,
+               sdbusplus::asio::object_server& objectServer,
+               std::vector<thresholds::Threshold>&& thresholds,
+               uint8_t& deviceAddress,  uint8_t& deviceCPUID, uint8_t& deviceChannelID,
+               uint8_t& deviceDIMMID, std::string& deviceTypeName,
+               std::string& sensorTypeName);
+    ~NMSensor() override;
+
+    void checkThresholds(void) override;
+    void read(void);
+    void init(void);
+    std::string getSubTypeUnits(void);
+    void loadDefaults(void);
+    bool processReading(const std::vector<uint8_t>& data, double& resp);
+
+    IpmbType type;
+    IpmbSubType subType;
+    double scaleVal;
+    double offsetVal;
+    uint8_t deviceCPUID = 0;
+    uint8_t deviceChannelID = 0;
+    uint8_t deviceDIMMID = 0;
+    std::string deviceTypeName;
+
+    uint8_t netfn;
+    uint8_t command;
+    uint8_t deviceAddress;
+    uint8_t errorCount;
+    std::vector<uint8_t> commandData;
+
+    uint8_t pollTime = 1;
+
+    ReadingFormat readingFormat;
+
+  private:
+    sdbusplus::asio::object_server& objectServer;
+    boost::asio::steady_timer waitTimer;
+};
