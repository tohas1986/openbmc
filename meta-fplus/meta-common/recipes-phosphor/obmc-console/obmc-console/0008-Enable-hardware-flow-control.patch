From 72364922a460da53addf8aee3e19916240a1b5ab Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Wed, 17 Mar 2021 06:41:00 +0000
Subject: [PATCH 1/1] Enable hardware flow control

---
 console-client.c | 5 ++++-
 console-server.c | 1 +
 tty-handler.c    | 3 +++
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/console-client.c b/console-client.c
index 1f85176..c6319d6 100644
--- a/console-client.c
+++ b/console-client.c
@@ -198,6 +198,7 @@ static int client_tty_init(struct console_client *client)
 	memcpy(&client->orig_termios, &termios, sizeof(client->orig_termios));
 	cfmakeraw(&termios);
 
+	termios.c_cflag |= CRTSCTS;
 	rc = tcsetattr(client->fd_in, TCSANOW, &termios);
 	if (rc) {
 		warn("Can't set terminal attributes for console");
@@ -245,8 +246,10 @@ cleanup:
 
 static void client_fini(struct console_client *client)
 {
-	if (client->is_tty)
+	if (client->is_tty) {
+		client->orig_termios.c_cflag |= CRTSCTS;
 		tcsetattr(client->fd_in, TCSANOW, &client->orig_termios);
+	}
 	close(client->console_sd);
 }
 
diff --git a/console-server.c b/console-server.c
index ec01fc1..e4a63af 100644
--- a/console-server.c
+++ b/console-server.c
@@ -224,6 +224,7 @@ static void tty_init_termios(struct console *console)
 	 */
 	cfmakeraw(&termios);
 
+	termios.c_cflag |= CRTSCTS;
 	rc = tcsetattr(console->tty_fd, TCSANOW, &termios);
 	if (rc)
 		warn("Can't set terminal options for %s", console->tty_kname);
diff --git a/tty-handler.c b/tty-handler.c
index 3546aca..c871d5d 100644
--- a/tty-handler.c
+++ b/tty-handler.c
@@ -215,6 +215,9 @@ static int make_terminal_raw(struct tty_handler *th, const char *tty_name) {
 	 * generating characters. */
 	cfmakeraw(&term_options);
 
+	/* Disable hardware flow control */
+	term_options.c_cflag |= CRTSCTS;
+
 	if (tcsetattr(th->fd, TCSAFLUSH, &term_options) < 0) {
 		warn("Couldn't commit terminal options for %s", tty_name);
 		return -1;
-- 
2.7.4

