From 3ab87bdd91cce9140afadf0e0654c896d2d1e5eb Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Fri, 30 Sep 2022 10:51:50 +0000
Subject: [PATCH] Enable nbdproxy

---
 include/vm_websocket.hpp |  2 +-
 meson.build              |  2 +-
 meson_options.txt        | 10 +++++-----
 src/webserver_main.cpp   |  2 +-
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/include/vm_websocket.hpp b/include/vm_websocket.hpp
index ebf0a698..e0f4e3dc 100644
--- a/include/vm_websocket.hpp
+++ b/include/vm_websocket.hpp
@@ -52,7 +52,7 @@ class Handler : public std::enable_shared_from_this<Handler>
     void connect()
     {
         std::error_code ec;
-        proxy = boost::process::child("/usr/sbin/nbd-proxy", media,
+        proxy = boost::process::child("/usr/sbin/nbd-proxy", "--config", media,
                                       boost::process::std_out > pipeOut,
                                       boost::process::std_in < pipeIn, ec);
         if (ec)
diff --git a/meson.build b/meson.build
index 4c03ef96..001e3a68 100644
--- a/meson.build
+++ b/meson.build
@@ -89,7 +89,7 @@ feature_map = {
   'static-hosting'                              : '-DBMCWEB_ENABLE_STATIC_HOSTING',
   'vm-websocket'                                : '-DBMCWEB_ENABLE_VM_WEBSOCKET',
   'xtoken-auth'                                 : '-DBMCWEB_ENABLE_XTOKEN_AUTHENTICATION',
-  #'vm-nbdproxy'                                : '-DBMCWEB_ENABLE_VM_NBDPROXY',
+  'vm-nbdproxy'                                 : '-DBMCWEB_ENABLE_VM_NBDPROXY',
 }
 
 # Get the options status and build a project summary to show which flags are
diff --git a/meson_options.txt b/meson_options.txt
index ecc7aebc..c12d3e6c 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -35,11 +35,11 @@ option(
 # this interface, so for the moment this appears to be dead code;  In leiu of
 # removing it, it has been disabled to try to give those that use it the
 # opportunity to upstream their backend implementation
-#option(
-#    'vm-nbdproxy',
-#    type: 'feature', value: 'disabled',
-#    description: 'Enable the Virtual Media WebSocket.'
-#)
+option(
+    'vm-nbdproxy',
+    type: 'feature', value: 'enabled',
+    description: 'Enable the Virtual Media WebSocket.'
+)
 
 option(
     'rest',
diff --git a/src/webserver_main.cpp b/src/webserver_main.cpp
index 05c10cc0..3e8535d0 100644
--- a/src/webserver_main.cpp
+++ b/src/webserver_main.cpp
@@ -127,7 +127,7 @@ static int run()
 
     setupSocket(app);
 
-#ifdef BMCWEB_ENABLE_VM_NBDPROXY
+#ifdef BMCWEB_ENABLE_VM_NBDPROXY_PROXY
     crow::nbd_proxy::requestRoutes(app);
 #endif
 
