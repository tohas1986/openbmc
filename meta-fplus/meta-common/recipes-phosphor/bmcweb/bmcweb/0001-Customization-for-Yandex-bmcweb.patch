diff --git a/include/image_upload.hpp b/include/image_upload.hpp
index 4defbb66..88c027f1 100644
--- a/include/image_upload.hpp
+++ b/include/image_upload.hpp
@@ -10,6 +10,7 @@
 #include <cstdio>
 #include <fstream>
 #include <memory>
+#include <filesystem>
 
 namespace crow
 {
@@ -90,6 +91,18 @@ inline void
         "member='InterfacesAdded',path='/xyz/openbmc_project/software'",
         callback);
 
+    namespace fs = std::filesystem;
+
+    fs::path imgDir("/tmp/images");
+
+    if(fs::exists(imgDir))
+    {
+        for (auto& path: fs::directory_iterator(imgDir))
+        {
+            fs::remove_all(path);
+        }
+    }
+
     std::string filepath(
         "/tmp/images/" +
         boost::uuids::to_string(boost::uuids::random_generator()()));
