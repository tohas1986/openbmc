--- /dev/null
+++ b/redfish-core/lib/st.hpp
@@ -0,0 +1,138 @@
+/*
+ *  redfish-core/lib/st.hpp
+ *
+ *  Created on: Mar 18, 2022
+ *  Author: Stanislav Khromyshev
+ *
+ */
+
+#pragma once
+
+#include <utils/sw_utils.hpp>
+#include <iostream>
+#include <fstream>
+#include <string>
+#include <boost/lexical_cast.hpp>
+#include <sdbusplus/asio/property.hpp>
+#include <sdbusplus/bus.hpp>
+
+namespace redfish
+{
+
+std::string chassisId;
+
+inline int getStResults(const std::shared_ptr<bmcweb::AsyncResp>& aResp)
+{
+    boost::algorithm::to_lower(chassisId);
+    std::string path = "/usr/share/bmc-self-test/bmc-self-test_";
+    std::string exp = ".json";
+    std::string file = path + chassisId + exp;
+    std::ifstream input(file, std::ifstream::binary);
+    nlohmann::json j;
+
+    aResp->res.jsonValue["Description"] = { "This service provide SelfTest result."};
+
+    std::cerr << "Looking for ST json file..." << "\n";
+
+    if(!fileExist(file))
+    {
+        std::cerr << "File not found!" << "\n";
+        input.close();
+        return -1;
+    }
+
+    if(isEmpty(input))
+    {
+        std::cerr << "File Empty, no ST results found!" << "\n";
+        input.close();
+        return -1;
+    }
+
+    try
+    {
+	if(!(nlohmann::json::accept(input)))
+        {
+            std::cerr << "Invalid JSON file!" << "\n";
+            input.close();
+            return -1;
+        }
+        else
+        {
+            input.clear();
+            input.seekg(0);
+            input >> j;
+        }
+    }
+    catch(nlohmann::json::exception &e)
+    {
+	std::cerr << "Error in JSON object caught!" << "\n";
+        return -1;
+    }
+
+    aResp->res.jsonValue["Result"] = { j };
+
+    input.close();
+    return 0;
+}
+
+inline void requestRoutesSTService(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Chassis/<str>/STService/")
+        .privileges(redfish::privileges::getSt)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& param) {
+                BMCWEB_LOG_DEBUG << "Get ST method called";
+
+                if (param.empty())
+                {
+                    return;
+                }
+
+                chassisId = param;
+
+                asyncResp->res.jsonValue = {
+                    {"@odata.type",
+                     "#STService.v1_0_0.STService"},
+                    {"Name", "ST Subsystem for Chassis"},
+                    {"Id", "STService"}};
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/STService";
+		asyncResp->res.jsonValue["Start Service"]["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/STService/start";
+
+		int res = getStResults(asyncResp);
+
+		if ( res < 0 )
+		{
+		    asyncResp->res.jsonValue["Error"] = "File not found, or emprty, or no valide JSON. For detailed information, please, read journalctl -f";
+                    return;
+		}
+            });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Chassis/<str>/STService/start")
+        .privileges(redfish::privileges::getSt)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& param) {
+                BMCWEB_LOG_DEBUG << "Start self test server";
+
+		using namespace sdbusplus;
+                auto b = bus::new_default_system();
+    		auto m = b.new_method_call("org.freedesktop.systemd1", "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager", "StartUnit");
+		m.append("bmc-self-test.service");
+		m.append("replace");
+		try
+		{
+		    b.call_noreply(m);
+		}
+		catch (const sdbusplus::exception::exception& e)
+		{
+		    std::cerr << "Error start systemd service!" << "\n";
+		    return;
+		}
+            });
+}
+}
