diff --git a/redfish-core/lib/nvidia-post-box.hpp b/redfish-core/lib/nvidia-post-box.hpp
new file mode 100644
index 00000000..ee61b52d
--- /dev/null
+++ b/redfish-core/lib/nvidia-post-box.hpp
@@ -0,0 +1,121 @@
+/*
+ *  redfish-core/lib/rmt.hpp
+ *
+ *  Created on: Jan 12, 2022
+ *  Author: Nikita Vedeneev
+ *
+ */
+
+#pragma once
+
+#include <utils/sw_utils.hpp>
+#include <iostream>
+#include <fstream>
+#include <sdbusplus/bus.hpp>
+
+#define SYSTEMD_BUSNAME "org.freedesktop.systemd1"
+#define SYSTEMD_PATH "/org/freedesktop/systemd1"
+#define SYSTEMD_INTERFACE "org.freedesktop.systemd1.Manager"
+
+namespace redfish
+{
+
+/*
+ * RmtService class supports handle get method for rmt.
+ */
+inline void startNbpService()
+{
+    auto bus = sdbusplus::bus::new_default();
+
+    std::string serviceFile = "nvidia-smbus-post-box.service";
+
+    auto method = bus.new_method_call(SYSTEMD_BUSNAME, SYSTEMD_PATH,
+                                      SYSTEMD_INTERFACE, "StartUnit");
+    method.append(serviceFile, "replace");
+    bus.call_noreply(method);
+}
+
+inline void getNpbResults(const std::shared_ptr<bmcweb::AsyncResp>& aResp)
+{
+    startNbpService();
+
+    std::string path = "/var/log/jbog-info.json";
+
+    if(!fileExist(path))
+    {
+        std::cerr << "File not found!" << "\n";
+        return;
+    }
+
+    std::ifstream input(path);
+    nlohmann::json j;
+
+    if(isEmpty(input))
+    {
+        std::cerr << "File Empty, no Nvidia Post Box results found!" << "\n";
+        input.close();
+        return;
+    }
+
+    try
+    {
+        if(!(nlohmann::json::accept(input)))
+        {
+            std::cerr << "Invalid JSON file!" << "\n";
+            input.close();
+            return;
+        }
+        else
+        {
+            input.clear();
+            input.seekg(0);
+            input >> j;
+        }
+    }
+    catch(nlohmann::json::exception &e)
+    {
+        std::cerr << "Error in JSON object caught!" << "\n";
+        input.close();
+        return;
+    }
+
+    for (auto& el : j.items())
+    {
+        aResp->res.jsonValue[el.key()] = el.value();
+    }
+
+    input.close();
+}
+
+inline void requestRoutesNPBService(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Chassis/<str>/NpbService/")
+        .privileges(redfish::privileges::getNpb)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& param) {
+                BMCWEB_LOG_DEBUG << "Get NPB method called";
+
+                if (param.empty())
+                {
+                    return;
+                }
+
+                const std::string& chassisId = param;
+
+                asyncResp->res.jsonValue = {
+                    {"@odata.type",
+                     "#NpbService.v1_0_0.NpbService"},
+                    {"Name", "NPB Subsystem for Chassis"},
+                    {"Id", "NpbService"}};
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/NpbService";
+
+                asyncResp->res.jsonValue["Status"] = {{"State", "Enabled"},
+                                                      {"Health", "OK"}};
+
+                getNpbResults(asyncResp);
+            });
+}
+}
