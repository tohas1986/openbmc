+    auto str = oss.str();
+
+    return str;
+}
+
 inline nlohmann::json taskAborted(const std::string& arg1)
 {
     return nlohmann::json{
@@ -28,6 +44,7 @@ inline nlohmann::json taskAborted(const std::string& arg1)
         {"Message", "The task with id " + arg1 + " has been aborted."},
         {"MessageArgs", {arg1}},
