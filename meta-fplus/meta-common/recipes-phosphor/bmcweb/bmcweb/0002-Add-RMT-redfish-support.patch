index 00000000..0fb3d9f8
--- /dev/null
+++ b/redfish-core/lib/rmt.hpp
@@ -0,0 +1,117 @@
+/*
+ *  redfish-core/lib/rmt.hpp
+ *
+ *  Created on: Jan 12, 2022
+ *  Author: Nikita Vedeneev
+ *
+ */
+
+#pragma once
+
+#include <utils/sw_utils.hpp>
+#include <iostream>
+#include <fstream>
+
+namespace redfish
+{
+
+/*
+ * RmtService class supports handle get method for rmt.
+ */
+
+inline bool fileExist(const std::string& name)
+{
+    std::ifstream f(name.c_str());
+    return f.good();
+}
+
+inline bool isEmpty(std::ifstream& pFile)
+{
+    return pFile.peek() == std::ifstream::traits_type::eof();
+}
+
+inline void getRmtResults(const std::shared_ptr<bmcweb::AsyncResp>& aResp)
+{
+    std::string path = "/var/log/rmt.json";
+
+    aResp->res.jsonValue["Help"] = {{"Node", "0-1"}, {"Channel", "0-5"}, {"DIMM","0,1"}, {"Rank","0-3"}};
+    std::cerr << "Looking for RMT json file..." << "\n";
+
+    if(!fileExist(path))
+    {
+        std::cerr << "File not found!" << "\n";
+        return;
+    }
+
+    std::ifstream input(path);
+    nlohmann::json j;
+
+    if(isEmpty(input))
+    {
+        std::cerr << "File Empty, no RMT results found!" << "\n";
+        input.close();
+        return;
+    }
+
+    try
+    {
+        if(!(nlohmann::json::accept(input)))
+        {
+            std::cerr << "Invalid JSON file!" << "\n";
+            input.close();
+            return;
+        }
+        else
+        {
+            input.clear();
+            input.seekg(0);
+            input >> j;
+        }
+    }
+    catch(nlohmann::json::exception &e)
+    {
+        std::cerr << "Error in JSON object caught!" << "\n";
+        input.close();
+        return;
+    }
+
+    for (auto& el : j.items())
+    {
+        aResp->res.jsonValue[el.key()] = el.value();
+    }
+
+    input.close();
+}
+
+inline void requestRoutesRmtService(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Chassis/<str>/RmtService/")
+        .privileges(redfish::privileges::getRmt)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& param) {
+                BMCWEB_LOG_DEBUG << "Get RMT method called";
+
+                if (param.empty())
+                {
+                    return;
+                }
+
+                const std::string& chassisId = param;
+
+                asyncResp->res.jsonValue = {
+                    {"@odata.type",
+                     "#RmtService.v1_0_0.RmtService"},
+                    {"Name", "RMT Subsystem for Chassis"},
+                    {"Id", "RmtService"}};
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/RmtService";
+
+                asyncResp->res.jsonValue["Status"] = {{"State", "Enabled"},
+                                                      {"Health", "OK"}};
+
+                getRmtResults(asyncResp);
+            });
+}
+}
