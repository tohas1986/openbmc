index 00000000..f4a1a44c
--- /dev/null
+++ b/redfish-core/lib/bw.hpp
@@ -0,0 +1,108 @@
+/*
+ *  redfish-core/lib/bw.hpp
+ *
+ *  Created on: Jan 12, 2022
+ *  Author: Nikita Vedeneev
+ *
+ */
+
+#pragma once
+
+#include <utils/sw_utils.hpp>
+#include <iostream>
+#include <fstream>
+#include <string>
+#include <boost/lexical_cast.hpp>
+
+namespace redfish
+{
+
+/*
+ * BandWidth class supports handle get method for DRAM.
+ */
+
+inline void getBwResults(const std::shared_ptr<bmcweb::AsyncResp>& aResp)
+{
+    std::string path = "/var/lib/ipmi/bw.txt";
+    std::string line;
+    std::vector<std::string> temp;
+    std::ifstream input(path);
+    nlohmann::json j;
+
+    aResp->res.jsonValue["Description"] = { "This service provide Memory BandWidth results for DRAM validation purpose."};
+    aResp->res.jsonValue["BandWidth"] = { "Mb/s"};
+
+    std::cerr << "Looking for BW txt file..." << "\n";
+
+    if(!fileExist(path))
+    {
+        std::cerr << "File not found!" << "\n";
+        input.close();
+        return;
+    }
+
+    if(isEmpty(input))
+    {
+        std::cerr << "File Empty, no BW results found!" << "\n";
+        input.close();
+        return;
+    }
+
+    input.clear();
+    input.seekg(0);
+
+    while (getline(input, line))
+    {
+        temp.push_back(line);
+    }
+
+    input.close();
+
+    for (int i = 0; i < temp.size(); i++)
+    {
+        std::string str_key = boost::lexical_cast<std::string>(i);
+        std::string str_value = boost::lexical_cast<std::string>(temp[i]) + " MB/s";
+        try
+        {
+            aResp->res.jsonValue[str_key] = str_value;
+        }
+        catch(nlohmann::json::exception &e)
+        {
+            std::cerr << "Error in JSON object caught!" << "\n";
+            return;
+        }
+    }
+}
+
+inline void requestRoutesBWService(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Chassis/<str>/BWService/")
+        .privileges(redfish::privileges::getBw)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& param) {
+                BMCWEB_LOG_DEBUG << "Get BW method called";
+
+                if (param.empty())
+                {
+                    return;
+                }
+
+                const std::string& chassisId = param;
+
+                asyncResp->res.jsonValue = {
+                    {"@odata.type",
+                     "#BWService.v1_0_0.BWService"},
+                    {"Name", "BW Subsystem for Chassis"},
+                    {"Id", "BWService"}};
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/BWService";
+
+                asyncResp->res.jsonValue["Status"] = {{"State", "Enabled"},
+                                                      {"Health", "OK"}};
+
+                getBwResults(asyncResp);
+            });
+}
+}
