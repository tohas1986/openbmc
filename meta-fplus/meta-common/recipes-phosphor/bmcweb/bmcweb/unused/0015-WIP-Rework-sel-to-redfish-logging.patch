+    { 0x07, 0xa5, 0xff, "Processor Error Last Boot" },
     /* Power Supply */
     { 0x08, 0x00, 0xff, "Presence detected" },
     { 0x08, 0x01, 0xff, "Failure detected" },
@@ -228,6 +232,11 @@ static const struct ipmiEventSensorTypes sensorSpecificEventTypes[] = {
