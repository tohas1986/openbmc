Subject: [PATCH] [WIP Rework sel to redfish logging

---
 redfish-core/include/logutils.hpp | 57 ++++++++++++++++++++++++++-----
 1 file changed, 48 insertions(+), 9 deletions(-)

diff --git a/redfish-core/include/logutils.hpp b/redfish-core/include/logutils.hpp
index 34a6686..96f3204 100644
--- a/redfish-core/include/logutils.hpp
+++ b/redfish-core/include/logutils.hpp
@@ -8,6 +8,7 @@
 #include <sstream>
 #include <string>
 #include <array>
+#include <iostream>
 
 #pragma once
 
@@ -193,6 +194,9 @@ static const struct ipmiEventSensorTypes sensorSpecificEventTypes[] = {
     { 0x07, 0x0a, 0xff, "Throttled" },
     { 0x07, 0x0b, 0xff, "Uncorrectable machine check exception" },
     { 0x07, 0x0c, 0xff, "Correctable machine check error" },
