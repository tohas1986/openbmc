diff --git a/redfish-core/lib/rmt.hpp b/redfish-core/lib/rmt.hpp
new file mode 100644
index 0000000..351f74c
--- /dev/null
+++ b/redfish-core/lib/rmt.hpp
@@ -0,0 +1,82 @@
+#pragma once
+
+#include "node.hpp"
+#include <utils/chassis_utils.hpp>
+#include <utils/fw_utils.hpp>
+#include <iostream>
+#include <fstream>
+
+namespace redfish
+{
+/**
+ * RmtService class supports handle get method for rmt.
+ */
+inline void getRmtResults(const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    std::ifstream input("/var/log/rmt.json");
+    std::string line;
+    nlohmann::json j;
+    input >> j;
+    
+    asyncResp->res.jsonValue["Help"] = {{"Node", "0-1"}, {"Channel", "0-5"}, {"DIMM","0,1"}, {"Rank","0-3"}};
+    
+    asyncResp->res.jsonValue["N0.C0.D0.R0"] = j["N0.C0.D0.R0"];
+}
+
+class RmtService : public Node
+{
+  public:
+    /*
+     * Default Constructor
+     */
+    RmtService(App& app) :
+        Node(app, "/redfish/v1/Chassis/<str>/RmtService/", std::string())
+    {
+        entityPrivileges = {
+            {boost::beast::http::verb::get, {{"Login"}}},
+            {boost::beast::http::verb::head, {{"Login"}}},
+            {boost::beast::http::verb::patch, {{"ConfigureComponents"}}},
+            {boost::beast::http::verb::put, {{"ConfigureComponents"}}},
+            {boost::beast::http::verb::delete_, {{"ConfigureComponents"}}},
+            {boost::beast::http::verb::post, {{"ConfigureComponents"}}}};
+    }
+ private:
+    void doGet(const std::shared_ptr<bmcweb::AsyncResp>& asyncResp, 
+               const crow::Request&, 
+               const std::vector<std::string>& params) override
+    {
+        if (params.size() != 1)
+        {
+            messages::internalError(asyncResp->res);
+            return;
+        }
+        const std::string& chassisId = params[0];
+
+        auto getChassisPath =
+            [asyncResp,
+             chassisId](const std::optional<std::string>& chassisPath) {
+                if (!chassisPath)
+                {
+                    BMCWEB_LOG_ERROR << "Not a valid chassis ID" << chassisId;
+                    messages::resourceNotFound(asyncResp->res, "Chassis",
+                                               chassisId);
+                    return;
+                }
+                asyncResp->res.jsonValue = {
+                    {"@odata.type",
+                     "#RmtService.v1_0_0.RmtService"},
+                    {"Name", "RMT Subsystem for Chassis"},
+                    {"Id", "RmtService"}};
+                asyncResp->res.jsonValue["@odata.id"] =
+                    "/redfish/v1/Chassis/" + chassisId + "/RmtService";
+
+                asyncResp->res.jsonValue["Status"] = {{"State", "Enabled"},
+                                                      {"Health", "OK"}};
+
+                getRmtResults(asyncResp);
+            };
+        redfish::chassis_utils::getValidChassisID(asyncResp, chassisId,
+                                                  std::move(getChassisPath));
+    }
+};
+} // namespace redfish
