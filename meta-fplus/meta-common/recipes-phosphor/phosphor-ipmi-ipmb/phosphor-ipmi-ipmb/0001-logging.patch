+    std::cerr << "ipmbChannelInit: trying to open device: " << ipmbI2cSlave << std::endl;
     bool hasSysfs = std::filesystem::exists(ipmbI2cSlave);
     if (!hasSysfs)
     {
@@ -691,6 +714,8 @@ ipmbChannelType IpmbChannel::getChannelType()
 
 void IpmbChannel::addFilter(const uint8_t respNetFn, const uint8_t cmd)
 {
+    std::cerr << "addFilter: netfn=0x" << std::hex << std::setfill('0') << std::setw(2) << +respNetFn;
+    std::cerr << " cmd=0x" << std::hex << std::setfill('0') << std::setw(2) << +cmd << std::endl;
     if (commandFilter)
     {
         commandFilter->addFilter(respNetFn, cmd);
