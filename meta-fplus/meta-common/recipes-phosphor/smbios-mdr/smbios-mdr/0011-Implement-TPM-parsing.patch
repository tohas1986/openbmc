+#pragma once
+#include <iostream>
+
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Inventory/Item/Tpm/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+class TPM:
+    sdbusplus::server::object::object<
+        sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm>
+{
+  public:
+    TPM() = delete;
+    ~TPM() = default;
+    TPM(const TPM&) = delete;
+    TPM& operator=(const TPM&) = delete;
+    TPM(TPM&&) = default;
+    TPM& operator=(TPM&&) = default;
+
+    TPM(sdbusplus::bus::bus& bus, const std::string& objPath, uint8_t index, uint8_t* smbiosTableStorage) :
+        sdbusplus::server::object::object<sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm>(
+            bus, objPath.c_str()),
+        storage(smbiosTableStorage), index(index)
+    {
+        tpmInfoUpdate();
+    }
+
+    void tpmInfoUpdate();
+
+    bool        tpmIsPresent(bool value);
+    std::string tpmSpecificationVersion(std::string value);
+    std::string tpmFirmwareVersion(std::string value);
+    std::string tpmVendorName(std::string value);
+    std::string tpmVendorId(std::string value);
+
+  private:
+    uint8_t  index;
+    uint8_t* storage;
+
+    struct TPMInfo
+    {
+        uint8_t type;
+        uint8_t length;
+        uint16_t handle;
+
+        char     vendorID[4];
+        uint8_t  specMajor;
+        uint8_t  specMinor;
+        uint8_t  fwVer1[4];
+        uint32_t fwVer2;
+        uint8_t  strDescription;
+        uint64_t chars;
+        uint16_t oem;
+    } __attribute__((packed));
+};
+
+} // namespace smbios
+
+} // namespace phosphor
diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index 69bb57e..a474c32 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -507,6 +507,20 @@ void MDR_V2::systemInfoUpdate()
         drives.emplace_back(std::make_unique<phosphor::smbios::Drive>(
             bus, path, index, smbiosDir.dir[smbiosDirIndex].dataStorage));
     }
+
+    tpms.clear();
+    num = getRecordsNumByType(tpmType);
+    if (num == -1)
+    {
+        std::cerr << __FUNCTION__ << " get TPM record failed\n";
+    }
+
+    for (int index = 0; index < num; index++)
+    {
+        std::string path = tpmPath + std::to_string(index);
+        tpms.emplace_back(std::make_unique<phosphor::smbios::TPM>(
+            bus, path, index, smbiosDir.dir[smbiosDirIndex].dataStorage));
+    }
 }
 
 int MDR_V2::getTotalCpuSlot()
