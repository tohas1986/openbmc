+#include "tpm.hpp"
+
+#include <map>
+#include <sstream>
+#include <iostream>
+#include <iomanip>
+
+extern bool DEBUG;
+
+namespace phosphor
+{
+namespace smbios
+{
+
+bool TPM::tpmIsPresent(bool value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm::isPresent(value);
+}
+
+std::string TPM::tpmSpecificationVersion(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm::specificationVersion(value);
+}
+
+std::string TPM::tpmFirmwareVersion(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm::firmwareVersion(value);
+}
+
+std::string TPM::tpmVendorName(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm::vendorName(value);
+}
+
+std::string TPM::tpmVendorId(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Tpm::vendorId(value);
+}
+
+void TPM::tpmInfoUpdate()
+{
+    uint8_t* dataIn = storage;
+
+    dataIn = getSMBIOSTypePtr(dataIn, tpmType);
+    if (dataIn == nullptr)
+    {
+        return;
+    }
+
+    auto tpmInfo = reinterpret_cast<struct TPMInfo*>(dataIn);
+
+    std::string Description = positionToString(tpmInfo->strDescription, tpmInfo->length, dataIn);
+    std::string vendorId(tpmInfo->vendorID);
+
+    std::stringstream ssSpecification;
+    ssSpecification << +tpmInfo->specMajor << "." << +tpmInfo->specMinor;
+
+    std::stringstream ssFirmwareVersion;
+    if (tpmInfo->specMajor == 0x01)
+    {
+       ssFirmwareVersion << +tpmInfo->fwVer1[2] << "." << +tpmInfo->fwVer1[3];
+    }
+
+    if (tpmInfo->specMajor == 0x02)
+    {
+        uint16_t major = tpmInfo->fwVer1[2] + (tpmInfo->fwVer1[3] << 8) ;
+        uint16_t minor = tpmInfo->fwVer1[0] + (tpmInfo->fwVer1[1] << 8) ;
+        ssFirmwareVersion << +major << "." << +minor;
+    }
+
+    tpmIsPresent(true);
+    tpmSpecificationVersion(ssSpecification.str());
+    tpmFirmwareVersion(ssFirmwareVersion.str());
+    tpmVendorName(Description);
+    tpmVendorId(vendorId);
+
+    if (DEBUG)
+    {
+        std::stringstream ss;
+        for (uint8_t i = 0; i<32; i++)
+        {
+            ss << std::hex << std::setfill('0') << std::setw(2) << +(*(dataIn + i)) << " ";
+        }
+
+        std::cerr << __FUNCTION__ << " HEX dump:0x" << ss.str() << "\n";
+        std::cerr << __FUNCTION__ << " Description:" << Description << "\n";
+        std::cerr << __FUNCTION__ << " VendorID:" << vendorId << "\n";
+        std::cerr << __FUNCTION__ << " Specification:" << ssSpecification.str() << "\n";
+        std::cerr << __FUNCTION__ << " firmwareVersion:" << ssFirmwareVersion.str() << "\n";
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
