From 64a8786234f11a1ca7ab19f5774491a24956e0c6 Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 1 Feb 2022 08:06:06 +0000
Subject: [PATCH] Change logging to stderr

---
 src/mdrv2.cpp | 87 +++++++++++++++++++++++----------------------------
 1 file changed, 40 insertions(+), 47 deletions(-)

diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index ba8033a..681b32e 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -25,6 +25,7 @@
 #include <xyz/openbmc_project/Smbios/MDR_V2/error.hpp>
 
 #include <fstream>
+#include <iostream>
 
 namespace phosphor
 {
@@ -38,8 +39,8 @@ std::vector<uint8_t> MDR_V2::getDirectoryInformation(uint8_t dirIndex)
     std::ifstream smbiosFile(mdrType2File, std::ios_base::binary);
     if (!smbiosFile.good())
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Read data from flash error - Open MDRV2 table file failure");
+        std::cerr << __FUNCTION__ <<
+            " Read data from flash error - Open MDRV2 table file failure\n";
         throw sdbusplus::xyz::openbmc_project::Smbios::MDR_V2::Error::
             InvalidParameter();
     }
@@ -126,8 +127,7 @@ std::vector<uint8_t> MDR_V2::getDataOffer()
     }
     else
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "smbios is not ready for update");
+        std::cerr << __FUNCTION__ << " smbios is not ready for update\n";
         throw sdbusplus::xyz::openbmc_project::Smbios::MDR_V2::Error::
             UpdateInProgress();
     }
@@ -206,21 +206,21 @@ bool MDR_V2::readDataFromFlash(MDRSMBIOSHeader* mdrHdr, uint8_t* data)
 {
     if (mdrHdr == nullptr)
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Read data from flash error - Invalid mdr header");
+        std::cerr << __FUNCTION__ <<
+            " Read data from flash error - Invalid mdr header\n";
         return false;
     }
     if (data == nullptr)
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Read data from flash error - Invalid data point");
+        std::cerr << __FUNCTION__ <<
+            " Read data from flash error - Invalid data point\n";
         return false;
     }
     std::ifstream smbiosFile(mdrType2File, std::ios_base::binary);
     if (!smbiosFile.good())
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Read data from flash error - Open MDRV2 table file failure");
+        std::cerr << __FUNCTION__ <<
+            " Read data from flash error - Open MDRV2 table file failure\n";
         return false;
     }
     smbiosFile.clear();
@@ -229,15 +229,15 @@ bool MDR_V2::readDataFromFlash(MDRSMBIOSHeader* mdrHdr, uint8_t* data)
     smbiosFile.seekg(0, std::ios_base::beg);
     if (fileLength < sizeof(MDRSMBIOSHeader))
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "MDR V2 file size is smaller than mdr header");
+        std::cerr << __FUNCTION__ <<
+            " MDR V2 file size is smaller than mdr header\n";
         return false;
     }
     smbiosFile.read(reinterpret_cast<char*>(mdrHdr), sizeof(MDRSMBIOSHeader));
     if (mdrHdr->dataSize > smbiosTableStorageSize)
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Data size out of limitation");
+        std::cerr << __FUNCTION__ <<
+            " Data size out of limitation\n";
         smbiosFile.close();
         return false;
     }
@@ -262,16 +262,16 @@ bool MDR_V2::sendDirectoryInformation(uint8_t dirVersion, uint8_t dirIndex,
     bool teminate = false;
     if ((dirIndex >= maxDirEntries) || (returnedEntries < 1))
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Send Dir info failed - input parameter invalid");
+        std::cerr << __FUNCTION__ <<
+            " Send Dir info failed - input parameter invalid\n";
         throw sdbusplus::xyz::openbmc_project::Smbios::MDR_V2::Error::
             InvalidParameter();
     }
     if ((static_cast<size_t>(returnedEntries) * sizeof(DataIdStruct)) !=
         dirEntry.size())
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Directory size invalid");
+        std::cerr << __FUNCTION__ <<
+            " Directory size invalid\n";
         throw sdbusplus::xyz::openbmc_project::Smbios::MDR_V2::Error::
             InvalidParameter();
     }
@@ -347,8 +347,7 @@ int MDR_V2::findIdIndex(std::vector<uint8_t> dataInfo)
 {
     if (dataInfo.size() != sizeof(DataIdStruct))
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "Length of dataInfo invalid");
+        std::cerr << __FUNCTION__ << " Length of dataInfo invalid\n";
         throw sdbusplus::xyz::openbmc_project::Smbios::MDR_V2::Error::
             InvalidId();
     }
@@ -380,8 +379,8 @@ uint8_t MDR_V2::directoryEntries(uint8_t value)
     std::ifstream smbiosFile(mdrType2File, std::ios_base::binary);
     if (!smbiosFile.good())
