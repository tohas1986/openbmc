     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "get oem nic records failed");
+        std::cerr << __FUNCTION__ << " get oem nic records failed\n";
     }
 
     for (int index = 0; index < num; index++)
@@ -490,8 +484,7 @@ void MDR_V2::systemInfoUpdate()
     num = getRecordsNumByType(oemDriveType);
     if (num == -1)
     {
-        phosphor::logging::log<phosphor::logging::level::ERR>(
-            "get oem drive records failed");
