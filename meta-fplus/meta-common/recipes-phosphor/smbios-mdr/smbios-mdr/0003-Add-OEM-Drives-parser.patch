+
+#include <xyz/openbmc_project/Inventory/Item/Drive/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+class Drive:
+    sdbusplus::server::object::object<
+        sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive>
+{
+  public:
+    Drive() = delete;
+    ~Drive() = default;
+    Drive(const Drive&) = delete;
+    Drive& operator=(const Drive&) = delete;
+    Drive(Drive&&) = default;
+    Drive& operator=(Drive&&) = default;
+
+    Drive(sdbusplus::bus::bus& bus, const std::string& objPath,
+         const uint8_t& driveId, uint8_t* smbiosTableStorage) :
+        sdbusplus::server::object::object<
+            sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive>(
+            bus, objPath.c_str()),
+        driveNum(driveId), storage(smbiosTableStorage)
+    {
+        driveInfoUpdate();
+    }
+
+    void driveInfoUpdate(void);
+
+    std::string driveConnectedTo(std::string value) override;
+    uint16_t drivePortNumber(uint16_t value) override;
+    std::string driveSerial(std::string value) override;
+    std::string driveFirmwareVersion(std::string value) override;
+    std::string driveProductName(std::string value) override;
+    uint64_t driveSizeInKB(uint64_t value) override;
+
+  private:
+    uint8_t driveNum;
+
+    uint8_t* storage;
+
+    struct DriveInfo
+    {
+        uint8_t type;
+        uint8_t length;
+        uint16_t handle;
+
+        uint32_t connectedTo;        // to DBus
+        uint8_t  portNumber;         // to DBus
+        uint8_t  strSerial;          // to DBus
+        uint8_t  strFirmwareVersion; // to DBus
+        uint8_t  strProductName;     // to DBus
+
+        uint64_t sizeInKB;           // to DBus
+        uint16_t sataCapabilities;
+        uint16_t securityStatus;
+        uint16_t controllerVendorId;
+        uint16_t segmenGroupNumber;
+
+        uint8_t  busNumber;
+        uint8_t  deviceFunctionNumber;
+
+        uint16_t slotNumber;
+        uint16_t onboardIndex;
+        uint16_t minPower;
+        uint16_t maxPower;
+    } __attribute__((packed));
+};
+
+} // namespace smbios
+
+} // namespace phosphor
