+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::driveSizeInKB(value);
+}
+
+void Drive::driveInfoUpdate(void)
+{
+    uint8_t* dataIn = storage;
+
+    dataIn = getSMBIOSTypePtr(dataIn, oemDriveType);
+    if (dataIn == nullptr)
+    {
+        return;
+    }
+    for (uint8_t index = 0; index < driveNum; index++)
+    {
+        dataIn = smbiosNextPtr(dataIn);
+        if (dataIn == nullptr)
+        {
+            return;
+        }
+        dataIn = getSMBIOSTypePtr(dataIn, oemDriveType);
+        if (dataIn == nullptr)
+        {
+            return;
+        }
+    }
+
+    /* Fill in OEM structure */
+    auto driveInfo = reinterpret_cast<struct DriveInfo*>(dataIn);
+
+    /* And then parse it in accordance to the types of fiels */
+    std::string serial = positionToString(driveInfo->strSerial, driveInfo->length, dataIn);
+    std::string firmwareVersion = positionToString(driveInfo->strFirmwareVersion, driveInfo->length, dataIn);
+    std::string productName = positionToString(driveInfo->strProductName, driveInfo->length, dataIn);
+
+    std::string connectedTo;
+    switch (driveInfo->connectedTo)
+    {
+        case 0:
+            connectedTo = "SATA PCH";
+            break;
+        case 1:
+            connectedTo = "eSATA PCH";
+            break;
+
+        case 2:
+            connectedTo = "SAS LSI";
+            break;
+
+        case 3:
+            connectedTo = "PCIe";
+            break;
+
+        case 4:
+            connectedTo = "Reserved";
+            break;
+
+        default:
+            connectedTo = "Unknown";
+            break;
+    }
+
+    driveConnectedTo(connectedTo);
+    drivePortNumber(driveInfo->portNumber);
+    driveSerial(serial);
+    driveFirmwareVersion(firmwareVersion);
+    driveProductName(productName);
+    driveSizeInKB(driveInfo->sizeInKB);
+}
+
+} // namespace smbios
+} // namespace phosphor
