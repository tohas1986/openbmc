+std::string Drive::driveConnectedTo(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::driveConnectedTo(value);
+}
+
+uint16_t Drive::drivePortNumber(uint16_t value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::drivePortNumber(value);
+}
+
+std::string Drive::driveSerial(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::driveSerial(value);
+}
+
+std::string Drive::driveFirmwareVersion(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::driveFirmwareVersion(value);
+}
+
+std::string Drive::driveProductName(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Drive::driveProductName(value);
+}
+
