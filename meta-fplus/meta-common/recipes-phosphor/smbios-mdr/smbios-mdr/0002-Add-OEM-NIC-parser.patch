+#include "nic.hpp"
+
+#include <map>
+#include <sstream>
+#include <iostream>
+#include <iomanip>
+
+namespace phosphor
+{
+namespace smbios
+{
+
+std::string NIC::nicMACAddress(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet::nicMACAddress(value);
+}
+
+std::string NIC::nicManufacturerID(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet::nicManufacturerID(value);
+}
+
+std::string NIC::nicVendorID(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet::nicVendorID(value);
+}
+
+std::string NIC::nicProductID(std::string value)
+{
+    return sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet::nicProductID(value);
+}
+
+
+void NIC::nicInfoUpdate(void)
+{
+    uint8_t* dataIn = storage;
+
+    dataIn = getSMBIOSTypePtr(dataIn, oemNICType);
+    if (dataIn == nullptr)
+    {
+        return;
+    }
+
+    auto nicInfo = reinterpret_cast<struct NICInfo*>(dataIn);
+
+    std::string manufacturer = positionToString(nicInfo->strManufacturer, nicInfo->length, dataIn);
+    std::string fwVersion = positionToString(nicInfo->strFwVersion, nicInfo->length, dataIn);
+
+    std::stringstream ss_mac;
+    for(int i=0;i<6;i++)
+    {
+        ss_mac << std::hex << std::setfill('0') << std::setw(2) << +nicInfo->macAddress[i];
+        if (i !=5)
+          ss_mac << ":";
+    }
+    std::string macAddress = ss_mac.str();
+
+    std::stringstream ss_vid;
+    ss_vid << "0x" << std::hex << std::setfill('0') << std::setw(4) << +nicInfo->vendorID;
+    std::string vendorId = ss_vid.str();
+
+    std::stringstream ss_pid;
+    ss_pid << "0x" << std::hex << std::setfill('0') << std::setw(4) << +nicInfo->deviceID;
+    std::string productId = ss_pid.str();
+
+    nicMACAddress(macAddress);
+    nicManufacturerID(manufacturer);
+    nicVendorID(vendorId);
+    nicProductID(productId);
+}
+
+} // namespace smbios
+} // namespace phosphor
