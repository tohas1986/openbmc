+#pragma once
+#include <iostream>
+
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Inventory/Item/Ethernet/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+class NIC:
+    sdbusplus::server::object::object<
+        sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet>
+{
+  public:
+    NIC() = delete;
+    ~NIC() = default;
+    NIC(const NIC&) = delete;
+    NIC& operator=(const NIC&) = delete;
+    NIC(NIC&&) = default;
+    NIC& operator=(NIC&&) = default;
+
+    NIC(sdbusplus::bus::bus& bus, const std::string& objPath,
+         const uint8_t& nicId, uint8_t* smbiosTableStorage) :
+        sdbusplus::server::object::object<
+            sdbusplus::xyz::openbmc_project::Inventory::Item::server::Ethernet>(
+            bus, objPath.c_str()),
+        nicNum(nicId), storage(smbiosTableStorage)
+    {
+        nicInfoUpdate();
+    }
+
+    void nicInfoUpdate(void);
+
+    std::string nicMACAddress(std::string value) override;
+    std::string nicManufacturerID(std::string value) override;
+    std::string nicVendorID(std::string value) override;
+    std::string nicProductID(std::string value) override;
+
+  private:
+    uint8_t nicNum;
+
+    uint8_t* storage;
+
+    struct NICInfo
+    {
+        uint8_t type;
+        uint8_t length;
+        uint16_t handle;
+
+        uint16_t deviceID;
+        uint16_t vendorID;
+        uint8_t  strManufacturer;
+        uint8_t  macAddress[6];
+        uint8_t  ipv4Address[4];
+        uint8_t  ipv6Address[16];
+        uint8_t  strFwVersion;
+        uint8_t  linkStatus;
+        uint16_t slotNumber;
+        uint16_t portNumber;
+        uint8_t  ipv4Gateway[4];
+        uint8_t  ipv4Mask[4];
+        uint8_t  ipv6Gateway[16];
+        uint8_t  ipv6Mask[16];
+        uint8_t  linkSpeed;
+        uint16_t onboardIndex;
+    } __attribute__((packed));
+};
+
+} // namespace smbios
+
+} // namespace phosphor
diff --git a/include/smbios_mdrv2.hpp b/include/smbios_mdrv2.hpp
index 0ac77b9..306e54a 100644
--- a/include/smbios_mdrv2.hpp
+++ b/include/smbios_mdrv2.hpp
@@ -170,6 +170,9 @@ static constexpr const char* systemPath =
 constexpr std::array<SMBIOSVersion, 3> supportedSMBIOSVersions{
     SMBIOSVersion{3, 2}, SMBIOSVersion{3, 3}, SMBIOSVersion{3, 5}};
 
+static constexpr const char* nicPath =
+    "/xyz/openbmc_project/inventory/system/chassis/motherboard/nic";
+
 typedef enum
 {
     biosType = 0,
@@ -190,6 +193,7 @@ typedef enum
     systemEventLogType = 15,
     physicalMemoryArrayType = 16,
     memoryDeviceType = 17,
+    oemNICType = 131,
 } SmbiosType;
 
 static constexpr uint8_t separateLen = 2;
diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index 3949630..7bdacb3 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -470,6 +470,18 @@ void MDR_V2::systemInfoUpdate()
     system.reset();
     system = std::make_unique<System>(
         bus, systemPath, smbiosDir.dir[smbiosDirIndex].dataStorage);
+
+    nics.clear();
+    uint8_t index = 0;
+    while(true)
+    {
+        std::string path = nicPath + std::to_string(index);
+        /* Here is the thing: */
+        /* There may be more than one NIC, and each NIC may have more than one port */
+        nics.emplace_back(std::make_unique<phosphor::smbios::NIC>(
+            bus, path, index, smbiosDir.dir[smbiosDirIndex].dataStorage));
+        break;
+    }
 }
 
 int MDR_V2::getTotalCpuSlot()
