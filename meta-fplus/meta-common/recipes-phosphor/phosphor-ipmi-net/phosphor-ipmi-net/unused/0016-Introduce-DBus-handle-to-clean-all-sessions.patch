From 7ef0c4c57ec18531135edc45da9b32f333bdda3c Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Mon, 5 Apr 2021 15:00:06 +0000
Subject: [PATCH 1/1] Introduce DBus handle to clean all sessions

---
 main.cpp             | 13 +++++++++++++
 sessions_manager.cpp | 18 ++++++++++++++++++
 sessions_manager.hpp |  1 +
 3 files changed, 32 insertions(+)

diff --git a/main.cpp b/main.cpp
index 1d84c3c..03dc4f4 100644
--- a/main.cpp
+++ b/main.cpp
@@ -55,6 +55,11 @@ std::shared_ptr<sdbusplus::asio::connection> getSdBus()
     return sdbusp;
 }
 
+static void cleanSessions()
+{
+    manager.cleanAllSessions();
+}
+
 static EInterfaceIndex currentInterfaceIndex = interfaceUnknown;
 static void setInterfaceIndex(const std::string& channel)
 {
@@ -119,6 +124,14 @@ int main(int argc, char* argv[])
         return EXIT_FAILURE;
     }
 
+    // Initialize DBus handle
+    sdbusplus::asio::object_server clearServer = sdbusplus::asio::object_server(sdbusp);
+    static std::shared_ptr<sdbusplus::asio::dbus_interface> clearInterface =
+        clearServer.add_interface("/xyz/openbmc_project/control/ipmid/sessions",
+                                  "xyz.openbmc_project.ipmid.sessions");
+    clearInterface->register_method("Clear", cleanSessions);
+    clearInterface->initialize();
+
     // Start Event Loop
     return loop.startEventLoop();
 }
diff --git a/sessions_manager.cpp b/sessions_manager.cpp
index a8e2361..ddc4b82 100644
--- a/sessions_manager.cpp
+++ b/sessions_manager.cpp
@@ -247,6 +247,24 @@ void Manager::cleanStaleEntries()
     }
 }
 
+void Manager::cleanAllSessions()
+{
+    std::cerr << __FUNCTION__ << " called\n";
+    for (auto iter = sessionsMap.begin(); iter != sessionsMap.end();)
+    {
+        auto session = iter->second;
+        SessionID sessID = session->getBMCSessionID();
+        if (sessID == 0)
+        {
+            ++iter;
+            continue;
+        }
+        std::cerr << __FUNCTION__ <<  " erasing session " << +sessID << "\n";
+        sessionHandleMap[getSessionHandle(sessID)] = 0;
+        iter = sessionsMap.erase(iter);
+    }
+}
+
 uint8_t Manager::storeSessionHandle(SessionID bmcSessionID)
 {
     // Handler index 0 is  reserved for invalid session.
diff --git a/sessions_manager.hpp b/sessions_manager.hpp
index ed3db49..1288ebe 100644
--- a/sessions_manager.hpp
+++ b/sessions_manager.hpp
@@ -89,6 +89,7 @@ class Manager
     void managerInit(const std::string& channel);
 
     uint8_t getNetworkInstance(void);
+    void cleanAllSessions();
 
   private:
     //+1 for session, as 0 is reserved for sessionless command
-- 
