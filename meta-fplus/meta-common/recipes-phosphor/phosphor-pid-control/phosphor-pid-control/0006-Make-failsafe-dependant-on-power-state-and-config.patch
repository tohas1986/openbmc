diff --git a/pid/zone.cpp b/pid/zone.cpp
index e9aaafc..9c57450 100644
--- a/pid/zone.cpp
+++ b/pid/zone.cpp
@@ -24,6 +24,7 @@
 #include "pid/stepwisecontroller.hpp"
 #include "pid/thermalcontroller.hpp"
 #include "pid/tuning.hpp"
+#include "dbus/dbushelper.hpp"
 
 #include <algorithm>
 #include <chrono>
@@ -438,6 +439,30 @@ void DbusPidZone::updateSensors(void)
     /* margin and temp are stored as temp */
     tstamp now = high_resolution_clock::now();
 
+    /* Get current power state */
+    DbusHelper helper(sdbusplus::bus::new_system());
+    std::string strPowerOn = "";
+    try
+    {
+        helper.getProperty("xyz.openbmc_project.State.Chassis",
+                           "/xyz/openbmc_project/state/chassis0",
+                           "xyz.openbmc_project.State.Chassis",
+                           "CurrentPowerState", strPowerOn);
+    }
+    catch (const sdbusplus::exception::SdBusError& ex)
+    {
+        powerState = true;
+    }
+
+    if (strPowerOn == "xyz.openbmc_project.State.Chassis.PowerState.On")
+    {
+        powerState = true;
+    }
+    else
+    {
+        powerState = false;
+    }
+
     for (const auto& t : _thermalInputs)
     {
         auto sensor = _mgr.getSensor(t);
@@ -456,7 +481,7 @@ void DbusPidZone::updateSensors(void)
                       << "\n";
         }
 
-        if (sensor->getFailed())
+        if (sensor->getFailed() && powerState && sensor->getFsCritical())
         {
             _failSafeSensors.insert(t);
             if (debugEnabled)
@@ -464,7 +489,7 @@ void DbusPidZone::updateSensors(void)
                 std::cerr << t << " temperature sensor get failed\n";
             }
         }
-        else if (timeout != 0 && duration >= period)
+        else if (timeout != 0 && duration >= period && powerState && sensor->getFsCritical())
         {
             // std::cerr << "Entering fail safe mode.\n";
             _failSafeSensors.insert(t);
@@ -546,7 +571,10 @@ void DbusPidZone::processThermals(void)
 {
     for (auto& p : _thermals)
     {
-        p->process();
+        if (powerState || p->getOnPowerOff())
+        {
+            p->process();
+        }
     }
 }
 
