[Unit]
Description=dbus-checker
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target

[Service]
ExecStart=/usr/share/openrack/dbus-checker
Type=oneshot
RemainAfterExit=No
TimeoutSec=600

[Install]
WantedBy=multi-user.target
