+
+#include <linux/input.h>
+
+#include <boost/container/flat_map.hpp>
+#include <filesystem>
+#include <fstream>
+#include <ipmid/api.hpp>
+#include <oemcommands.hpp>
+
+namespace ipmi
+{
+
+ipmi::RspType<uint8_t> printTest()
+{
+   uint8_t rc = 1;
+   phosphor::logging::log<phosphor::logging::level::INFO>("Hue moe commad is working");
+   return ipmi::responseSuccess(rc);
+}
+
+} // namespace ipmi
+
+void register_yandex_commands() __attribute__((constructor));
+void register_yandex_commands()
+{
+    ipmi::registerHandler(ipmi::prioOemBase, ipmi::intel::netFnPlatform,
+                          ipmi::intel::platform::cmdPrintTest,
+                          ipmi::Privilege::Admin, ipmi::printTest);
+}
