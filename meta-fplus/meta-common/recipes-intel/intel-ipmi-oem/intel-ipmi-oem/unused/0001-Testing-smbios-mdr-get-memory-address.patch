+//If BIOS will ask we will answer where to put SMBIOS Data
+
+ipmi::RspType<uint32_t>ipmiOEMgetMemoryAddress(uint8_t param){
+    // Define specific AMI sub commands
+    switch(param)
+    {
+        case SUB_CMD_GET_SHARE_MEMORY_ADDRESS:
+            try
+            {
+                //uint32_t temp_reversed_value = reverse(mdr2SMBaseAddress);
+                std::stringstream ss;
+                ss << "VGA shared memory address is " << std::hex << std::setfill('0') << std::setw(2) << +mdr2SMBaseAddress;
+                std::string ss_str = ss.str();
+                phosphor::logging::log<phosphor::logging::level::INFO>(ss_str.c_str());
+
+                return ipmi::responseSuccess(mdr2SMBaseAddress);
+            }
+            catch (std::system_error&)
+            {
+                phosphor::logging::log<phosphor::logging::level::ERR>("Error to get Memory Address");
+                return ipmi::responseUnspecifiedError();
+            }
+        default:
+
+            std::stringstream ss;
+            ss << "Unknown subcommand: " << std::hex << std::setfill('0') << std::setw(2) << +param;
+            std::string ss_str = ss.str();
+            phosphor::logging::log<phosphor::logging::level::ERR>(ss_str.c_str());
+
+            return ipmi::responseParmOutOfRange();
+            break;
+    }
+    return ipmi::responseParmOutOfRange();
+}
+
+//If BIOS will tell that data is ready
+
+ipmi::RspType<std::vector<uint8_t>>ipmiOEMreadyOnShareMemory(std::vector<uint8_t> param){
+    
+    std::stringstream ss;
+    phosphor::logging::log<phosphor::logging::level::INFO>("Data is ready on share memory");
+
+    ss << "2 bytes, Request Length, 2 bytes, Reserved = 0x";
+
+    //std::copy(param.begin(), param.end(),std::ostream_iterator<uint8_t>(ss));
+    for(auto b : param) {
+        ss << " " << std::hex << std::setfill('0') << std::setw(2) << +b;
+    }
+
+    std::string ss_str = ss.str();
+    
+    phosphor::logging::log<phosphor::logging::level::INFO>(ss_str.c_str());
+    
+    return ipmi::responseSuccess();
+}
+
+//If BIOS will talk to BMC, just in case, we need to answer, huy znaet zachem
+
+ipmi::RspType<uint8_t>ipmiOEMaskInternalFlag(uint8_t param){
+    // Define specific AMI sub commands
+    uint8_t intflag = 0x01;
+ 
+    switch(param)
+    {
+        case SUB_CMD_INT_FLAG:
+            try
+            {
+                phosphor::logging::log<phosphor::logging::level::INFO>("Internal Flag received");
+                return ipmi::responseSuccess(intflag);
+            }
+            catch (std::system_error&)
+            {
+                phosphor::logging::log<phosphor::logging::level::ERR>("Error to get Memory Address");
+                return ipmi::responseUnspecifiedError();
+            }
+        default:
+
+            std::stringstream ss;
+            ss << "Unknown subcommand: " << std::hex << std::setfill('0') << std::setw(2) << +param;
+            std::string ss_str = ss.str();
+            phosphor::logging::log<phosphor::logging::level::ERR>(ss_str.c_str());
+
+            return ipmi::responseParmOutOfRange();
+            break;
+    }
+    return ipmi::responseParmOutOfRange();
+}
