From 84dfde2f32684c0c68f1a1e09c51b58a3c935b0a Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 9 Jun 2020 11:32:50 +0000
Subject: [PATCH] intel-ipmi-oem: If no reading for sensor - set
 ReadingStateUnavailable bit to get no reading in ipmitool output

---
 src/sensorcommands.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/sensorcommands.cpp b/src/sensorcommands.cpp
index e9eb290..d24788a 100644
--- a/src/sensorcommands.cpp
+++ b/src/sensorcommands.cpp
@@ -433,6 +433,13 @@ ipmi::RspType<uint8_t, uint8_t, uint8_t, std::optional<uint8_t>>
     operation |=
         static_cast<uint8_t>(IPMISensorReadingByte2::eventMessagesEnable);
 
+    if (std::isnan(reading))
+    {
+        operation |= static_cast<uint8_t>(IPMISensorReadingByte2::readingStateUnavailable);
+        /* To change from "no reading" to "disable", unset sensorScanningEnable */
+        /* operation &= ~(static_cast<uint8_t>(IPMISensorReadingByte2::sensorScanningEnable)); */
+    }
+
     uint8_t thresholds = 0;
 
     auto warningObject =
