From fd4ab22a875586806d8888c1c9a1ac198eb6195f Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Thu, 29 Sep 2022 13:44:30 +0000
Subject: [PATCH] Fix compile errors

---
 CMakeLists.txt | 2 +-
 src/system.hpp | 1 +
 src/utils.hpp  | 1 +
 3 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e9eb2a4..95c892b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -5,7 +5,7 @@ project(VirtualMedia CXX)
 cmake_policy(SET CMP0054 NEW)
 
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
-set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_MODULE_PATH ${CMAKE_CURRENT_SOURCE_DIR}/cmake ${CMAKE_MODULE_PATH})
 
diff --git a/src/system.hpp b/src/system.hpp
index cd16802..63b5451 100644
--- a/src/system.hpp
+++ b/src/system.hpp
@@ -8,6 +8,7 @@
 #include <boost/container/flat_map.hpp>
 #include <boost/process.hpp>
 #include <filesystem>
+#include <fstream>
 #include <sdbusplus/asio/object_server.hpp>
 
 namespace fs = std::filesystem;
diff --git a/src/utils.hpp b/src/utils.hpp
index 8eaebfa..db1da9a 100644
--- a/src/utils.hpp
+++ b/src/utils.hpp
@@ -10,6 +10,7 @@
 #include <sdbusplus/asio/object_server.hpp>
 #include <string>
 #include <vector>
+#include <fstream>
 
 namespace fs = std::filesystem;
 
