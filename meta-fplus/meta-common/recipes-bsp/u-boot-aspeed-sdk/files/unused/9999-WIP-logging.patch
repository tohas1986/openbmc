 		writel(test_pattern, write_addr_base + (ram_size >> 1));
@@ -700,6 +710,7 @@ static int ast2600_sdrammc_init_ddr4(struct dram_info *info)
 			       MCR34_MREQ_BYPASS_DIS | MCR34_RESETN_DIS |
