diff --git a/common/spl/spl.c b/common/spl/spl.c
index 927e072778..b451f225ef 100644
--- a/common/spl/spl.c
+++ b/common/spl/spl.c
@@ -25,6 +25,8 @@
 #include <fdt_support.h>
 #include <bootcount.h>
 
+#define LOG_DEBUG
+
 DECLARE_GLOBAL_DATA_PTR;
 
 #ifndef CONFIG_SYS_UBOOT_START
@@ -334,6 +336,7 @@ __weak void __noreturn jump_to_image_no_args(struct spl_image_info *spl_image)
 	image_entry_noargs_t image_entry =
 		(image_entry_noargs_t)spl_image->entry_point;
 
+	printf("image entry point: 0x%lx\n", spl_image->entry_point);
 	debug("image entry point: 0x%lx\n", spl_image->entry_point);
 	image_entry();
 }
@@ -576,7 +579,7 @@ static int boot_from_devices(struct spl_image_info *spl_image,
 		loader = spl_ll_find_loader(spl_boot_list[i]);
 #if defined(CONFIG_SPL_SERIAL_SUPPORT) && defined(CONFIG_SPL_LIBCOMMON_SUPPORT)
 		if (loader)
-			printf("Trying to boot from %s\n", loader->name);
+			printf("Trying to boot from %s, 1000 chertey\n", loader->name);
 		else
 			puts(SPL_TPL_PROMPT "Unsupported Boot Device!\n");
 #endif
@@ -584,6 +587,7 @@ static int boot_from_devices(struct spl_image_info *spl_image,
 			spl_image->boot_device = spl_boot_list[i];
 			return 0;
 		}
+		printf("Shit happened with %s\n", loader->name);
 	}
 
 	return -ENODEV;
@@ -678,35 +682,44 @@ void board_init_r(gd_t *dummy1, ulong dummy2)
 		hang();
 	}
 
+	puts(SPL_TPL_PROMPT "Still here 1\n");
 	spl_perform_fixups(&spl_image);
+	puts(SPL_TPL_PROMPT "Still here 2\n");
 	if (CONFIG_IS_ENABLED(HANDOFF)) {
 		ret = write_spl_handoff();
 		if (ret)
 			printf(SPL_TPL_PROMPT
 			       "SPL hand-off write failed (err=%d)\n", ret);
 	}
+	puts(SPL_TPL_PROMPT "Still here 3\n");
 	if (CONFIG_IS_ENABLED(BLOBLIST)) {
+	    puts(SPL_TPL_PROMPT "Still here 3.5\n");
 		ret = bloblist_finish();
 		if (ret)
 			printf("Warning: Failed to finish bloblist (ret=%d)\n",
 			       ret);
+	puts(SPL_TPL_PROMPT "Still here 4\n");
 	}
 
+	puts(SPL_TPL_PROMPT "Still here 5\n");
 #ifdef CONFIG_CPU_V7M
 	spl_image.entry_point |= 0x1;
 #endif
 	switch (spl_image.os) {
 	case IH_OS_U_BOOT:
+	    puts(SPL_TPL_PROMPT "Still here 6\n");
 		debug("Jumping to U-Boot\n");
 		break;
 #if CONFIG_IS_ENABLED(ATF)
 	case IH_OS_ARM_TRUSTED_FIRMWARE:
+	    puts(SPL_TPL_PROMPT "Still here 7\n");
 		debug("Jumping to U-Boot via ARM Trusted Firmware\n");
 		spl_invoke_atf(&spl_image);
 		break;
 #endif
 #if CONFIG_IS_ENABLED(OPTEE)
 	case IH_OS_TEE:
+	    puts(SPL_TPL_PROMPT "Still here 8\n");
 		debug("Jumping to U-Boot via OP-TEE\n");
 		spl_optee_entry(NULL, NULL, spl_image.fdt_addr,
 				(void *)spl_image.entry_point);
@@ -714,28 +727,37 @@ void board_init_r(gd_t *dummy1, ulong dummy2)
 #endif
 #ifdef CONFIG_SPL_OS_BOOT
 	case IH_OS_LINUX:
+	    puts(SPL_TPL_PROMPT "Still here 9\n");
 		debug("Jumping to Linux\n");
 		spl_fixup_fdt();
 		spl_board_prepare_for_linux();
 		jump_to_image_linux(&spl_image);
 #endif
 	default:
+	    puts(SPL_TPL_PROMPT "Still here 10\n");
 		debug("Unsupported OS image.. Jumping nevertheless..\n");
 	}
 #if CONFIG_VAL(SYS_MALLOC_F_LEN) && !defined(CONFIG_SYS_SPL_MALLOC_SIZE)
 	debug("SPL malloc() used 0x%lx bytes (%ld KB)\n", gd->malloc_ptr,
 	      gd->malloc_ptr / 1024);
 #endif
+puts(SPL_TPL_PROMPT "Still here 11\n");
 #ifdef CONFIG_BOOTSTAGE_STASH
+    puts(SPL_TPL_PROMPT "Still here 12\n");
 	bootstage_mark_name(BOOTSTAGE_ID_END_SPL, "end_spl");
+    puts(SPL_TPL_PROMPT "Still here 13\n");
 	ret = bootstage_stash((void *)CONFIG_BOOTSTAGE_STASH_ADDR,
 			      CONFIG_BOOTSTAGE_STASH_SIZE);
-	if (ret)
+	if (ret) {
+        puts(SPL_TPL_PROMPT "Still here 14\n");
 		debug("Failed to stash bootstage: err=%d\n", ret);
+    }
 #endif
 
+    puts(SPL_TPL_PROMPT "Still here 15\n");
 	debug("loaded - jumping to U-Boot...\n");
 	spl_board_prepare_for_boot();
+    puts(SPL_TPL_PROMPT "Still here 16\n");
 	jump_to_image_no_args(&spl_image);
 }
 
