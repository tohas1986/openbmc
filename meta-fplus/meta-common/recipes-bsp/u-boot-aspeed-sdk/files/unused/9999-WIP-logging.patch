diff --git a/include/log.h b/include/log.h
index 7566ba7f2d..973abb6581 100644
--- a/include/log.h
+++ b/include/log.h
@@ -117,10 +117,12 @@ int _log(enum log_category_t cat, enum log_level_t level, const char *file,
 #define _LOG_DEBUG	0
 #endif
 
+// KITSOK
+#define _LOG_DEBUG 1
 /* Emit a log record if the level is less that the maximum */
 #define log(_cat, _level, _fmt, _args...) ({ \
 	int _l = _level; \
-	if (CONFIG_IS_ENABLED(LOG) && (_l <= _LOG_MAX_LEVEL || _LOG_DEBUG)) \
+	if (1 || CONFIG_IS_ENABLED(LOG) && (_l <= _LOG_MAX_LEVEL || _LOG_DEBUG)) \
 		_log((enum log_category_t)(_cat), _l, __FILE__, __LINE__, \
 		      __func__, \
 		      pr_fmt(_fmt), ##_args); \
@@ -135,6 +137,8 @@ int _log(enum log_category_t cat, enum log_level_t level, const char *file,
 #define _DEBUG	0
 #endif
 
+#define _DEBUG 1
+
 #ifdef CONFIG_SPL_BUILD
 #define _SPL_BUILD	1
 #else
