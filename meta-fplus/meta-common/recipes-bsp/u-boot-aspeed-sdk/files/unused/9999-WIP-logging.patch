 		pattern = as2600_sdrammc_test_pattern[i++];
@@ -482,6 +488,7 @@ static size_t ast2600_sdrammc_get_vga_mem_size(struct dram_info *info)
 	u32 vga_hwconf;
 	size_t vga_mem_size_base = 8 * 1024 * 1024;
 
