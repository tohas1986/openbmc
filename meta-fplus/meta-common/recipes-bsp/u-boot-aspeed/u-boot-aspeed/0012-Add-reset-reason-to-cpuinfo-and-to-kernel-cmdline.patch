+		  AST_SCU_FUN_PIN_CTRL6);
 	ast_scu_write(ast_scu_read(AST_SCU_FUN_PIN_CTRL6) | (0x00000001),
-                AST_SCU_FUN_PIN_CTRL6);
+		  AST_SCU_FUN_PIN_CTRL6);
 	ast_scu_write(ast_scu_read(AST_SCU_FUN_PIN_CTRL4) | (0x000000ff),
-                AST_SCU_FUN_PIN_CTRL4);
+		  AST_SCU_FUN_PIN_CTRL4);
 	ast_scu_write(ast_scu_read(AST_SCU_FUN_PIN_CTRL8) | (0xffff0000),
-                AST_SCU_FUN_PIN_CTRL8);
+		  AST_SCU_FUN_PIN_CTRL8);
 	ast_scu_write(ast_scu_read(AST_SCU_FUN_PIN_CTRL9) | (0x0000000f),
-                AST_SCU_FUN_PIN_CTRL9);
+		  AST_SCU_FUN_PIN_CTRL9);
 	ast_scu_write(ast_scu_read(AST_SCU_RESET) & (0xfffffffb),
-                AST_SCU_RESET);
+		  AST_SCU_RESET);
