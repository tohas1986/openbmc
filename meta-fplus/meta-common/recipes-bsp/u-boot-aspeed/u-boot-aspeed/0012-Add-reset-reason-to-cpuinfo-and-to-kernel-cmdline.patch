 		break;
 	case 2:
 		ast_scu_write((ast_scu_read(AST_SCU_HW_STRAP1) &
-			       ~SCU_HW_STRAP_SPI_MODE_MASK) |
+				~SCU_HW_STRAP_SPI_MODE_MASK) |
