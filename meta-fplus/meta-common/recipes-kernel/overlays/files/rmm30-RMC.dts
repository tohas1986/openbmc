/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
	compatible = "aspeed,ast2400";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			model = "Yandex RMC v3.x";
		};
	};

	fragment@1 {
		target = <&mac1>;
		__overlay__ {
			status = "okay";
			compatible = "faraday,ftgmac100", "aspeed,ast2400-mac";

			no-hw-checksum;
			phy-handle = <&phy1>;
			phy-mode = "rgmii";
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_rgmii2_default &pinctrl_mdio2_default>;

			mdio {
				phy1: phy@0 {
					compatible = "ethernet-phy-id001c.c915";
					reg = <0>;
				};
			};
		};
	};

	fragment@2 {
		target = <&i2c7>;
		__overlay__ {
			status = "okay";
			bus-frequency = <100000>;
			rtc@68 {
				compatible = "maxim,ds3231";
				reg = <0x68>;
				// interrupts = <GPIOF0>
			};

			tmp {
				label = "TEMP1";
				compatible = "national,lm75";
				reg = <0x48>;
			};
			fru {
				compatible = "atmel,24c256";
				reg = <0x56>;
				// pagesize = <32>;
			};
		};
	};

	fragment@3 {
		target-path = "/";
		__overlay__ {
			ledsRMC {
				compatible = "gpio-leds";
				led_green_1 { label = "led_green_1"; gpios = <&gpio ASPEED_GPIO(I, 4) GPIO_ACTIVE_LOW>; };
				led_red_1 { label = "led_red_1"; gpios = <&gpio ASPEED_GPIO(I, 5) GPIO_ACTIVE_LOW>; };
			};
		};
	};
};
