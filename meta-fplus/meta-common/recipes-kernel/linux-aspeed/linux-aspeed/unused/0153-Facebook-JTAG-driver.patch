 drivers/jtag/Kconfig             |    7 +
 drivers/jtag/jtag-aspeed.c       | 1584 ++++++++++++------------------
 drivers/jtag/jtag.c              |   76 +-
 include/linux/jtag.h             |   23 +-
 include/uapi/linux/jtag.h        |  213 +---
 6 files changed, 706 insertions(+), 1203 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed-g6.dtsi b/arch/arm/boot/dts/aspeed-g6.dtsi
index 845dfe706e38..8066a84d1b63 100644
--- a/arch/arm/boot/dts/aspeed-g6.dtsi
+++ b/arch/arm/boot/dts/aspeed-g6.dtsi
@@ -474,7 +474,7 @@ xdma: xdma@1e6e7000 {
 
 			jtag0: jtag@1e6e4000 {
 				compatible = "aspeed,ast2600-jtag";
-				reg = <0x1e6e4000 0x40>;
+				reg = <0x1e6e4000 0x40 0x1e6e2040 0x8 0x1e6e2418 0x4>;
 				clocks = <&syscon ASPEED_CLK_APB1>;
 				resets = <&syscon ASPEED_RESET_JTAG_MASTER>;
 				interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
@@ -483,8 +483,8 @@ jtag0: jtag@1e6e4000 {
 
 			jtag1: jtag@1e6e4100 {
 				compatible = "aspeed,ast2600-jtag";
-				reg = <0x1e6e4100 0x40>;
-				clocks = <&syscon ASPEED_CLK_APB1>;
+				reg = <0x1e6e4100 0x40 0x1e6e2050 0x8 0x1e6e2418 0x4>;
+				clocks = <&syscon ASPEED_CLK_APB1>; // Facebook has ASPEED_CLK_AHB
 				resets = <&syscon ASPEED_RESET_JTAG_MASTER2>;
 				interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>;
 				pinctrl-names = "default";
diff --git a/drivers/jtag/Kconfig b/drivers/jtag/Kconfig
index 0cc163f9ad44..d3814e57d638 100644
--- a/drivers/jtag/Kconfig
+++ b/drivers/jtag/Kconfig
@@ -29,3 +29,10 @@ menuconfig JTAG_ASPEED
 
 	  To compile this driver as a module, choose M here: the module will
 	  be called jtag-aspeed.
+
+config JTAG_ASPEED_LEGACY_UIO
+	bool "ASPEED JTAG Legacy User Space I/O Support"
+	depends on JTAG_ASPEED
+	help
+	  If you say yes here, you get a set of sysfs interfaces and ioctl
+	  commands for supporting legacy user space applications.
