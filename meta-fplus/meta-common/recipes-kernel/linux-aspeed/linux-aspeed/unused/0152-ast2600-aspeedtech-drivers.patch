+static int video_open(struct inode *pin, struct file *pf)
+{
+	VIDEO_DBG("%s Called\n", __func__);
+
+	// make sure the rvas clk is running.
+	//	 if it's already enabled, clk_enable will just return.
+	clk_enable(pAstRVAS->rvasclk);
+
+	return 0;
