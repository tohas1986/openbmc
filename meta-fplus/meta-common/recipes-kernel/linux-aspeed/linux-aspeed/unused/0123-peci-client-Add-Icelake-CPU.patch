From 9ab93e80880892b6ed2cfcf3ca0fb3e714ab1f4c Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 10 Nov 2020 11:03:08 +0000
Subject: [PATCH 1/1] peci-client: Add Icelake CPU

---
 drivers/mfd/intel-peci-client.c       | 8 +++++++-
 include/linux/mfd/intel-peci-client.h | 5 +++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/mfd/intel-peci-client.c b/drivers/mfd/intel-peci-client.c
index 24f1543..d0e775a1 100644
--- a/drivers/mfd/intel-peci-client.c
+++ b/drivers/mfd/intel-peci-client.c
@@ -48,6 +48,12 @@ static const struct cpu_gen_info cpu_gen_info_table[] = {
 		.core_max      = CORE_MAX_ON_SKXD,
 		.chan_rank_max = CHAN_RANK_MAX_ON_SKXD,
 		.dimm_idx_max  = DIMM_IDX_MAX_ON_SKXD },
+	{ /* Icelake Xeon */
+		.family        = INTEL_FAM6,
+		.model         = INTEL_FAM6_ICELAKE_X,
+		.core_max      = CORE_MAX_ON_ICX,
+		.chan_rank_max = CHAN_RANK_MAX_ON_ICX,
+		.dimm_idx_max  = DIMM_IDX_MAX_ON_ICX },
 };
 
 static int peci_client_get_cpu_gen_info(struct peci_client_manager *priv)
@@ -83,7 +89,7 @@ static int peci_client_get_cpu_gen_info(struct peci_client_manager *priv)
 	}
 
 	if (!priv->gen_info) {
-		dev_err(dev, "Can't support this CPU: 0x%x\n", cpu_id);
+		dev_err(dev, "Can't support this CPU: 0x%x family: 0x%04x model: 0x%02x \n", cpu_id, model, family);
 		ret = -ENODEV;
 	}
 
diff --git a/include/linux/mfd/intel-peci-client.h b/include/linux/mfd/intel-peci-client.h
index 7668d0c..83167be6 100644
--- a/include/linux/mfd/intel-peci-client.h
+++ b/include/linux/mfd/intel-peci-client.h
@@ -18,6 +18,7 @@
 #define INTEL_FAM6_BROADWELL_X		0x4F
 #define INTEL_FAM6_SKYLAKE_X		0x55
 #define INTEL_FAM6_SKYLAKE_XD		0x56
+#define INTEL_FAM6_ICELAKE_X		0x6a
 #endif
 
 #define INTEL_FAM6             6 /* P6 (Pentium Pro and later) */
@@ -38,6 +39,10 @@
 #define CHAN_RANK_MAX_ON_SKXD  2  /* Max number of channel ranks on Skylake D */
 #define DIMM_IDX_MAX_ON_SKXD   2  /* Max DIMM index per channel on Skylake D */
 
+#define CORE_MAX_ON_ICX       32  /* Max number of cores on Skylake D */
+#define CHAN_RANK_MAX_ON_ICX   6  /* Max number of channel ranks on Skylake D */
+#define DIMM_IDX_MAX_ON_ICX    2  /* Max DIMM index per channel on Skylake D */
+
 #define CORE_NUMS_MAX          CORE_MAX_ON_SKX
 #define CHAN_RANK_MAX          CHAN_RANK_MAX_ON_HSX
 #define DIMM_IDX_MAX           DIMM_IDX_MAX_ON_HSX
-- 
2.7.4

