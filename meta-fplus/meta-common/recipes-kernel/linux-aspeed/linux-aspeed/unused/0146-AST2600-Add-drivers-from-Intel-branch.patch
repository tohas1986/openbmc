+static int aspeed_pwm_enable(struct pwm_chip *chip, struct pwm_device *pwm)
+{
+	struct aspeed_pwm_tachometer_data *priv = to_aspeed_pwm(chip);
+
+	aspeed_set_pwm_channel_enable(priv->regmap, pwm->hwpwm, true);
+
+	return 0;
+}
