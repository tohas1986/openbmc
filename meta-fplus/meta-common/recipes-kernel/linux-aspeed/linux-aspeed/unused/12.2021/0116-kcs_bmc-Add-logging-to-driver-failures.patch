From 24856abbde6bb06a20f83ed9fb94b2a7ef0b8eaf Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Wed, 2 Sep 2020 07:34:11 +0000
Subject: [PATCH 1/1] kcs_bmc: Add logging to driver failures

---
 drivers/char/ipmi/kcs_bmc_aspeed.c | 32 ++++++++++++++++++++++++--------
 1 file changed, 24 insertions(+), 8 deletions(-)

diff --git a/drivers/char/ipmi/kcs_bmc_aspeed.c b/drivers/char/ipmi/kcs_bmc_aspeed.c
index de33fbc..f642986 100644
--- a/drivers/char/ipmi/kcs_bmc_aspeed.c
+++ b/drivers/char/ipmi/kcs_bmc_aspeed.c
@@ -302,27 +302,37 @@ static struct kcs_bmc *aspeed_kcs_probe_of_v2(struct platform_device *pdev)
 
 	/* Don't translate addresses, we want offsets for the regmaps */
 	reg = of_get_address(np, 0, NULL, NULL);
-	if (!reg)
+	if (!reg) {
+		dev_err(&pdev->dev, "%s: of_get_address 0 failed\n", __FUNCTION__);
 		return ERR_PTR(-EINVAL);
+	}
 	ioreg.idr = be32_to_cpup(reg);
 
 	reg = of_get_address(np, 1, NULL, NULL);
-	if (!reg)
+	if (!reg) {
+		dev_err(&pdev->dev, "%s: of_get_address 1 failed\n", __FUNCTION__);
 		return ERR_PTR(-EINVAL);
+	}
 	ioreg.odr = be32_to_cpup(reg);
 
 	reg = of_get_address(np, 2, NULL, NULL);
-	if (!reg)
+	if (!reg) {
+		dev_err(&pdev->dev, "%s: of_get_address 2 failed\n", __FUNCTION__);
 		return ERR_PTR(-EINVAL);
+	}
 	ioreg.str = be32_to_cpup(reg);
 
 	channel = aspeed_kcs_calculate_channel(&ioreg);
-	if (channel < 0)
+	if (channel < 0) {
+		dev_err(&pdev->dev, "%s: calculate_channel failed\n", __FUNCTION__);
 		return ERR_PTR(channel);
+	}
 
 	kcs = kcs_bmc_alloc(&pdev->dev, sizeof(struct aspeed_kcs_bmc), channel);
-	if (!kcs)
+	if (!kcs) {
+		dev_err(&pdev->dev, "%s: kcs_bmc_alloc failed\n", __FUNCTION__);
 		return ERR_PTR(-ENOMEM);
+	}
 
 	kcs->ioreg = ioreg;
 
@@ -334,8 +344,10 @@ static struct kcs_bmc *aspeed_kcs_probe_of_v2(struct platform_device *pdev)
 	}
 
 	rc = of_property_read_u32(np, "aspeed,lpc-io-reg", &slave);
-	if (rc)
+	if (rc) {
+		dev_err(&pdev->dev, "%s: failed to find lpc-io-reg\n", __FUNCTION__);
 		return ERR_PTR(rc);
+	}
 
 	aspeed_kcs_set_address(kcs, slave);
 
@@ -357,11 +369,15 @@ static int aspeed_kcs_probe(struct platform_device *pdev)
 	else if (of_device_is_compatible(np, "aspeed,ast2400-kcs-bmc-v2") ||
 			of_device_is_compatible(np, "aspeed,ast2500-kcs-bmc-v2"))
 		kcs_bmc = aspeed_kcs_probe_of_v2(pdev);
-	else
+	else {
+		dev_err(&pdev->dev, "%s: compatibility check failed\n", __FUNCTION__);
 		return -EINVAL;
+	}
 
-	if (IS_ERR(kcs_bmc))
+	if (IS_ERR(kcs_bmc)) {
+		dev_err(&pdev->dev, "%s: compatibility check failed\n", __FUNCTION__);
 		return PTR_ERR(kcs_bmc);
+	}
 
         priv->clk = devm_clk_get(dev, NULL);
         if (IS_ERR(priv->clk)) {
-- 
2.7.4

