From d69f4147b2f459c00f12b9ab79dce16e669266ac Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Wed, 17 Jun 2020 12:51:37 +0000
Subject: [PATCH 1/1] jc42: Hack the driver to instantiate devices despite
 there are not present

---
 drivers/hwmon/jc42.c | 29 +++++++++++++++++------------
 1 file changed, 17 insertions(+), 12 deletions(-)

diff --git a/drivers/hwmon/jc42.c b/drivers/hwmon/jc42.c
index e3f1ebe..eb27a2f 100644
--- a/drivers/hwmon/jc42.c
+++ b/drivers/hwmon/jc42.c
@@ -416,6 +416,10 @@ static int jc42_detect(struct i2c_client *client, struct i2c_board_info *info)
 				     I2C_FUNC_SMBUS_WORD_DATA))
 		return -ENODEV;
 
+	/* HACK */
+	strlcpy(info->type, "jc42", I2C_NAME_SIZE);
+	return 0;
+
 	cap = i2c_smbus_read_word_swapped(client, JC42_REG_CAP);
 	config = i2c_smbus_read_word_swapped(client, JC42_REG_CONFIG);
 	manid = i2c_smbus_read_word_swapped(client, JC42_REG_MANID);
@@ -473,9 +477,9 @@ static int jc42_probe(struct i2c_client *client, const struct i2c_device_id *id)
 	i2c_set_clientdata(client, data);
 	mutex_init(&data->update_lock);
 
-	cap = i2c_smbus_read_word_swapped(client, JC42_REG_CAP);
-	if (cap < 0)
-		return cap;
+	/* HACK */
+	cap = 0x00ff;
+	//cap = i2c_smbus_read_word_swapped(client, JC42_REG_CAP);
 
 	data->extended = !!(cap & JC42_CAP_RANGE);
 
@@ -488,21 +492,22 @@ static int jc42_probe(struct i2c_client *client, const struct i2c_device_id *id)
 		 * incompatible with the below attempt to disable
 		 * the timeout. And the whole thing is opt-in...
 		 */
-		smbus = i2c_smbus_read_word_swapped(client, JC42_REG_SMBUS);
-		if (smbus < 0)
-			return smbus;
-		i2c_smbus_write_word_swapped(client, JC42_REG_SMBUS,
-					     smbus | SMBUS_STMOUT);
+		/* HACK */
+		smbus = 0x00;
+		//smbus = i2c_smbus_read_word_swapped(client, JC42_REG_SMBUS);
+		//i2c_smbus_write_word_swapped(client, JC42_REG_SMBUS,
+		//			     smbus | SMBUS_STMOUT);
 	}
 
-	config = i2c_smbus_read_word_swapped(client, JC42_REG_CONFIG);
-	if (config < 0)
-		return config;
+	/* HACK */
+	config = 0x040c;
+	//config = i2c_smbus_read_word_swapped(client, JC42_REG_CONFIG);
 
 	data->orig_config = config;
+	/* HACK */
 	if (config & JC42_CFG_SHUTDOWN) {
 		config &= ~JC42_CFG_SHUTDOWN;
-		i2c_smbus_write_word_swapped(client, JC42_REG_CONFIG, config);
+	//	i2c_smbus_write_word_swapped(client, JC42_REG_CONFIG, config);
 	}
 	data->config = config;
 
-- 
