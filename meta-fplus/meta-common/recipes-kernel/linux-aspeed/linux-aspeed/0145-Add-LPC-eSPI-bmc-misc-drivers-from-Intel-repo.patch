+static struct i3c_dev_desc *dw_get_i3c_dev_by_addr(struct dw_i3c_master *master,
+						   u8 addr)
+{
+	int i;
+
+	for (i = 0; i < master->maxdevs; i++) {
+		if (master->ibi.slots[i] && master->ibi.slots[i]->info.dyn_addr == addr)
+			return master->ibi.slots[i];
+	}
+	return NULL;
+}
