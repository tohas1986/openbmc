/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
	model = "SOM2600V1 BMC";
	compatible = "yandex,som2600v1-bmc", "aspeed,ast2600";

	aliases {
		serial4 = &uart5;
	};

	chosen {
		bootargs = "console=ttyS4,115200n8 rw earlyrintk";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x80000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gfx_memory: framebuffer {
			size = <0x01000000>;
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			reusable;
		};

		video_engine_memory: video {
			size = <0x04000000>;
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			reusable;
		};

		ssp_memory: ssp_memory {
			size = <0x02000000>;
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			no-map;
		};

		bmc_dev_memory: bmc_dev_memory {
			size = <0x00100000>;
			alignment = <0x00100000>;
			compatible = "shared-dma-pool";
			no-map;
		};

		/* 1GB memory */
		vga_memory: region@bf000000 {
			no-map;
			compatible = "shared-dma-pool";
			reg = <0xbf000000 0x01000000>;  /* 16M */
		};
	};

	vga-shared-memory {
		compatible = "aspeed,ast2500-vga-sharedmem";
		reg = <0xbff00000 0x100000>;
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
			<&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
			<&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
			<&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
	};

	leds {
		compatible = "gpio-leds";
		heartbeat {
			label = "heartbeat";
			gpios = <&gpio0 ASPEED_GPIO(F, 7) GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "timer";
			active-delay = <100>;
			inactive-delay = <100>;
		};
		status_amber {
			label = "status_amber";
			gpios = <&gpio0 ASPEED_GPIO(G, 4) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		status_red {
			label = "status_red";
			gpios = <&gpio0 ASPEED_GPIO(H, 3) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	switchphy: ethernet-phy@0 {
		// Fixed link
	};
};

&mdio0 {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mdio1 {
	status = "okay";

	ethphy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mdio2 {
	status = "okay";

	ethphy2: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mdio3 {
	status = "okay";

	ethphy3: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mac0 {
	status = "disabled";

	phy-mode = "rgmii-rxid";
	phy-handle = <&ethphy0>;

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii1_default>;
};


&mac1 {
	status = "disabled";

	phy-mode = "rgmii-rxid";
	phy-handle = <&ethphy1>;

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii2_default>;
};


&mac2 {
	status = "okay";

//	Not working
//	phy-mode = "rmii";
//	phy-handle = <&ethphy2>;
//	pinctrl-names = "default";
//	pinctrl-0 = <&pinctrl_rmii3_default>;

// Working
	phy-mode = "rgmii";
	phy-handle = <&switchphy>;
	fixed-link {
		speed = <10>;
		full-duplex;
	};
};

&mac3 {
	status = "okay";

	phy-mode = "rgmii";
	phy-handle = <&ethphy3>;

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii4_default>;
};

&syscon {
	mac0-clk-delay = <0x10 0x0a
			  0x10 0x10
			  0x10 0x10>;
	mac1-clk-delay = <0x10 0x0a
			  0x10 0x10
			  0x10 0x10>;
	mac2-clk-delay = <0x08 0x04
			  0x08 0x04
			  0x08 0x04>;
	mac3-clk-delay = <0x08 0x04
			  0x08 0x04
			  0x08 0x04>;
};

&fmc {
	status = "okay";
	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "bmc";
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			u-boot@0 {
				reg = <0x0 0xe0000>; // 896KB
				label = "u-boot";
			};

			u-boot-env@e0000 {
				reg = <0xe0000 0x20000>; // 128KB
				label = "u-boot-env";
			};

			kernel@100000 {
				reg = <0x100000 0x900000>; // 9MB
				label = "kernel";
			};

			rofs@a00000 {
				reg = <0xa00000 0x2000000>; // 32MB
				label = "rofs";
			};

			rwfs@6000000 {
				reg = <0x2a00000 0xfc0000>; // 16MB
				label = "rwfs";
			};

			persistent@39c0000 {
				reg = <0x39c0000 0x640000>; // 6.4MB
				label = "persistent";
			};
		};
	};
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default>;

	flash@0 {
		status = "okay";
		m25p,fast-read;

		label = "bios-raw";
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			uefi@400000 {
				reg = <0x400000 0x1C00000>;
				label = "bios-partition";
			};
		};
	};
};

&spi2 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi2_default>;

	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "bios2";
		spi-max-frequency = <50000000>;
	};
};

&i2c0 {
	status = "okay";
	ssif-bmc@10 {
		compatible = "aspeed,ast2500-ssif-bmc";
		reg = <0x10>;
	};
};

&i2c1 {
	status = "okay";

	pcf85063: rtc@51 {
		compatible = "nxp,pcf85063";
		reg = <0x51>;
		quartz-load-femtofarads = <7000>;
	};
};

&i2c2 {
	status = "okay";
	smpro@4f {
		compatible = "ampere,smpro";
		reg = <0x4f>;
	};
    smpro@4e {
		compatible = "ampere,smpro";
		reg = <0x4e>;
	};
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&i2c5 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

&i2c8 {
	status = "okay";
};

&i2c9 {
	status = "okay";
};

&i2c10 {
	status = "disabled";
};

&i2c11 {
	status = "disabled";
};

&i2c12 {
	status = "okay";
};

&i2c13 {
	status = "okay";
	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
	};
};

&i2c14 {
	status = "okay";
};

&i2c15 {
	status = "okay";
};

&gpio0 {
	status = "okay";
	gpio-line-names =
	/* A0-A7 */ "A0","A1","A2","A3","A4","A5","A6","A7",
	/* B0-B7 */ "B0","B1","B2","B3","B4","B5","B6","B7",
	/* C0-C7 */ "C0","C1","C2","C3","C4","C5","C6","C7",
	/* D0-D7 */ "D0","D1","D2","D3","D4","D5","D6","D7",
	/* E0-E7 */ "E0","E1","E2","E3","E4","E5","E6","E7",
	/* F0-F7 */ "F0","F1","F2","F3","F4","F5","F6","F7",
	/* G0-G7 */ "G0","G1","G2","G3","G4","G5","G6","G7",
	/* H0-H7 */ "H0","H1","H2","H3","H4","H5","H6","H7",
	/* I0-I7 */ "I0","I1","I2","I3","I4","I5","I6","I7",
	/* J0-J7 */ "J0","J1","J2","J3","J4","J5","J6","J7",
	/* K0-K7 */ "K0","K1","K2","K3","K4","K5","K6","K7",
	/* L0-L7 */ "L0","L1","L2","L3","L4","L5","L6","L7",
	/* M0-M7 */ "M0","M1","M2","M3","M4","M5","M6","M7",
	/* N0-N7 */ "N0","N1","N2","N3","N4","N5","N6","N7",
	/* O0-O7 */ "O0","O1","O2","O3","O4","O5","O6","O7",
	/* P0-P7 */ "BIOS_SEL","P1","P2","P3","P4","P5","P6","P7",
	/* Q0-Q7 */ "Q0","Q1","Q2","Q3","Q4","Q5","Q6","Q7",
	/* R0-R7 */ "R0","R1","R2","R3","R4","R5","R6","R7",
	/* S0-S7 */ "S0","S1","S2","S3","S4","S5","S6","S7",
	/* T0-T7 */ "T0","T1","T2","T3","T4","T5","T6","T7",
	/* U0-U7 */ "U0","U1","U2","U3","U4","U5","U6","U7",
	/* V0-V7 */ "V0","V1","V2","V3","V4","V5","V6","V7",
	/* W0-W7 */ "W0","W1","W2","W3","W4","W5","W6","W7",
	/* X0-X7 */ "X0","X1","X2","X3","X4","X5","X6","X7",
	/* Y0-Y7 */ "Y0","Y1","Y2","Y3","Y4","Y5","Y6","Y7",
	/* Z0-Z7 */ "BIOS_BACKUP_SEL","Z1","Z2","Z3","Z4","Z5","Z6","Z7";
};

&adc0 {
	vref = <1800>;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
		&pinctrl_adc2_default &pinctrl_adc3_default
		&pinctrl_adc4_default &pinctrl_adc5_default
		&pinctrl_adc6_default &pinctrl_adc7_default>;
};

&adc1 {
	vref = <2500>;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
		&pinctrl_adc10_default &pinctrl_adc11_default
		&pinctrl_adc12_default &pinctrl_adc13_default
		&pinctrl_adc14_default &pinctrl_adc15_default>;
};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_txd1_default
			&pinctrl_rxd1_default
			&pinctrl_ncts1_default
			&pinctrl_nrts1_default>;
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_txd2_default
			&pinctrl_rxd2_default>;
};

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_txd3_default
			&pinctrl_rxd3_default>;
};

&uart4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_txd4_default
			&pinctrl_rxd4_default>;
};

/* The BMC's uart */
&uart5 {
	status = "okay";
};


&wdt1 {
	status = "okay";
	aspeed,reset-type = "soc";
};

&wdt2 {
	status = "okay";
	aspeed,reset-type = "soc";
};

&wdt3 {
	status = "disabled";
};

&mbox {
	status = "okay";
};

&pwm_tacho {
   status = "okay";
   pinctrl-names = "default";
   pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_tach0_default
		   &pinctrl_pwm1_default &pinctrl_tach1_default
		   &pinctrl_pwm2_default &pinctrl_tach2_default
		   &pinctrl_pwm3_default &pinctrl_tach3_default
		   &pinctrl_pwm4_default &pinctrl_tach4_default
		   &pinctrl_pwm5_default &pinctrl_tach5_default
		   &pinctrl_pwm6_default &pinctrl_tach6_default
		   &pinctrl_pwm7_default &pinctrl_tach7_default>;

   fan@0 {
	   reg = <0x00>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x00>;
   };

   fan@1 {
	   reg = <0x01>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x01>;
   };

   fan@2 {
	   reg = <0x02>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x02>;
   };

   fan@3 {
	   reg = <0x03>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x03>;
   };

   fan@4 {
	   reg = <0x04>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x04>;
   };

   fan@5 {
	   reg = <0x05>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x05>;
   };

   fan@6 {
	   reg = <0x06>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x06>;
   };

   fan@7 {
	   reg = <0x07>;
	   aspeed,fan-tach-ch = /bits/ 8 <0x07>;
   };
};

&vhub {
	status = "okay";
//  Disable PCIe EHCI port as it doesn't work
//	pinctrl-names = "default";
//	pinctrl-0 = <&pinctrl_usb2adp_default>;
};

&ehci0 {
	status = "disabled";
};

&ehci1 {
	status = "disabled";
};

&otp {
	status = "okay";
};

&gfx {
	pcie-reset-detect;
	memory-region = <&gfx_memory>;
	status = "okay";
};

&display_port {
	status = "okay";
};

&display_port_mcu {
	status = "okay";
};

/*
&rvas {
	status = "okay";
	memory-region = <&rvas_memory>;
};
*/

&video {
	status = "okay";
	memory-region = <&video_engine_memory>;
};

&jtag1 {
	status = "okay";
};


&pinctrl {
	aspeed,external-nodes = <&gfx &lhc>;
};

