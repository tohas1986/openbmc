From de19f0ff7142af199e7465c39267dfbb2ef120a6 Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Mon, 6 Jul 2020 10:25:10 +0000
Subject: [PATCH 1/1] Reduce logging

---
 modules/pam_succeed_if/pam_succeed_if.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/modules/pam_succeed_if/pam_succeed_if.c b/modules/pam_succeed_if/pam_succeed_if.c
index aac3eeb..2f2e95a 100644
--- a/modules/pam_succeed_if/pam_succeed_if.c
+++ b/modules/pam_succeed_if/pam_succeed_if.c
@@ -523,7 +523,7 @@ pam_sm_authenticate (pam_handle_t *pamh, int flags UNUSED,
 				       pwd, user);
 			if (ret != PAM_SUCCESS) {
 				if(!quiet_fail)
-					pam_syslog(pamh, LOG_INFO,
+					pam_syslog(pamh, LOG_DEBUG,
 						   "requirement \"%s %s %s\" "
 						   "not met by user \"%s\"",
 						   left, qual, right, user);
@@ -532,7 +532,7 @@ pam_sm_authenticate (pam_handle_t *pamh, int flags UNUSED,
 			}
 			else
 				if(!quiet_succ)
-					pam_syslog(pamh, LOG_INFO,
+					pam_syslog(pamh, LOG_DEBUG,
 						   "requirement \"%s %s %s\" "
 						   "was met by user \"%s\"",
 						   left, qual, right, user);
-- 
2.7.4

