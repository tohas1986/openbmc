From 20d47a77a52185ce9a0496677b7971b04d17f7b3 Mon Sep 17 00:00:00 2001
From: Konstantin Klubnichkin <kitsok@yandex-team.ru>
Date: Tue, 14 Dec 2021 12:50:00 +0000
Subject: [PATCH] wait-online: fail in case of event loop error

---
 src/network/wait-online/wait-online.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/network/wait-online/wait-online.c b/src/network/wait-online/wait-online.c
index 1b24b6f1a6..3c244a9f1a 100644
--- a/src/network/wait-online/wait-online.c
+++ b/src/network/wait-online/wait-online.c
@@ -223,10 +223,14 @@ static int run(int argc, char *argv[]) {
                                       "STATUS=Failed to wait for network connectivity...");
 
         r = sd_event_loop(m->event);
-        if (r == -ETIMEDOUT)
-                return log_error_errno(r, "Timeout occurred while waiting for network connectivity.");
-        if (r < 0)
+        if (r == -ETIMEDOUT) {
+                log_error_errno(r, "Timeout occurred while waiting for network connectivity.");
+                exit(-1);
+        }
+        if (r < 0) {
                 return log_error_errno(r, "Event loop failed: %m");
+                exit(-1);
+        }
 
 success:
         notify_message = "STATUS=All interfaces configured...";
-- 
